<Window x:Class="KosovaPOS.Windows.BusinessPartnersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Partnerët biznesorë" Height="850" Width="1400"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="&#x1F465; Menaxhimi i partnerëve biznesorë" FontSize="20" FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryColor}"/>
                    <TextBlock Text="Klientët, furnizuesit dhe të gjithë partnerët biznesorë" FontSize="14" 
                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#x1F6AA; Mbyll" Style="{StaticResource ModernButton}"
                        Click="Close_Click" Width="120" VerticalAlignment="Center"
                        Background="{StaticResource DangerColor}"/>
            </Grid>
        </Border>
        
        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Kërko:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="SearchTextBox" Style="{StaticResource ModernTextBox}"
                         TextChanged="SearchTextBox_TextChanged" Margin="0,0,20,0"/>
                
                <TextBlock Grid.Column="2" Text="Lloji:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="3" x:Name="PartnerTypeComboBox" 
                          Style="{StaticResource ModernComboBox}"
                          SelectionChanged="PartnerTypeComboBox_SelectionChanged" Margin="0,0,20,0"/>

                <Button Grid.Column="4" Content="&#x1F464; Partner i ri" Style="{StaticResource ModernButton}"
                        Click="NewPartner_Click" Width="140" 
                        Background="{StaticResource SuccessColor}"/>
            </Grid>
        </Border>
        
        <!-- Partners Content -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Summary Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="#2196F3" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F465;" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Total partnerë" FontSize="14" Foreground="White" 
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock x:Name="TotalPartnersText" Text="0" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="1" Background="#4CAF50" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F6CD;" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Klientë" FontSize="14" Foreground="White" 
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock x:Name="TotalCustomersText" Text="0" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="2" Background="#FF9800" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F69A;" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Furnizues" FontSize="14" Foreground="White" 
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock x:Name="TotalSuppliersText" Text="0" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="3" Background="#0284C7" CornerRadius="6" Padding="15">
                        <StackPanel>
                            <TextBlock Text="&#x1F4B0;" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Balanca totale" FontSize="14" Foreground="White" 
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock x:Name="TotalBalanceText" Text="0.00 €" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Partners DataGrid -->
                <DataGrid Grid.Row="1" x:Name="PartnersDataGrid" 
                          Style="{StaticResource POSDataGrid}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Emri" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Adresa" Binding="{Binding Address}" Width="180"/>
                        <DataGridTextColumn Header="Qyteti" Binding="{Binding City}" Width="100"/>
                        <DataGridTextColumn Header="NRF" Binding="{Binding NRF}" Width="120"/>
                        <DataGridTextColumn Header="NUI" Binding="{Binding NUI}" Width="120"/>
                        <DataGridTextColumn Header="Telefoni" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                        <DataGridTextColumn Header="Lloji" Binding="{Binding PartnerType}" Width="100"/>
                        <DataGridTextColumn Header="Balanca (€)" Binding="{Binding Balance, StringFormat=N2}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        
        <!-- Footer Buttons -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="&#x270F; Ndrysho" Style="{StaticResource ModernButton}"
                    Click="EditPartner_Click" Width="120" Margin="0,0,10,0"/>
            
            <Button Grid.Column="2" Content="&#x1F5D1; Fshi" Style="{StaticResource ModernButton}"
                    Click="DeletePartner_Click" Width="120" Margin="0,0,10,0"
                    Background="{StaticResource DangerColor}"/>
            
            <Button Grid.Column="3" Content="&#x1F4CA; Eksporto" Style="{StaticResource ModernButton}"
                    Click="ExportToExcel_Click" Width="120" Margin="0,0,10,0"/>
        </Grid>
    </Grid>
</Window>
