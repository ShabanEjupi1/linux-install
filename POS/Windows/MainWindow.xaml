<Window x:Class="KosovaPOS.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pizzeria POS - Sistem për Menaxhimin e Porosive" 
        Height="700" Width="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/KosovaPOS.ico"
        Background="{DynamicResource BackgroundBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderGradient}" Padding="20">
            <StackPanel>
                <TextBlock x:Name="BusinessNameText" Text="&#x1F355; PIZZERIA DELIZIOSO &#x1F355;" 
                           FontSize="20" FontWeight="SemiBold" 
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Sistemi POS për Pizzeria - Porosia &amp; Menaxhimi" 
                           FontSize="16" 
                           Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Main Menu Grid -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Cash Register -->
            <Border Grid.Column="0" Grid.Row="0" 
                    Background="#4CAF50" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="CashRegister_Click">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F355;" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="POROSITË" FontSize="20" FontWeight="SemiBold" 
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="Merr porosinë e klientit (F1)" FontSize="14" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <!-- Kitchen Ready Badge -->
                    <Border x:Name="KitchenReadyBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="#F59E0B" CornerRadius="6" Padding="6,2" Margin="0,6,6,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="KitchenReadyCount" Text="0" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Pizza Management (NEW - Pizza specific) -->
            <Border Grid.Column="1" Grid.Row="0" 
                    Background="#0D9488"
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="PizzaManagement_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F355;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="PICAT &amp; SHTESAT" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Menaxho picat dhe shtesat (F2)" FontSize="14"
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Sales Reports -->
            <Border Grid.Column="2" Grid.Row="0" 
                    Background="#FF9800" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="Sales_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4CA;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="SHITJET" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Historiku i shitjeve (F3)" FontSize="14"
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Purchases (moved to top row) -->
            <Border Grid.Column="3" Grid.Row="0" 
                    Background="#0284C7" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="Purchases_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F6D2;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="BLERJET" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Blerjet e produkteve (F4)" FontSize="14"
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Business Partners (moved up) -->
            <Border Grid.Column="0" Grid.Row="1" 
                    Background="#00BCD4" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="BusinessPartners_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F465;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="FURNIZUES" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Menaxhimi i furnizuesve (F5)" FontSize="14"
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Inventory/Stock -->
            <Border Grid.Column="1" Grid.Row="1" 
                    Background="#1E40AF" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="InventoryManagement_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4E6;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="STOQET" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Menaxhimi i inventarit" FontSize="14"
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Reports (moved here, changed from red to teal) -->
            <Border Grid.Column="2" Grid.Row="1" 
                    Background="#0D9488" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="Reports_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4C8;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="RAPORTET" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Raportet fiskale dhe financiare (F6)" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Analytics -->
            <Border Grid.Column="3" Grid.Row="1" 
                    Background="#0891B2" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="Analytics_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4CA;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="ANALYTICS" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Statistika dhe grafikë (F7)" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Settings -->
            <Border Grid.Column="0" Grid.Row="2" 
                    Background="#607D8B" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="Settings_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x2699;&#xFE0F;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="KONFIGURIMET" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Sistemi dhe përdoruesit (F8)" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Barcode Printing (changed from orange to teal) -->
            <Border Grid.Column="1" Grid.Row="2" 
                    Background="#0F766E" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="BarcodePrinting_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F3F7;&#xFE0F;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="BARKODI" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Printimi i etiketave" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Import Data (changed from orange) -->
            <Border Grid.Column="2" Grid.Row="2" 
                    Background="#795548" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="ImportData_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4E5;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="IMPORTO" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Të dhënat nga SQL Server" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Finance (moved to last position) -->
            <Border Grid.Column="3" Grid.Row="2" 
                    Background="#009688" 
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="Finance_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4B5;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="FINANCAT" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Hyrjet, daljet, borxhet (F9)" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- NEW ROW 4 - Restaurant Management Modules -->

            <!-- Table Management -->
            <Border Grid.Column="0" Grid.Row="3" 
                    Background="#1E6F5C"
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="TableManagement_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1FA91;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="TAVOLINAT" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Menaxhimi i tavolinave" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Kitchen Display System -->
            <Border Grid.Column="1" Grid.Row="3" 
                    Background="#2563EB"
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="KitchenDisplay_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F373;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="KUZHINË" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Sistemi i kuzhinës (KDS)" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Loyalty Program -->
            <Border Grid.Column="2" Grid.Row="3" 
                    Background="#047857"
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="LoyaltyProgram_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4B3;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="BESNIKËRI" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Programi i besnikërisë" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Staff Scheduling -->
            <Border Grid.Column="3" Grid.Row="3" 
                    Background="#0369A1"
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="StaffScheduling_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F465;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="ORARI" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Orari i punonjësve" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- NEW ROW 5 - Delivery and Advanced Reporting -->

            <!-- Delivery Management -->
            <Border Grid.Column="0" Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Background="#075985"
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="DeliveryManagement_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F6F5;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="DËRGESA" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Menaxhimi i dërgesave dhe korrierëve" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Advanced Reporting -->
            <Border Grid.Column="2" Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Background="#1E3A5F"
                    Margin="5" 
                    CornerRadius="6"
                    Cursor="Hand"
                    MouseDown="AdvancedReporting_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4F0;" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="RAPORTE ADVANCED" FontSize="20" FontWeight="SemiBold" 
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Raporte të detajuara financiare dhe biznesore" FontSize="14" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="15" Margin="0,30,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Kosovo POS &#xA9; 2026 - Version 3.0" VerticalAlignment="Center" Margin="0,0,20,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="ThemeToggleButton" Content="&#x1F319; Tema e Errët" Click="ThemeToggle_Click" 
                             Background="#0369A1" Foreground="White" 
                             Padding="10,0" Height="36" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                            ToolTip="Ndrysho temën (Ctrl+T)"/>
                    <Button Content="&#x1F6AA; DIL" Click="Exit_Click" 
                             Background="#424242" Foreground="White" 
                             Padding="10,0" Height="36" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                <TextBlock x:Name="DateTimeText" Text="" 
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
