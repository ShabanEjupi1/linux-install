<Window x:Class="KosovaPOS.Windows.DeliveryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#xf46d; Menaxhimi i d rgesave" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd" Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="brd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Badge Styles -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderGradient}" Padding="30,25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="&#xf46d; Menaxhimi i dërgesave" 
                               FontSize="20" FontWeight="SemiBold" 
                               Foreground="White"/>
                    <TextBlock Text="Monitoroni dhe menaxhoni porositë për dërgesë në kohë reale"
                               FontSize="14" Foreground="White" Opacity="0.95"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#x1F504; Rifresko" 
                            Click="RefreshButton_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#3B82F6"
                            Margin="0,0,10,0"/>
                    <Button Content="&#x2716; Mbyll" 
                            Click="CloseButton_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#64748B"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="30,20,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Statistics Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Pending Orders -->
                <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" ShadowDepth="5" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="&#xf017; Në pritje" FontSize="14" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtPendingOrders" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,8,0,0"/>
                        <TextBlock Text="Porosi" FontSize="14" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Preparing Orders -->
                <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" ShadowDepth="5" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="&#x1F373; Duke u përgatitur" FontSize="14" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtPreparingOrders" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#3B82F6" Margin="0,8,0,0"/>
                        <TextBlock Text="Porosi" FontSize="14" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- On The Way Orders -->
                <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" ShadowDepth="5" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="&#x1F69A; Në rrugë" FontSize="14" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtOnTheWayOrders" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,8,0,0"/>
                        <TextBlock Text="Porosi" FontSize="14" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Completed Today -->
                <Border Grid.Column="3" Background="White" CornerRadius="6" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" ShadowDepth="5" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="&#x2714; Përfunduar sot" FontSize="14" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtCompletedToday" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#22C55E" Margin="0,8,0,0"/>
                        <TextBlock Text="Porosi" FontSize="14" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tabs for different views -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <!-- Active Deliveries Tab -->
                <TabItem Header="&#xf111; Dërgesa aktive">
                    <Border Background="White" CornerRadius="6" Padding="20" Margin="0,10,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" ShadowDepth="5" Direction="270"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Action Toolbar -->
                            <Border Grid.Row="0" Background="#F0FDF4" CornerRadius="6" Padding="14,10"
                                    Margin="0,0,0,14" BorderBrush="#D1FAE5" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#x2795; Porosi e re"
                                            Click="AddDeliveryOrder_Click"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Background="#22C55E" Padding="10,0" Margin="0,0,10,0"/>
                                    <Button Content="&#x1F504; Ndrysho statusin"
                                            Click="UpdateDeliveryStatus_Click"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Background="#3B82F6" Padding="10,0" Margin="0,0,10,0"/>
                                    <Button Content="&#x1F4CD; Cakto shoferin"
                                            Click="AssignDriver_Click"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Background="#0891B2" Padding="10,0" Margin="0,0,10,0"/>
                                    <Button Content="&#x270F; Modifiko"
                                            Click="EditDeliveryOrder_Click"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Background="#D97706" Padding="10,0" Margin="0,0,10,0"/>
                                    <Button Content="&#x1F5D1; Fshi"
                                            Click="DeleteDeliveryOrder_Click"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Background="#64748B" Padding="10,0"/>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="ActiveDeliveriesGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      RowHeight="50"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F3F4F6"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      BorderThickness="0"
                                      FontSize="14">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#0284C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="Height" Value="42"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Porosia #" Binding="{Binding Id}" Width="90"/>
                                    <DataGridTextColumn Header="Klienti" Binding="{Binding CustomerName}" Width="160"/>
                                    <DataGridTextColumn Header="Telefoni" Binding="{Binding CustomerPhone}" Width="110"/>
                                    <DataGridTextColumn Header="Adresa" Binding="{Binding DeliveryAddress}" Width="*"/>
                                    <DataGridTextColumn Header="Shuma" Binding="{Binding TotalAmount, StringFormat=N2}" Width="90"/>
                                    <DataGridTextColumn Header="Statusi" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Shofer" Binding="{Binding DriverName}" Width="120"/>
                                    <DataGridTextColumn Header="Ora" Binding="{Binding CreatedAt, StringFormat='HH:mm'}" Width="60"/>
                                    <DataGridTemplateColumn Header="Veprimet" Width="260">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                                    <Button Content="&#xf4df; Në rrugë" Height="36"
                                                            FontSize="14" FontWeight="SemiBold" Foreground="White"
                                                            Background="#0284C7" BorderThickness="0"
                                                            Margin="0,0,4,0" Padding="10,0"
                                                            Click="MarkOutForDelivery_Click"
                                                            Tag="{Binding Id}"
                                                            Cursor="Hand"/>
                                                    <Button Content="&#xf477; Dorëzuar" Height="36"
                                                            FontSize="14" FontWeight="SemiBold" Foreground="White"
                                                            Background="#10B981" BorderThickness="0"
                                                            Padding="10,0"
                                                            Click="MarkDelivered_Click"
                                                            Tag="{Binding Id}"
                                                            Cursor="Hand"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- Drivers Tab -->
                <TabItem Header="&#x1F464; Shoferët">
                    <Border Background="White" CornerRadius="6" Padding="25" Margin="0,10,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" ShadowDepth="5" Direction="270"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#x1F464; Shto shofer" 
                                            Click="AddDriver_Click"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Background="#10B981"/>
                                    <Button Content="&#x270F; Modifiko"
                                            Click="EditDriver_Click"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Background="#3B82F6"
                                            Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="DriversGrid" 
                                      Grid.Row="1"
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      RowHeight="50"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                                    <DataGridTextColumn Header="Emri" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Telefoni" Binding="{Binding Phone}" Width="150"/>
                                    <DataGridTextColumn Header="Automjeti" Binding="{Binding VehicleType}" Width="150"/>
                                    <DataGridTextColumn Header="Targa" Binding="{Binding VehiclePlate}" Width="120"/>
                                    <DataGridTextColumn Header="Statusi" Binding="{Binding Status}" Width="120"/>
                                    <DataGridTextColumn Header="Dërgesa aktive" Binding="{Binding ActiveDeliveries}" Width="130"/>
                                    <DataGridTextColumn Header="Totali" Binding="{Binding TotalDeliveries}" Width="100"/>
                                    <DataGridTextColumn Header="Vlerësimi" Binding="{Binding AverageRating, StringFormat='&#xf005; {0:F1}'}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- History Tab -->
                <TabItem Header="&#x1F4DC; Historiku">
                    <Border Background="White" CornerRadius="6" Padding="25" Margin="0,10,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="20" ShadowDepth="5" Direction="270"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Date Filter -->
                            <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Nga:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="FromDate" Width="150" Margin="0,0,20,0"/>
                                    <TextBlock Text="Deri:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="ToDate" Width="150" Margin="0,0,20,0"/>
                                    <Button Content="&#x1F50D; Kërko" 
                                            Click="SearchHistory_Click"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Background="#3B82F6"/>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="HistoryGrid" 
                                      Grid.Row="1"
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      RowHeight="50"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                                    <DataGridTextColumn Header="Porosia #" Binding="{Binding Id}" Width="100"/>
                                    <DataGridTextColumn Header="Klienti" Binding="{Binding CustomerName}" Width="180"/>
                                    <DataGridTextColumn Header="Adresa" Binding="{Binding DeliveryAddress}" Width="*"/>
                                    <DataGridTextColumn Header="Shofer" Binding="{Binding DriverName}" Width="150"/>
                                    <DataGridTextColumn Header="Shuma" Binding="{Binding TotalAmount, StringFormat='{}{0:N2} €'}" Width="100"/>
                                    <DataGridTextColumn Header="Statusi" Binding="{Binding Status}" Width="120"/>
                                    <DataGridTextColumn Header="Vlerësimi" Binding="{Binding Rating, StringFormat='€ {0}'}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
