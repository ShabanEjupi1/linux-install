<Window x:Class="KosovaPOS.Windows.CashRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x1F355; Porosit - Pizzeria POS" 
        Height="900" Width="1400"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Local animations -->
        <Storyboard x:Key="PulseAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="1" To="0.7" Duration="0:0:0.5"
                           AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        
        <Storyboard x:Key="SuccessAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                           From="0.8" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                           From="0.8" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- HEADER - Professional Enterprise Header with Glassmorphism -->
        <Border Grid.Row="0" Padding="20,16" Background="{DynamicResource HeaderGradient}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="4" Direction="270" BlurRadius="16" Opacity="0.15"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Business Info & DateTime -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Business Logo/Icon -->
                    <Border Background="#40FFFFFF" CornerRadius="6" Padding="10" Margin="0,0,16,0">
                        <TextBlock Text="&#x1F3EA;" FontSize="20" VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="BusinessNameText" Text="EMRI I BIZNESIT" 
                                   FontSize="20" FontWeight="SemiBold" 
                                   Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="CurrentDateText" Text="21 Janar 2026" 
                                       FontSize="14" Foreground="#E0F2FE" Margin="0,0,16,0"/>
                            <TextBlock x:Name="CurrentTimeText" Text="12:00:00" 
                                       FontSize="14" Foreground="#E0F2FE" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                
                <!-- Center: Search Bar -->
                <Grid Grid.Column="1" Margin="40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Quick Quantity Input -->
                    <Border Grid.Column="0" Background="White" CornerRadius="6,0,0,6" Padding="0" Margin="0,0,-1,0">
                        <Grid Width="90">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x1F4E6;" FontSize="20" FontWeight="SemiBold"
                                       Margin="12,0,4,0" VerticalAlignment="Center"
                                       Foreground="#0284C7"/>
                            <TextBox x:Name="QuickQuantityBox" 
                                     Grid.Column="1"
                                     Height="50" 
                                     FontSize="14" 
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     Padding="4,0,8,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#0284C7"
                                     Text="1"
                                     PreviewTextInput="QuickQuantityBox_PreviewTextInput"
                                     GotFocus="QuickQuantityBox_GotFocus"
                                     ToolTip="Sasia (shkruaj numrin para se të skanosh)"/>
                        </Grid>
                    </Border>
                    
                    <!-- Search Box with Icon -->
                    <Border Grid.Column="1" Background="White" CornerRadius="0,6,6,0" Padding="0" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="16" 
                                       Margin="16,0,8,0" VerticalAlignment="Center"
                                       Foreground="#94A3B8"/>
                            <TextBox x:Name="BarcodeSearchBox" 
                                     Grid.Column="1"
                                     Height="50" 
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0,16,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#1F2937"
                                     CaretBrush="#0284C7"
                                     PreviewKeyDown="BarcodeSearchBox_KeyDown"
                                     TextChanged="BarcodeSearchBox_TextChanged"
                                     GotFocus="BarcodeSearchBox_GotFocus"
                                     LostFocus="BarcodeSearchBox_LostFocus"/>
                        </Grid>
                    </Border>
                    
                    <!-- Placeholder Text -->
                    <TextBlock Grid.Column="1" 
                               Text="Skano barkodën ose shkruaj emrin... (Enter)" 
                               FontSize="14"
                               Foreground="#94A3B8"
                               Margin="52,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Text, ElementName=BarcodeSearchBox}" Value=""/>
                                            <Condition Binding="{Binding IsFocused, ElementName=BarcodeSearchBox}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <!-- Search Button -->
                    <Button x:Name="SearchButton" 
                            Grid.Column="2"
                            Width="110" Height="44"
                            Margin="12,0,0,0"
                            Background="#10B981" 
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Cursor="Hand"
                            Click="SearchButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔎" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="KËRKO" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#059669"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                
                <!-- Right: Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Theme Toggle -->
                    <Button x:Name="ThemeToggleButton" 
                            Width="36" Height="36"
                            Margin="0,0,8,0"
                            Background="#40FFFFFF"
                            Foreground="White"
                            FontSize="14"
                            ToolTip="Ndrysho temën (Errët/E ndritshme)"
                            Click="ThemeToggleButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock x:Name="icon" Text="&#x1F319;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#60FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Keyboard Shortcuts Help -->
                    <Button x:Name="HelpButton" 
                            Width="36" Height="36"
                            Margin="0,0,8,0"
                            Background="#40FFFFFF"
                            Foreground="White"
                            FontSize="14"
                            ToolTip="Ndihmë &amp; Shkurtoret (Shtyp ?)"
                            Click="HelpButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock Text="&#x24D8;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#60FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Kitchen Pending Orders Badge -->
                    <Button x:Name="KitchenOrdersButton"
                            Width="36" Height="36"
                            Margin="0,0,8,0"
                            Background="#D97706"
                            Foreground="White"
                            FontSize="14"
                            ToolTip="Porosi nga Kuzhina (klikoni për të importuar)"
                            Click="ImportKitchenOrder_Click"
                            Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="&#x1F373;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border x:Name="badge" Background="#D97706" CornerRadius="6"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Padding="4,1" Margin="-4,-4,0,0">
                                            <TextBlock x:Name="badgeText" Text="0" FontSize="14"
                                                       Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#B45309"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Cashier Info Badge -->
                    <Border Background="#40FFFFFF" CornerRadius="6" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F464;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock x:Name="CashierNameText" Text="Arkëtari" 
                                           FontSize="14" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CashierNumberText" Text="01" 
                                           FontSize="14" Foreground="#E0F2FE"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
            
        <!-- Search Results Popup -->
        <Popup x:Name="SearchResultsPopup" 
               PlacementTarget="{Binding ElementName=BarcodeSearchBox}"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="False"
               MaxHeight="400"
               HorizontalOffset="-44">
                <Border Background="White" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,8,0,0"
                        MinWidth="600">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="8" Direction="270" BlurRadius="24" Opacity="0.15"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" Padding="16,12" 
                                CornerRadius="6,6,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBlock Text="&#x1F4E6; Rezultatet e kërkimit" FontWeight="SemiBold" 
                                       Foreground="#475569" FontSize="14"/>
                        </Border>
                        
                        <ListBox x:Name="SearchResultsListBox"
                                 Grid.Row="1"
                                 MaxHeight="340"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="SearchResultsListBox_SelectionChanged"
                                 MouseDoubleClick="SearchResultsListBox_DoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="16,12"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" 
                                                        Padding="{TemplateBinding Padding}"
                                                        BorderBrush="#F1F5F9"
                                                        BorderThickness="0,0,0,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Product Thumbnail Placeholder -->
                                        <Border Grid.Column="0" Width="40" Height="40" 
                                                Background="#F1F5F9" CornerRadius="6"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="&#x1F4E6;" FontSize="16" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding Barcode}" 
                                                   FontWeight="SemiBold" Foreground="#64748B" FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       Foreground="#0F172A" FontSize="14" 
                                                        FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Category}" 
                                                       Foreground="#94A3B8" FontSize="14"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding SalesPrice, StringFormat='{}{0:N2} &#x20AC;'}" 
                                                   Foreground="#059669" FontWeight="SemiBold" FontSize="14" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <Border Grid.Column="4" Background="#F0FDF4" CornerRadius="6" 
                                                Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StockQuantity, StringFormat='Stok: {0:N0}'}" 
                                                       Foreground="#059669" FontSize="14" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Popup>
        
        <!-- DASHBOARD METRICS BAR - Mini stats with animated counters -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" 
                Padding="20,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Quick Access / Favorites Bar - Hidden (for internal use only) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="&#x2B50; Favorites:" FontWeight="SemiBold" Foreground="#64748B" 
                               VerticalAlignment="Center" Margin="0,0,16,0" FontSize="14"/>
                    <ItemsControl x:Name="FavoritesBar">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button x:Name="AddFavoriteButton" Content="+ Shto" 
                            Style="{StaticResource EnterpriseGhostButton}"
                            Padding="12,6" FontSize="14" Height="32"
                            Click="AddFavoriteButton_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
                
                <!-- Dashboard Metrics - Hidden (Proprietary business data) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                    <!-- Today's Revenue -->
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#DCFCE7" CornerRadius="6" Padding="8" Margin="0,0,10,0">
                                <TextBlock Text="&#x1F4B0;" FontSize="16"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Sot" FontSize="14" Foreground="#64748B"/>
                                <TextBlock x:Name="TodayRevenueText" Text="0.00 &#x20AC;" 
                                           FontSize="16" FontWeight="SemiBold" Foreground="#059669"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Transaction Count -->
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,12,0" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E0F2FE" CornerRadius="6" Padding="8" Margin="0,0,10,0">
                                <TextBlock Text="&#x1F9FE;" FontSize="16"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Fatura" FontSize="14" Foreground="#64748B"/>
                                <TextBlock x:Name="TransactionCountText" Text="0" 
                                           FontSize="16" FontWeight="SemiBold" Foreground="#0284C7"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Items Sold -->
                    <Border Style="{StaticResource MetricCard}" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="8" Margin="0,0,10,0">
                                <TextBlock Text="&#x1F4E6;" FontSize="16"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Artikuj" FontSize="14" Foreground="#64748B"/>
                                <TextBlock x:Name="ItemsSoldText" Text="0" 
                                           FontSize="16" FontWeight="SemiBold" Foreground="#D97706"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- MAIN CONTENT AREA - Dual Panel Mode with Receipt Tabs -->
        <Grid Grid.Row="2" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500"/>
            </Grid.ColumnDefinitions>
            
            <!-- Receipt Panel (Main Focus) -->
            <Border Grid.Column="0" Style="{StaticResource EnterpriseCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Receipt Tabs Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" Padding="12,8" 
                            CornerRadius="6,6,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Receipt Tabs -->
                            <StackPanel x:Name="ReceiptTabsPanel" Grid.Column="0" Orientation="Horizontal">
                                <Border x:Name="Receipt1Tab" Background="#0284C7" CornerRadius="6" 
                                        Padding="16,8" Margin="0,0,8,0" Cursor="Hand"
                                        MouseLeftButtonDown="ReceiptTab_Click" Tag="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F9FE;" Margin="0,0,6,0"/>
                                        <TextBlock Text="Fatura 1" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Add New Receipt Tab Button -->
                                <Button x:Name="AddReceiptTabButton" Content="+" 
                                        Width="36" Height="36"
                                        FontSize="14" FontWeight="SemiBold"
                                        Background="Transparent"
                                        Foreground="#64748B"
                                        BorderThickness="1"
                                        BorderBrush="#E2E8F0"
                                        ToolTip="Hap faturë të re (Ctrl+T)"
                                        Click="AddReceiptTabButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E0F2FE"/>
                                                    <Setter Property="Foreground" Value="#0284C7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            
                            <!-- Receipt Mode Indicator -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border x:Name="ReturnModeIndicator" 
                                        Background="#FEF3C7" CornerRadius="6" 
                                        Padding="12,6" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↩️" Margin="0,0,6,0"/>
                                        <TextBlock Text="KTHIM/RIMBURSIM" Foreground="#F59E0B" 
                                                   FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="ReturnModeButton" Content="↩️ Kthim" 
                                        Style="{StaticResource EnterpriseGhostButton}"
                                        Padding="12,6" FontSize="14" Height="36" Margin="8,0,0,0"
                                        Click="ReturnModeButton_Click"
                                        ToolTip="Aktivizo modalitetin e kthimit/rimbursimit"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Receipt Items DataGrid -->
                    <DataGrid x:Name="ReceiptItemsDataGrid" Grid.Row="1" 
                              Style="{StaticResource POSDataGrid}"
                              Margin="0"
                              AutoGenerateColumns="False"
                              FontSize="14"
                              RowHeight="56"
                              SelectionChanged="ReceiptItemsDataGrid_SelectionChanged"
                              CellEditEnding="ReceiptItemsDataGrid_CellEditEnding"
                              BeginningEdit="ReceiptItemsDataGrid_BeginningEdit"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="ReceiptItemsDataGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="ReceiptItemsDataGrid_PreviewMouseMove"
                              Drop="ReceiptItemsDataGrid_Drop">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Barkodi" Binding="{Binding Barcode}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Artikulli" Binding="{Binding ArticleName}" Width="*" IsReadOnly="True"/>
                            
                            <!-- Quantity Column with +/- buttons - Simplified -->
                            <DataGridTemplateColumn Header="Sasia" Width="180" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="-" Width="36" Height="36" 
                                                    FontSize="14" FontWeight="SemiBold"
                                                    Background="#FEF3C7" Foreground="#F59E0B"
                                                    BorderThickness="0"
                                                    Click="DecreaseQuantity_Click" Tag="{Binding}"
                                                    Cursor="Hand" ToolTip="Zvogëlo sasinë (-1)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#F59E0B"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="6" 
                                                    Margin="6,0">
                                                <TextBlock Text="{Binding Quantity, StringFormat=F0}" 
                                                           TextAlignment="Center" VerticalAlignment="Center" 
                                                           FontWeight="SemiBold" FontSize="14"
                                                           Foreground="#0F172A"/>
                                            </Border>
                                            <Button Grid.Column="2" Content="+" Width="36" Height="36" 
                                                    FontSize="14" FontWeight="SemiBold"
                                                    Background="#DCFCE7" Foreground="#059669"
                                                    BorderThickness="0"
                                                    Click="IncreaseQuantity_Click" Tag="{Binding}"
                                                    Cursor="Hand" ToolTip="Rrit sasinë (+1)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Çmimi" Binding="{Binding Price, StringFormat=F2}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Zbritje %" Binding="{Binding DiscountPercent, StringFormat=F2}" Width="85"/>
                            <DataGridTextColumn Header="Zbritje %" Binding="{Binding DiscountValue, StringFormat=F2}" Width="85"/>
                            <DataGridTextColumn Header="Vlera" Binding="{Binding TotalValue, StringFormat=F2}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <!-- Delete Button Column -->
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#x1F5D1;" Width="36" Height="36" 
                                                FontSize="16"
                                                Background="#FEF3C7" Foreground="#F59E0B"
                                                BorderThickness="0"
                                                Click="DeleteRow_Click" Tag="{Binding}"
                                                ToolTip="Fshi artikullin"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#F59E0B"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ACTION BAR - Main Actions with Total Display -->
        <Grid Grid.Row="3" Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Action Buttons -->
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- Print Receipt - Primary Action with Glow -->
                <Button x:Name="PrintReceiptButton" 
                        Style="{StaticResource EnterpriseSuccessButton}"
                        Width="200" Height="44" Margin="0,0,12,0"
                        Click="PrintReceiptButton_Click"
                        ToolTip="Printo dhe përfundo faturën (F5)">
                    <Button.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.3" Color="#059669"/>
                    </Button.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F5A8;" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="PRINTO" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="F5" FontSize="14" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                
                <!-- Recent Receipts -->
                <Button x:Name="CopyButton" 
                        Style="{StaticResource EnterprisePrimaryButton}"
                        Width="180" Height="44" Margin="0,0,12,0"
                        Click="CopyButton_Click"
                        ToolTip="Hap faturat e fundit (F6)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4CB;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="FATURAT" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="F6" FontSize="14" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                
                <!-- Apply Discount -->
                <Button x:Name="ApplyDiscountButton" 
                        Style="{StaticResource EnterpriseAccentButton}"
                        Width="160" Height="44" Margin="0,0,12,0"
                        Click="ApplyDiscountButton_Click"
                        ToolTip="Apliko zbritje (F4)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4B0;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="ZBRITJE" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="F4" FontSize="14" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                
                <!-- Clear Row -->
                <Button x:Name="ClearRowButton" 
                        Style="{StaticResource EnterpriseWarningButton}"
                        Width="160" Height="44" Margin="0,0,12,0"
                        Click="ClearRowButton_Click"
                        ToolTip="Fshi rreshtin e zgjedhur (F3)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F5D1;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="PASTRO" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="F3" FontSize="14" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                
                <!-- Discard Receipt -->
                <Button x:Name="DiscardReceiptButton" 
                        Style="{StaticResource EnterpriseDangerButton}"
                        Width="160" Height="44" Margin="0,0,12,0"
                        Click="DiscardReceiptButton_Click"
                        ToolTip="Anulo të gjithë faturën (F10)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✗" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="ANULO" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="F10" FontSize="14" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                
                <!-- Customer Lookup -->
                <Button x:Name="CustomerLookupButton" 
                        Style="{StaticResource EnterpriseGhostButton}"
                        Height="44" Margin="0,0,12,0"
                        Click="CustomerLookupButton_Click"
                        ToolTip="Kërko klient (Ctrl+K)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F465;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Klient" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
            
            <!-- Total Display Panel - Premium Design with Glow Effect -->
            <Border Grid.Column="1" CornerRadius="6" Padding="24,16" MinWidth="320">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#059669" Offset="0"/>
                        <GradientStop Color="#047857" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="30" Opacity="0.4" Color="#059669"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="TOTALI" FontSize="14" Foreground="White" Opacity="0.9" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TaxDisplayText" Text="TVSH: 0.00 &#x20AC;" 
                                   FontSize="14" Foreground="White" Opacity="0.7" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ItemCountText" Text="0 artikuj" 
                                   FontSize="14" Foreground="White" Opacity="0.7"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalDisplayText" Text="0.00" 
                                   FontSize="42" FontWeight="SemiBold" 
                                   Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock Text="EUR" FontSize="14" Foreground="White" Opacity="0.8" 
                                   HorizontalAlignment="Right" Margin="0,-4,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ADVANCED OPTIONS PANEL - Collapsible -->
        <Expander Grid.Row="4" 
                  Style="{StaticResource EnterpriseExpander}"
                  Header="&#x2699; Opsione të avancuara (Pagesa, Lloji i faturës, Raportet fiskale)" 
                  IsExpanded="False" 
                  Margin="16,0,16,16">
            <Grid Margin="0,16,0,0" MinHeight="180">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                    <ColumnDefinition Width="*" MinWidth="280"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="Auto" MinWidth="220"/>
                </Grid.ColumnDefinitions>
                
                <!-- Buyer Info -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Informacioni i blerësit" FontWeight="SemiBold" FontSize="14" 
                               Foreground="#475569" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Emri i blerësit" FontSize="14" Foreground="#64748B" Margin="0,0,0,6"/>
                    <TextBox x:Name="BuyerNameTextBox" Text="Qytetar" 
                             Height="36" FontSize="14"
                             Background="White" Foreground="#1E293B"
                             BorderBrush="#CBD5E1" BorderThickness="1.5"
                             Padding="12,8" VerticalContentAlignment="Center"
                             IsEnabled="True" IsReadOnly="False" Focusable="True" IsTabStop="True">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                 Padding="{TemplateBinding Padding}"
                                                 VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    
                    <TextBlock Text="Vërejtje" FontSize="14" Foreground="#64748B" Margin="0,12,0,6"/>
                    <TextBox x:Name="RemarkTextBox" 
                             Height="70" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14"
                             Background="White" Foreground="#1E293B"
                             BorderBrush="#CBD5E1" BorderThickness="1.5"
                             Padding="12,8" VerticalContentAlignment="Top"
                             IsEnabled="True" IsReadOnly="False" Focusable="True" IsTabStop="True">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                 Padding="{TemplateBinding Padding}"
                                                 VerticalAlignment="Top"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </StackPanel>
                
                <!-- Payment Panel -->
                <StackPanel Grid.Column="1" Margin="16,0">
                    <TextBlock Text="Pagesa" FontWeight="SemiBold" FontSize="14" 
                               Foreground="#475569" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Mënyra e pagesës" FontSize="14" Foreground="#64748B" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="CashPaymentRadio" 
                                     Style="{StaticResource EnterpriseRadioButton}"
                                     Content="&#x1F4B5; Para (F7)" 
                                     IsChecked="True" GroupName="PaymentMethod" 
                                     FontSize="14" 
                                     Checked="PaymentMethodChanged" Margin="0,0,20,0"/>
                        <RadioButton x:Name="CardPaymentRadio" 
                                     Style="{StaticResource EnterpriseRadioButton}"
                                     Content="&#x1F4B3; Kartë (F8)" 
                                     GroupName="PaymentMethod" 
                                     FontSize="14"
                                     Checked="PaymentMethodChanged"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Paguar (&#xf058;)" FontSize="14" Foreground="#64748B" Margin="0,0,0,6"/>
                            <TextBox x:Name="PaidAmountTextBox" 
                                     Height="44" FontSize="14"
                                     TextAlignment="Right" Text="0.00"
                                     TextChanged="PaidAmountTextBox_TextChanged"
                                     Background="White" Foreground="#1E293B"
                                     BorderBrush="#22C55E" BorderThickness="2"
                                     Padding="12,8" VerticalContentAlignment="Center"
                                     IsEnabled="True" IsReadOnly="False" Focusable="True" IsTabStop="True">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ScrollViewer x:Name="PART_ContentHost" 
                                                         Padding="{TemplateBinding Padding}"
                                                         VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Kusur (&#xf51e;)" FontSize="14" Foreground="#64748B" Margin="0,0,0,6"/>
                            <TextBox x:Name="LeftAmountTextBox" 
                                     Height="44" FontSize="14"
                                     TextAlignment="Right" Text="0.00" IsReadOnly="True"
                                     Background="#FEF3C7" Foreground="#92400E"
                                     BorderBrush="#FCD34D" BorderThickness="2"
                                     VerticalContentAlignment="Center" Padding="12,8">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ScrollViewer x:Name="PART_ContentHost" 
                                                         Padding="{TemplateBinding Padding}"
                                                         VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                
                <!-- Receipt Types -->
                <StackPanel Grid.Column="2" Margin="16,0">
                    <TextBlock Text="Lloji i Faturës" FontWeight="SemiBold" FontSize="14" 
                               Foreground="#475569" Margin="0,0,0,12"/>
                    
                    <CheckBox x:Name="FiscalReceiptCheck" 
                              Style="{StaticResource EnterpriseCheckBox}"
                              Content="&#x1F9FE; Faturë Fiskale (F9)" 
                              IsChecked="True" FontSize="14" Margin="0,0,0,10"/>
                    <CheckBox x:Name="SimpleReceiptCheck" 
                              Style="{StaticResource EnterpriseCheckBox}"
                              Content="&#x1F4C4; Faturë e Thjeshtë (F11)" 
                              FontSize="14" Margin="0,0,0,10"/>
                    <CheckBox x:Name="WaybillReceiptCheck" 
                              Style="{StaticResource EnterpriseCheckBox}"
                              Content="&#x1F4E6; Fletëdërgesë (F12)" 
                              FontSize="14"/>
                </StackPanel>
                
                <!-- Fiscal Reports -->
                <StackPanel Grid.Column="3" MinWidth="200">
                    <TextBlock Text="Raportet Fiskale" FontWeight="SemiBold" FontSize="14" 
                               Foreground="#475569" Margin="0,0,0,12"/>
                    
                    <WrapPanel>
                        <Button x:Name="XReportButton" 
                                Width="60" Height="44" Margin="0,0,8,8"
                                FontWeight="SemiBold" FontSize="14"
                                Background="#E0F2FE" Foreground="#0284C7"
                                BorderThickness="0"
                                Click="XReportButton_Click" 
                                ToolTip="X-Raport (Ctrl+X)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                                            CornerRadius="6">
                                        <TextBlock Text="X" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button x:Name="ZReportButton" 
                                Width="60" Height="44" Margin="0,0,8,8"
                                FontWeight="SemiBold" FontSize="14"
                                Background="#FEF3C7" Foreground="#F59E0B"
                                BorderThickness="0"
                                Click="ZReportButton_Click" 
                                ToolTip="Z-Raport - Mbyllje dite (Ctrl+Z)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                                            CornerRadius="6">
                                        <TextBlock Text="Z" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#F59E0B"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button x:Name="SoldArticlesButton" 
                                Width="60" Height="44" Margin="0,0,8,8"
                                FontSize="16"
                                Background="#FEF3C7" Foreground="#92400E"
                                BorderThickness="0"
                                Click="SoldArticlesButton_Click" 
                                ToolTip="Artikujt e shitur (Ctrl+S)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                                            CornerRadius="6">
                                        <TextBlock Text="&#x1F4CA;" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" FontSize="16"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#D97706"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button x:Name="ClearCacheButton" 
                                Width="60" Height="44" Margin="0,0,0,8"
                                FontSize="16"
                                Background="#FFEDD5" Foreground="#C2410C"
                                BorderThickness="0"
                                Click="ClearCacheButton_Click" 
                                ToolTip="Pastro memorien e printerit">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                                            CornerRadius="6">
                                        <TextBlock Text="&#x1F5D1;" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" FontSize="16"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#EA580C"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Expander>
        
        <!-- NUMPAD POPUP - Touch-optimized numeric input -->
        <Popup x:Name="NumpadPopup" 
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="White" 
                    CornerRadius="6" 
                    Padding="20"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="10" BlurRadius="30" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Vendos sasinë" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#475569" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    
                    <TextBox x:Name="NumpadInput" 
                             Width="220" Height="50" FontSize="20" FontWeight="SemiBold"
                             TextAlignment="Center" Margin="0,0,0,16"
                             Style="{StaticResource EnterpriseTextBox}"/>
                    
                    <UniformGrid Rows="4" Columns="3" Width="240">
                        <Button Content="7" Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="8" Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="9" Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="4" Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="5" Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="6" Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="1" Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="2" Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="3" Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="." Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="0" Style="{StaticResource NumpadButton}" Click="NumpadButton_Click"/>
                        <Button Content="?" Style="{StaticResource NumpadButton}" Click="NumpadBackspace_Click" 
                                Background="#FEF3C7" Foreground="#F59E0B"/>
                    </UniformGrid>
                    
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="✗ Anulo" Grid.Column="0" 
                                Style="{StaticResource EnterpriseGhostButton}"
                                Height="44" Margin="0,0,6,0"
                                Click="NumpadCancel_Click"/>
                        <Button Content="&#x2714; Konfirmo" Grid.Column="1" 
                                Style="{StaticResource EnterpriseSuccessButton}"
                                Height="44" Margin="6,0,0,0"
                                Click="NumpadConfirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
        
        <!-- KEYBOARD SHORTCUTS OVERLAY -->
        <Border x:Name="ShortcutsOverlay" Grid.RowSpan="5" 
                Background="#E6000000" Visibility="Collapsed"
                MouseLeftButtonDown="ShortcutsOverlay_Click">
            <Border Background="White" CornerRadius="6" 
                    Padding="40" MaxWidth="700" MaxHeight="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="50" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="&#x2328; Shkurtoret e tastierës" FontSize="20" FontWeight="SemiBold" 
                               Foreground="#0F172A" Margin="0,0,0,24" HorizontalAlignment="Center"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Veprimet kryesore" FontWeight="SemiBold" Foreground="#0284C7" 
                                       FontSize="14" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="F5" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Printo faturën" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="F6" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Faturat e fundit" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="F4" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Apliko zbritje" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="F3" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Fshi rreshtin" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="F10" FontWeight="SemiBold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Anulo faturën" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Pagesa &amp; Raportet" FontWeight="SemiBold" Foreground="#059669" 
                                       FontSize="14" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#DCFCE7" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="F7" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Pagesa me para" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#DCFCE7" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="F8" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Pagesa me kartë" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="Ctrl+X" FontWeight="SemiBold" Foreground="#D97706" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="X-Raport" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="Ctrl+Z" FontWeight="SemiBold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Z-Raport (mbyll ditën)" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="Ctrl+F" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Fokuso kërkimin" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="Shtyp ESC ose kliko jashtë për të mbyllur" 
                               FontSize="14" Foreground="#94A3B8" 
                               HorizontalAlignment="Center" Margin="0,24,0,0"/>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- TRANSACTION SUCCESS OVERLAY -->
        <Border x:Name="SuccessOverlay" Grid.RowSpan="5" 
                Background="#80000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="6" 
                    Padding="50" MaxWidth="400"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="50" Opacity="0.3" Color="#059669"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="#DCFCE7" Width="80" Height="80" CornerRadius="6" Margin="0,0,0,20">
                        <TextBlock Text="&#x2714;" FontSize="40" Foreground="#059669" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Fatura u printua!" FontSize="20" FontWeight="SemiBold" 
                               Foreground="#059669" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SuccessReceiptNumber" Text="" FontSize="14" 
                               Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- PRICE OVERRIDE PIN DIALOG -->
        <Popup x:Name="PriceOverridePopup" 
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="White" 
                    CornerRadius="6" 
                    Padding="30"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    MinWidth="320">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="10" BlurRadius="30" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="&#x1F510; Autorizim Menaxheri" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#0F172A" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <TextBlock Text="Vendosni PIN-in për ndryshim Çmimi" FontSize="14" 
                               Foreground="#64748B" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    
                    <PasswordBox x:Name="ManagerPinBox" 
                                 Width="200" Height="50" FontSize="20"
                                 HorizontalAlignment="Center"
                                 MaxLength="4"/>
                    
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Anulo" Grid.Column="0" 
                                Style="{StaticResource EnterpriseGhostButton}"
                                Height="44" Margin="0,0,8,0"
                                Click="PriceOverrideCancel_Click"/>
                        <Button Content="&#x1F511; Autorizo" Grid.Column="1" 
                                Style="{StaticResource EnterprisePrimaryButton}"
                                Height="44" Margin="8,0,0,0"
                                Click="PriceOverrideConfirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

