<Window x:Class="KosovaPOS.Windows.FinanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Financat - Hyrjet, Daljet dhe Borxhet" 
        Height="850" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F5F5">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#0284C7" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="&#x1F4B0; FINANCAT" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Shitjet (Hyrjet), Blerjet (Daljet) dhe Borxhet" FontSize="14" Foreground="#B0BEC5"/>
                </StackPanel>
                
                <!-- Summary Cards -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#059669" CornerRadius="6" Padding="20,12" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F4C8; Shitjet (Hyrjet)" Foreground="White" FontSize="14"/>
                            <TextBlock x:Name="TotalIncomeText" Text="0.00€" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="IncomeCountText" Text="0 transaksione" Foreground="#A7F3D0" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#DC2626" CornerRadius="6" Padding="20,12" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F4C9; Blerjet (Daljet)" Foreground="White" FontSize="14"/>
                            <TextBlock x:Name="TotalExpenseText" Text="0.00€" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ExpenseCountText" Text="0 transaksione" Foreground="#FECACA" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#D97706" CornerRadius="6" Padding="20,12" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F4CA; Bilanci" Foreground="White" FontSize="14"/>
                            <TextBlock x:Name="BalanceText" Text="0.00€" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Shitje - Blerje" Foreground="#FEF3C7" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0891B2" CornerRadius="6" Padding="20,12" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F4B3; Borxhet" Foreground="White" FontSize="14"/>
                            <TextBlock x:Name="TotalDebtsText" Text="0.00€" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DebtsCountText" Text="0 klientë" Foreground="#CFFAFE" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Tab Control -->
        <TabControl Grid.Row="1" Margin="15" x:Name="MainTabControl">
            
            <!-- Sales/Income Tab (from ArkaHyrjeDalje where VleraH > 0) -->
            <TabItem Header="&#x1F4C8; Shitjet (Hyrjet)" FontSize="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="5" Orientation="Horizontal">
                                <TextBlock Text="Nga:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <DatePicker x:Name="IncomeFromDate" Width="120" SelectedDateChanged="IncomeFilter_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5" Orientation="Horizontal">
                                <TextBlock Text="Deri:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <DatePicker x:Name="IncomeToDate" Width="120" SelectedDateChanged="IncomeFilter_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="5" Orientation="Horizontal">
                                <TextBlock Text="Kërko:" VerticalAlignment="Center" Margin="10,0,8,0" FontWeight="SemiBold"/>
                                <TextBox x:Name="IncomeSearchBox" Style="{StaticResource ModernTextBox}" Width="200" Height="36" TextChanged="IncomeSearch_Changed"/>
                            </StackPanel>
                            <TextBlock x:Name="IncomeResultText" Grid.Column="3" VerticalAlignment="Center" 
                                       FontStyle="Italic" Foreground="#64748B" Margin="15,0,0,0"/>
                            <Button Grid.Column="4" Content="&#x1F504; Rifresko" Click="RefreshIncome_Click"
                                    Background="#0284C7" Foreground="White" Padding="10,0" Height="36" Cursor="Hand"/>
                        </Grid>
                    </Border>
                    
                    <!-- Income List (Sales from ArkaHyrjeDalje) -->
                    <DataGrid Grid.Row="1" x:Name="IncomeDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="White"
                              BorderThickness="1"
                              BorderBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Dokumenti" Binding="{Binding DOK}" Width="120"/>
                            <DataGridTextColumn Header="Përshkrimi" Binding="{Binding Pershkrimi}" Width="*"/>
                            <DataGridTextColumn Header="Vlera ë" Binding="{Binding VleraH, StringFormat=N2}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <!-- Purchases/Expense Tab (from ArkaHyrjeDalje where VleraD > 0) -->
            <TabItem Header="&#x1F4C9; Blerjet (Daljet)" FontSize="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="5" Orientation="Horizontal">
                                <TextBlock Text="Nga:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <DatePicker x:Name="ExpenseFromDate" Width="120" SelectedDateChanged="ExpenseFilter_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5" Orientation="Horizontal">
                                <TextBlock Text="Deri:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <DatePicker x:Name="ExpenseToDate" Width="120" SelectedDateChanged="ExpenseFilter_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="5" Orientation="Horizontal">
                                <TextBlock Text="Kërko:" VerticalAlignment="Center" Margin="10,0,8,0" FontWeight="SemiBold"/>
                                <TextBox x:Name="ExpenseSearchBox" Style="{StaticResource ModernTextBox}" Width="200" Height="36" TextChanged="ExpenseSearch_Changed"/>
                            </StackPanel>
                            <TextBlock x:Name="ExpenseResultText" Grid.Column="3" VerticalAlignment="Center" 
                                       FontStyle="Italic" Foreground="#64748B" Margin="15,0,0,0"/>
                            <Button Grid.Column="4" Content="&#x1F504; Rifresko" Click="RefreshExpense_Click"
                                    Background="#0284C7" Foreground="White" Padding="10,0" Height="36" Cursor="Hand"/>
                        </Grid>
                    </Border>
                    
                    <!-- Expense List (Purchases from ArkaHyrjeDalje) -->
                    <DataGrid Grid.Row="1" x:Name="ExpenseDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="White"
                              BorderThickness="1"
                              BorderBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Dokumenti" Binding="{Binding DOK}" Width="120"/>
                            <DataGridTextColumn Header="Përshkrimi" Binding="{Binding Pershkrimi}" Width="*"/>
                            <DataGridTextColumn Header="Vlera €" Binding="{Binding VleraD, StringFormat=N2}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="TextAlignment" Value="Right"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                             </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <!-- Debts Tab -->
            <TabItem Header="&#x1F4B3; Borxhet e Klientëve" FontSize="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Add New Debt -->
                    <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="5">
                                <TextBlock Text="Klienti" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="DebtCustomerBox" Style="{StaticResource ModernTextBox}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5">
                                <TextBlock Text="Vlera (€)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="DebtAmountBox" Style="{StaticResource ModernTextBox}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="5">
                                <TextBlock Text="Pagoi (€)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="DebtPaidBox" Style="{StaticResource ModernTextBox}" Height="36" Text="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="5">
                                <TextBlock Text="Përshkrimi" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="DebtDescriptionBox" Style="{StaticResource ModernTextBox}" Height="36"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="Shto Borxh" Click="AddDebt_Click"
                                    Background="#D97706" Foreground="White" 
                                    Padding="10,0" Height="36" Margin="5" VerticalAlignment="Bottom"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>
                    
                    <!-- Debts List -->
                    <DataGrid Grid.Row="1" x:Name="DebtsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="White"
                              BorderThickness="1"
                              BorderBrush="#E0E0E0"
                              SelectionChanged="DebtsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Klienti" Binding="{Binding Klienti}" Width="*"/>
                            <DataGridTextColumn Header="Vlera" Binding="{Binding Vlera, StringFormat=€{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Pagoi" Binding="{Binding Pagoi, StringFormat=€{0:N2}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#059669"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mbeti" Binding="{Binding Mbeti, StringFormat=€{0:N2}}" Width="100">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                             </DataGridTextColumn>
                            <DataGridTextColumn Header="Përshkrimi" Binding="{Binding Pershkrimi}" Width="150"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="&#x1F4B5; Regjistro Pagesë" Click="RecordPayment_Click"/>
                                <MenuItem Header="&#x1F5D1; Fshi" Click="DeleteDebt_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <!-- Supplier Debts Tab (from DitariH with Mbeti > 0) -->
            <TabItem Header="&#x1F3ED; Borxhet e Furnitorëve" FontSize="16">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Summary -->
                    <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Borxhet ndaj furnitorëve (blerje të papaguara)" 
                                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SupplierDebtsTotalText" Text=" - Total: 0.00 €" 
                                           FontSize="16" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#x1F504; Rifresko" Click="RefreshSupplierDebts_Click"
                                    Background="#0284C7" Foreground="White" Padding="10,0" Height="36" Cursor="Hand"/>
                        </Grid>
                    </Border>
                    
                    <!-- Supplier Debts List -->
                    <DataGrid Grid.Row="1" x:Name="SupplierDebtsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="White"
                              BorderThickness="1"
                              BorderBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr. Faturës" Binding="{Binding InvoiceNumber}" Width="130"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Furnitori" Binding="{Binding SupplierName}" Width="*"/>
                            <DataGridTextColumn Header="Totali (€)" Binding="{Binding TotalAmount, StringFormat=N2}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Paguar (€)" Binding="{Binding PaidAmount, StringFormat=N2}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mbetur (€)" Binding="{Binding RemainingAmount, StringFormat=N2}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="&#x1F4B5; Regjistro Pagesë" Click="PaySupplierDebt_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="#ECEFF1" Padding="15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="&#x1F504; Rifresko të gjitha" Click="Refresh_Click"
                            Background="#0284C7" Foreground="White"
                            Padding="20,8" Margin="0,0,10,0"
                            Cursor="Hand"/>
                    <TextBlock x:Name="LastUpdateText" VerticalAlignment="Center" Foreground="#64748B" FontStyle="Italic"/>
                </StackPanel>
                <Button Content="Mbyll" Click="Close_Click"
                        Background="#757575" Foreground="White"
                        Padding="20,8" HorizontalAlignment="Right"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
