<Window x:Class="KosovaPOS.Windows.InventoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x1F4E6; Inventory Management - Menaxhimi i Inventarit" 
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="30,25">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0891B2" Offset="0"/>
                    <GradientStop Color="#0E7490" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4E6; Inventory Management System" 
                               FontSize="20" FontWeight="SemiBold" 
                               Foreground="White"/>
                    <TextBlock Text="Menaxho stoqet, levizjet, furnizuesit dhe alertet e stoqeve"
                               FontSize="14" Foreground="White" Opacity="0.95"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#x1F4E5; Stok Hyrje" Click="StockIn_Click"
                            Style="{StaticResource HeaderButton}"
                            Background="#22C55E"/>
                    <Button Content="&#x1F4E4; Stok Dalje" Click="StockOut_Click"
                            Style="{StaticResource HeaderButton}"
                            Background="#D97706"/>
                    <Button Content="&#x1F504; Rifresko" Click="Refresh_Click"
                            Style="{StaticResource HeaderButton}"
                            Background="#0891B2"/>
                    <Button Content="? Mbyll" Click="Close_Click"
                            Style="{StaticResource HeaderButton}"
                            Background="#64748B"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="30">
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- Stock Levels Tab -->
                <TabItem Header="&#x1F4E6; STOQET" FontSize="16" FontWeight="SemiBold" Padding="20,10">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Statistics Cards -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Background="White" CornerRadius="6" Padding="25" Margin="0,0,15,0" Width="220">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="&#x1F4E6; Artikuj Totalë" FontSize="14" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtTotalItems" Text="0" 
                                               FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="6" Padding="25" Margin="0,0,15,0" Width="220">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="? Stok i Ulët" FontSize="14" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtLowStock" Text="0" 
                                               FontSize="20" FontWeight="SemiBold" Foreground="#D97706" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="6" Padding="25" Margin="0,0,15,0" Width="220">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="? Stok i Mjaftueshëm" FontSize="14" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtGoodStock" Text="0" 
                                               FontSize="20" FontWeight="SemiBold" Foreground="#22C55E" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="6" Padding="25" Width="220">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="&#x1F4B0; Vlera Totale" FontSize="14" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtTotalValue" Text="€ 0.00" 
                                               FontSize="20" FontWeight="SemiBold" Foreground="#3B82F6" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Search & Filter -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtSearch" Grid.Column="0"
                                     FontSize="14" Padding="15"
                                     BorderBrush="#D1D5DB" BorderThickness="1"
                                     Background="White"
                                     VerticalContentAlignment="Center"
                                     TextChanged="Search_TextChanged">
                                <TextBox.Resources>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="&#x1F50D; Kërko artikuj..." 
                                                                           Foreground="#9CA3AF" 
                                                                           FontSize="14" 
                                                                           Margin="5,0,0,0"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <ComboBox x:Name="cmbStockFilter" Grid.Column="1" 
                                      Width="200" Margin="10,0,0,0"
                                      FontSize="14" Padding="10"
                                      SelectionChanged="StockFilter_Changed">
                                <ComboBoxItem Content="&#x1F4E6; Të Gjitha" IsSelected="True"/>
                                <ComboBoxItem Content="? Stok i Ulët"/>
                                <ComboBoxItem Content="? Stok i Mjaftueshëm"/>
                                <ComboBoxItem Content="? Pa Stok"/>
                            </ComboBox>
                        </Grid>

                        <!-- Stock DataGrid -->
                        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                            </Border.Effect>
                            <DataGrid x:Name="dgStock" Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="&#x1F4E6; Artikulli" Binding="{Binding ArticleName}" Width="250"/>
                                    <DataGridTextColumn Header="&#x1F4CA; Sasia Aktuale" Binding="{Binding CurrentQuantity, StringFormat={}{0:N2}}" Width="130"/>
                                    <DataGridTextColumn Header="? Min. Sasi" Binding="{Binding MinimumQuantity, StringFormat={}{0:N2}}" Width="120"/>
                                    <DataGridTextColumn Header="&#x1F504; Porosi Sasia" Binding="{Binding ReorderQuantity, StringFormat={}{0:N2}}" Width="130"/>
                                    <DataGridTextColumn Header="&#x1F4CF; Njësia" Binding="{Binding Unit}" Width="80"/>
                                    <DataGridTextColumn Header="&#x1F4CD; Lokacioni" Binding="{Binding Location}" Width="150"/>
                                    <DataGridTextColumn Header="&#x1F4C5; Furnizimi i Fundit" Binding="{Binding LastRestockedAt, StringFormat=dd/MM/yyyy}" Width="150"/>
                                    <DataGridTemplateColumn Header="Statusi" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StockStatus}" Value="Low">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StockStatus}" Value="OutOfStock">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StockStatus}" Value="Good">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StockStatusText}" FontSize="14" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Movements Tab -->
                <TabItem Header="&#x1F4CB; LËVIZJET" FontSize="16" FontWeight="SemiBold" Padding="20,10">
                    <Grid Margin="0,20,0,0">
                        <Border Background="White" CornerRadius="6" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                            </Border.Effect>
                            <DataGrid x:Name="dgMovements" Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="&#x1F4E6; Artikulli" Binding="{Binding ArticleId}" Width="100"/>
                                    <DataGridTextColumn Header="&#x1F4DD; Lloji" Binding="{Binding MovementType}" Width="120"/>
                                    <DataGridTextColumn Header="&#x1F4CA; Sasia" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="100"/>
                                    <DataGridTextColumn Header="&#x1F4C4; Referenca" Binding="{Binding ReferenceNumber}" Width="150"/>
                                    <DataGridTextColumn Header="&#x1F3F7; Batch" Binding="{Binding BatchNumber}" Width="120"/>
                                    <DataGridTextColumn Header="&#x1F4C5; Data e Skadimit" Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}" Width="140"/>
                                    <DataGridTextColumn Header="&#x1F4CB; Shënime" Binding="{Binding Notes}" Width="250"/>
                                    <DataGridTextColumn Header="&#x1F4C5; Data" Binding="{Binding MovementDate, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                                    <DataGridTextColumn Header="&#x1F464; Përdoruesi" Binding="{Binding CreatedBy}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Suppliers Tab -->
                <TabItem Header="&#x1F69A; FURNIZUESIT" FontSize="16" FontWeight="SemiBold" Padding="20,10">
                    <Grid Margin="0,20,0,0">
                        <Border Background="White" CornerRadius="6" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                            </Border.Effect>
                            <DataGrid x:Name="dgSuppliers" Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="&#x1F3E2; Emri" Binding="{Binding Name}" Width="250"/>
                                    <DataGridTextColumn Header="&#x1F4DE; Telefoni" Binding="{Binding Phone}" Width="130"/>
                                    <DataGridTextColumn Header="&#x1F4E7; Email" Binding="{Binding Email}" Width="200"/>
                                    <DataGridTextColumn Header="&#x1F4CD; Adresa" Binding="{Binding Address}" Width="250"/>
                                    <DataGridTextColumn Header="&#x1F4B0; Balanca" Binding="{Binding Balance, StringFormat=€{0:N2}}" Width="120"/>
                                    <DataGridTextColumn Header="&#x1F4C5; Kriuar" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Alerts Tab -->
                <TabItem Header="? ALERTET" FontSize="16" FontWeight="SemiBold" Padding="20,10">
                    <Grid Margin="0,20,0,0">
                        <Border Background="White" CornerRadius="6" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                            </Border.Effect>
                            <DataGrid x:Name="dgAlerts" Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="? Lloji" Binding="{Binding AlertType}" Width="150"/>
                                    <DataGridTextColumn Header="&#x1F4E6; Artikulli" Binding="{Binding ArticleName}" Width="250"/>
                                    <DataGridTextColumn Header="&#x1F4CA; Sasia Aktuale" Binding="{Binding CurrentQuantity, StringFormat={}{0:N2}}" Width="130"/>
                                    <DataGridTextColumn Header="? Niveli Kritik" Binding="{Binding ThresholdQuantity, StringFormat={}{0:N2}}" Width="130"/>
                                    <DataGridTextColumn Header="&#x1F4CB; Mesazhi" Binding="{Binding Message}" Width="300"/>
                                    <DataGridTextColumn Header="&#x1F4C5; Krijuar" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                                    <DataGridTemplateColumn Header="Statusi" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#FEE2E2" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="SemiBold" Foreground="#DC2626"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
