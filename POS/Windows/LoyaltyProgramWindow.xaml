<Window x:Class="KosovaPOS.Windows.LoyaltyProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x1F4B3; Customer Loyalty Program - Programi i Besnikërisë" 
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#D1D5DB"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#047857"/><Setter TargetName="border" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#6EE7B7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="30,25">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#047857" Offset="0"/>
                    <GradientStop Color="#065F46" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4B3; Customer Loyalty Program" 
                               FontSize="20" FontWeight="SemiBold" 
                               Foreground="White"/>
                    <TextBlock Text="Menaxho klientët, pikat e besnikërisë dhe fushatat promocionale"
                               FontSize="14" Foreground="White" Opacity="0.95"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#x2795; Klient i ri" Click="AddCustomer_Click"
                            Style="{StaticResource HeaderButton}"
                            Background="#22C55E"/>
                    <Button Content="&#x2B50; Shto pikë" Click="AddPoints_Click"
                            Style="{StaticResource HeaderButton}"
                            Background="#F59E0B"/>
                    <Button Content="&#x1F4B0; Shto balanc" Click="AddBalance_Click"
                            Style="{StaticResource HeaderButton}"
                            Background="#059669"
                            ToolTip="Shto balanc monetar / kredit dyqani tek klienti i zgjedhur"/>
                    <Button Content="&#x270F; Ndrysho klientin" Click="EditCustomer_Click_Header"
                            Style="{StaticResource HeaderButton}"
                            Background="#3B82F6"/>
                    <Button Content="&#x1F381; Kampanjë e re" Click="AddCampaign_Click"
                            Style="{StaticResource HeaderButton}"
                            Background="#0891B2"/>
                    <Button Content="&#x1F504; Rifresko" Click="Refresh_Click"
                            Style="{StaticResource HeaderButton}"
                            Background="#475569"/>
                    <Button Content="&#x2715; Mbyll" Click="Close_Click"
                            Style="{StaticResource HeaderButton}"
                            Background="#374151"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="30">
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- Customers Tab -->
                <TabItem Header="&#x1F465; KLIENTËT" FontSize="16" FontWeight="SemiBold" Padding="20,10">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Statistics Cards -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <!-- Total Customers Card -->
                            <Border Background="White" CornerRadius="6" Padding="25" Margin="0,0,15,0" Width="250">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="&#x1F465; Klientë Totalë" FontSize="14" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtTotalCustomers" Text="0" 
                                               FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Active Customers Card -->
                            <Border Background="White" CornerRadius="6" Padding="25" Margin="0,0,15,0" Width="250">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="&#x2705; Klientë Aktivë" FontSize="14" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtActiveCustomers" Text="0" 
                                               FontSize="20" FontWeight="SemiBold" Foreground="#22C55E" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Total Points Card -->
                            <Border Background="White" CornerRadius="6" Padding="25" Margin="0,0,15,0" Width="250">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="&#x2B50; Pika në Qarkullim" FontSize="14" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtTotalPoints" Text="0" 
                                               FontSize="20" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Average Spent Card -->
                            <Border Background="White" CornerRadius="6" Padding="25" Width="250">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="&#x1F4B0; Shpenzim Mesatar" FontSize="14" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtAverageSpent" Text="0.00 €" 
                                               FontSize="20" FontWeight="SemiBold" Foreground="#3B82F6" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Search Bar -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock Text="Kërko klientin:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtSearch" Grid.Column="0" Style="{StaticResource RoundedTextBox}"
                                     FontSize="14" Padding="15"
                                     BorderBrush="#D1D5DB" BorderThickness="1"
                                     Background="White"
                                     VerticalContentAlignment="Center"
                                     TextChanged="Search_TextChanged">
                                <TextBox.Resources>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="&#x1F50D; Kërko sipas emrit, telefonit ose numrit të kartës..." 
                                                                           Foreground="#9CA3AF" 
                                                                           FontSize="14" 
                                                                           Margin="5,0,0,0"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <ComboBox x:Name="cmbTierFilter" Grid.Column="1" 
                                      Width="200" Margin="10,0,0,0"
                                      FontSize="14" Padding="10"
                                      SelectionChanged="TierFilter_Changed">
                                <ComboBoxItem Content="&#x1F3C6; Të Gjitha Nivelet" IsSelected="True"/>
                                <ComboBoxItem Content="&#x1F949; Bronze"/>
                                <ComboBoxItem Content="&#x1F948; Silver"/>
                                <ComboBoxItem Content="&#x1F947; Gold"/>
                                <ComboBoxItem Content="&#x1F48E; Platinum"/>
                            </ComboBox>
                            </Grid>
                        </StackPanel>

                        <!-- Customers DataGrid -->
                        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                            </Border.Effect>
                            <DataGrid x:Name="dgCustomers" Style="{StaticResource DataGridStyle}"
                                      MouseDoubleClick="CustomerRow_DoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="&#x1F4DB; Emri" Binding="{Binding Name}" Width="200"/>
                                    <DataGridTextColumn Header="&#x1F4DE; Telefoni" Binding="{Binding Phone}" Width="120"/>
                                    <DataGridTextColumn Header="&#x1F4B3; Nr. Kartës" Binding="{Binding LoyaltyCardNumber}" Width="130"/>
                                    <DataGridTextColumn Header="&#x2B50; Pika" Binding="{Binding LoyaltyPoints}" Width="80"/>
                                    <DataGridTextColumn Header="&#x1F3C6; Niveli" Binding="{Binding Tier}" Width="100"/>
                                    <DataGridTextColumn Header="&#x1F4B0; Shpenzuar" Binding="{Binding TotalSpent, StringFormat='{}{0:N2} €'}" Width="110"/>
                                    <DataGridTextColumn Header="&#x1F4B3; Kredit Dyqani" Binding="{Binding StoreCredit, StringFormat='{}{0:N2} €'}" Width="115"/>
                                    <DataGridTextColumn Header="&#x1F6D2; Porosi" Binding="{Binding OrderCount}" Width="75"/>
                                    <DataGridTextColumn Header="&#x1F4C5; Vizita e Fundit" Binding="{Binding LastVisit, StringFormat=dd/MM/yyyy}" Width="120"/>
                                    <DataGridTemplateColumn Header="Veprimet" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="&#x270F;" Click="EditCustomer_Click" 
                                                            Tag="{Binding Id}" Margin="2" Padding="8,4" 
                                                            Background="#3B82F6" Foreground="White" 
                                                            BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Modifiko"/>
                                                    <Button Content="&#x1F4CA;" Click="ViewHistory_Click" 
                                                            Tag="{Binding Id}" Margin="2" Padding="8,4" 
                                                            Background="#0891B2" Foreground="White" 
                                                            BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Historiku"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Campaigns Tab -->
                <TabItem Header="&#x1F381; KAMPANJAT" FontSize="16" FontWeight="SemiBold" Padding="20,10">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="White" CornerRadius="6" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                            </Border.Effect>
                            <DataGrid x:Name="dgCampaigns" Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="&#x1F381; Emri i Kampanjës" Binding="{Binding Name}" Width="250"/>
                                    <DataGridTextColumn Header="&#x1F4DD; Përshkrimi" Binding="{Binding Description}" Width="300"/>
                                    <DataGridTextColumn Header="&#x2B50; Pika të Nevojshme" Binding="{Binding PointsRequired}" Width="150"/>
                                    <DataGridTextColumn Header="&#x1F4B0; Zbritje" Binding="{Binding DiscountAmount, StringFormat={}{0}%}" Width="100"/>
                                    <DataGridTextColumn Header="&#x1F4C5; Fillimi" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                                    <DataGridTextColumn Header="&#x1F4C5; Mbarimi" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                                    <DataGridTextColumn Header="&#x2705; Statusi" Binding="{Binding IsActive}" Width="80"/>
                                    <DataGridTextColumn Header="&#x1F3AF; P&#xEB;rdorur" Binding="{Binding UsageCount}" Width="80"/>
                                    <DataGridTemplateColumn Header="Veprimet" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="&#x270F;" Click="EditCampaign_Click" Tag="{Binding Id}" Margin="2" Padding="8,4" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Modifiko"/>
                                                    <Button Content="&#x26A1;" Click="ToggleCampaign_Click" Tag="{Binding Id}" Margin="2" Padding="8,4" Background="#F59E0B" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Aktivo/&#xC7;aktivizo"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Transactions Tab -->
                <TabItem Header="&#x1F4B3; TRANSAKSIONET" FontSize="16" FontWeight="SemiBold" Padding="20,10">
                    <Grid Margin="0,20,0,0">
                        <Border Background="White" CornerRadius="6" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="3"/>
                            </Border.Effect>
                            <DataGrid x:Name="dgTransactions" Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="&#x1F464; Klienti" Binding="{Binding CustomerName}" Width="200"/>
                                    <DataGridTextColumn Header="&#x1F4DD; Lloji" Binding="{Binding TransactionType}" Width="150"/>
                                    <DataGridTextColumn Header="&#x2B50; Pika" Binding="{Binding Points}" Width="100"/>
                                    <DataGridTextColumn Header="&#x1F4B0; Shuma" Binding="{Binding Amount, StringFormat='{}{0:N2} €'}" Width="120"/>
                                    <DataGridTextColumn Header="&#x1F4CB; Përshkrimi" Binding="{Binding Description}" Width="300"/>
                                    <DataGridTextColumn Header="&#x1F4C5; Data" Binding="{Binding TransactionDate, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
