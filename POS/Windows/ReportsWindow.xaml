<Window x:Class="KosovaPOS.Windows.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raportet" Height="850" Width="1400"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="&#x1F4C8; Raportet fiskale dhe financiare" FontSize="20" FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryColor}"/>
                    <TextBlock Text="Raportet e detajuara për biznesin tuaj" FontSize="14" 
                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#x1F6AA; Mbyll" Style="{StaticResource ModernButton}"
                        Click="Close_Click" Width="120" VerticalAlignment="Center"
                        Background="{StaticResource DangerColor}"/>
            </Grid>
        </Border>
        
        <!-- Reports Grid -->
        <ScrollViewer Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Financial Reports -->
                <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="&#x1F4B0; Raportet financiare" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Sales Summary -->
                            <Border Grid.Column="0" Background="#4CAF50" CornerRadius="6" Padding="20" Margin="0,0,10,20">
                                <StackPanel>
                                    <TextBlock Text="&#x1F4CA; Përmbledhja e shitjeve" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="White" Margin="0,0,0,15"/>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Sot:" Foreground="White"/>
                                        <TextBlock x:Name="TodaySalesText" Text="0.00 €" Foreground="White" 
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Kjo javë:" Foreground="White"/>
                                        <TextBlock x:Name="WeekSalesText" Text="0.00 €" Foreground="White" 
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Ky muaj:" Foreground="White"/>
                                        <TextBlock x:Name="MonthSalesText" Text="0.00 €" Foreground="White" 
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <TextBlock Text="Ky vit:" Foreground="White"/>
                                        <TextBlock x:Name="YearSalesText" Text="0.00 €" Foreground="White" 
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Button Content="&#x1F4C4; Detajet" Style="{StaticResource ModernButton}"
                                            Click="SalesDetails_Click" Margin="0,15,0,0"
                                            Background="White" Foreground="{StaticResource SuccessColor}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Purchases Summary -->
                            <Border Grid.Column="1" Background="#0284C7" CornerRadius="6" Padding="20" Margin="10,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="&#x1F6D2; Përmbledhja e blerjeve" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="White" Margin="0,0,0,15"/>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Sot:" Foreground="White"/>
                                        <TextBlock x:Name="TodayPurchasesText" Text="0.00 €" Foreground="White" 
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Kjo javë:" Foreground="White"/>
                                        <TextBlock x:Name="WeekPurchasesText" Text="0.00 €" Foreground="White" 
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Ky muaj:" Foreground="White"/>
                                        <TextBlock x:Name="MonthPurchasesText" Text="0.00 €" Foreground="White" 
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <TextBlock Text="Ky vit:" Foreground="White"/>
                                        <TextBlock x:Name="YearPurchasesText" Text="0.00 €" Foreground="White" 
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Button Content="&#x1F4C4; Detajet" Style="{StaticResource ModernButton}"
                                            Click="PurchasesDetails_Click" Margin="0,15,0,0"
                                            Background="White" Foreground="{StaticResource PrimaryColor}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Profit Analysis -->
                        <Border Background="#2196F3" CornerRadius="6" Padding="20">
                            <StackPanel>
                                <TextBlock Text="&#x1F48E; Analiza e fitimit" FontSize="16" FontWeight="SemiBold" 
                                           Foreground="White" Margin="0,0,0,15"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="Shitjet totale" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="TotalRevenueText" Text="0.00 €" Foreground="White" 
                                                   FontWeight="SemiBold" FontSize="20"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                        <TextBlock Text="Blerjet totale" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="TotalCostText" Text="0.00 €" Foreground="White" 
                                                   FontWeight="SemiBold" FontSize="20"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Fitimi neto" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="NetProfitText" Text="0.00 €" Foreground="White" 
                                                   FontWeight="SemiBold" FontSize="20"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Stock and Tax Reports -->
                <Border Grid.Row="1" Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <TextBlock Text="&#x1F4E6; Raportet e stoqit dhe TVSH" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Stock Value -->
                            <Border Grid.Column="0" Grid.Row="0" Background="#FF9800" CornerRadius="6" 
                                    Padding="20" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="&#x1F4B0;" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Vlera e stoqit" FontSize="14" Foreground="White" 
                                               HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                    <TextBlock x:Name="StockValueText" Text="0.00 €" FontSize="20" FontWeight="SemiBold" 
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Button Content="&#x1F4CA; Shiko detajet" Style="{StaticResource ModernButton}"
                                            Click="StockReport_Click" Margin="0,10,0,0"
                                            Background="White" Foreground="{StaticResource WarningColor}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- VAT Report -->
                            <Border Grid.Column="1" Grid.Row="0" Background="#00BCD4" CornerRadius="6" 
                                    Padding="20" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="&#x1F4C4;" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="TVSH për pagesë" FontSize="14" Foreground="White" 
                                               HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                    <TextBlock x:Name="VATPayableText" Text="0.00 €" FontSize="20" FontWeight="SemiBold" 
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Button Content="&#x1F4CA; Raporti TVSH" Style="{StaticResource ModernButton}"
                                            Click="VATReport_Click" Margin="0,10,0,0"
                                            Background="White" Foreground="{StaticResource PrimaryColor}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Top Products -->
                            <Border Grid.Column="2" Grid.Row="0" Background="#0891B2" CornerRadius="6" 
                                    Padding="20" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="&#xf201;" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Artikujt më të shitur" FontSize="14" Foreground="White" 
                                               HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                    <TextBlock x:Name="TopProductCountText" Text="0 artikuj" FontSize="20" FontWeight="SemiBold" 
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Button Content="&#x1F4CA; Shiko listën" Style="{StaticResource ModernButton}"
                                            Click="TopProducts_Click" Margin="0,10,0,0"
                                            Background="White" Foreground="{StaticResource AccentColor}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Low Stock -->
                            <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" 
                                    Background="#F44336" CornerRadius="6" Padding="20" Margin="0,0,0,0">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Text="?" FontSize="20" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Artikujt me stok të ulët" FontSize="16" 
                                                           FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock x:Name="LowStockCountText" Text="0 artikuj kanë stok të ulët" 
                                                           FontSize="14" Foreground="White" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Content="&#x1F4CB; Shiko listën" Style="{StaticResource ModernButton}"
                                                Click="LowStockReport_Click" HorizontalAlignment="Right"
                                                Background="White" Foreground="{StaticResource DangerColor}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Receipt Type Filter -->
            <Border Grid.Row="0" Background="#F3F4F6" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F516; Filtrimi sipas llojit të faturës:" VerticalAlignment="Center" 
                               FontWeight="SemiBold" FontSize="14" Margin="0,0,15,0"/>
                    <RadioButton x:Name="AllReceiptsRadio" Content="Të gjitha" IsChecked="True"
                                 VerticalAlignment="Center" FontSize="14" Margin="0,0,20,0"/>
                    <RadioButton x:Name="FiscalOnlyRadio" Content="Vetëm fiskale" 
                                 VerticalAlignment="Center" FontSize="14" Margin="0,0,20,0"/>
                    <RadioButton x:Name="NonFiscalOnlyRadio" Content="Vetëm jofiskale"
                                 VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock Text="(Zbatohet për raportet e shtyppura)" VerticalAlignment="Center"
                               FontSize="14" FontStyle="Italic" Foreground="Gray" Margin="30,0,0,0"/>
                </StackPanel>
            </Border>
            
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="&#x1F5A8; Printo raportin ditor" Style="{StaticResource ModernButton}"
                            Click="PrintDailySalesReport_Click" Width="200" Margin="0,0,10,0"
                            Background="{StaticResource PrimaryColor}"/>
                    <Button Content="&#x1F5A8; Printo raportin mujor" Style="{StaticResource ModernButton}"
                            Click="PrintMonthlySalesReport_Click" Width="200"
                            Background="{StaticResource PrimaryColor}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
