<Window x:Class="KosovaPOS.Windows.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shitjet - Sales Reports" Height="850" Width="1400"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="&#x1F4CA; Raportet e shitjeve" FontSize="20" FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryColor}"/>
                    <TextBlock Text="&#x1F441; Shiko dhe analizon të gjitha shitjet" FontSize="14" 
                               Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#x1F6AA; Mbyll" Style="{StaticResource ModernButton}"
                        Click="Close_Click" Width="120" VerticalAlignment="Center"
                        Background="#475569"/>
            </Grid>
        </Border>
        
        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Nga data:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker Grid.Column="1" x:Name="FromDatePicker" Margin="0,0,20,0" 
                                FontSize="14" Height="36"/>
                    
                    <TextBlock Grid.Column="2" Text="Deri në:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker Grid.Column="3" x:Name="ToDatePicker" Margin="0,0,20,0"
                                FontSize="14" Height="36"/>
                    
                    <Button Grid.Column="4" Content="&#x1F50D; Filtro" Style="{StaticResource ModernButton}"
                            Click="FilterButton_Click" Width="120"/>
                </Grid>
                
                <!-- Search Row -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F50E; Kërko:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" x:Name="SearchTextBox" Style="{StaticResource ModernTextBox}" Height="36" FontSize="14"
                             VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"
                             ToolTip="Kërko sipas numrit të faturës ose kasijerit"/>
                    <TextBlock Grid.Column="2" Text="&#x1F4CB; Lloji:" VerticalAlignment="Center" Margin="20,0,10,0" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="3" x:Name="SaleTypeFilter" Width="150" Height="36" 
                              SelectionChanged="SaleTypeFilter_SelectionChanged">
                        <ComboBoxItem Content="Të gjitha" IsSelected="True"/>
                        <ComboBoxItem Content="&#x1F9FE; Fiskale"/>
                        <ComboBoxItem Content="&#x1F4C4; Jo-Fiskale"/>
                    </ComboBox>
                    <TextBlock Grid.Column="4" x:Name="ResultCountText" VerticalAlignment="Center" 
                               Margin="15,0,0,0" FontStyle="Italic" Foreground="Gray"/>
                </Grid>
            </Grid>
        </Border>
        
        <!-- Sales Grid -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Summary Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Total Sales -->
                    <Border Grid.Column="0" Background="#059669" CornerRadius="6" Padding="16,14" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="&#x1F4B0; Shitjet totale" FontSize="14" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TotalSalesText" Text="0.00 €" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- VAT Amount -->
                    <Border Grid.Column="1" Background="#0284C7" CornerRadius="6" Padding="16,14" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="&#x1F4C4; TVSH totale" FontSize="14" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TotalVATText" Text="0.00 €" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Number of Receipts -->
                    <Border Grid.Column="2" Background="#D97706" CornerRadius="6" Padding="16,14" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="&#x1F9FE; Numri i faturave" FontSize="14" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TotalReceiptsText" Text="0" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Average Sale -->
                    <Border Grid.Column="3" Background="#1E3A5F" CornerRadius="6" Padding="16,14">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="&#x1F4CA; Mesatarja e shitjes" FontSize="14" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="AverageSaleText" Text="0.00 €" FontSize="20" FontWeight="SemiBold" 
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Sales DataGrid -->
                <DataGrid Grid.Row="1" x:Name="SalesDataGrid" 
                          Style="{StaticResource POSDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="SalesDataGrid_SelectionChanged"
                          MouseDoubleClick="SalesDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nr. Faturës" Binding="{Binding ReceiptNumber}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Klienti" Binding="{Binding CustomerName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Totali (&#xf53d;)" Binding="{Binding TotalAmount, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="TVSH %" Binding="{Binding VATAmount, StringFormat=N2}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Lloji" Binding="{Binding FiscalStatus, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mënyra e pagesës" Binding="{Binding PaymentMethod}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Arkëtari" Binding="{Binding Cashier}" Width="100" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Receipt Items -->
                <Expander Grid.Row="2" Header="Artikujt e faturës së zgjedhur" Margin="0,10,0,0" IsExpanded="True">
                    <DataGrid x:Name="ReceiptItemsDataGrid" 
                              Style="{StaticResource POSDataGrid}"
                              AutoGenerateColumns="False"
                              MaxHeight="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Barkodi" Binding="{Binding Barcode}" Width="120"/>
                            <DataGridTextColumn Header="Emri i artikullit" Binding="{Binding ArticleName}" Width="*"/>
                            <DataGridTextColumn Header="Sasia" Binding="{Binding Quantity, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="Çmimi (&#xf02b;)" Binding="{Binding Price, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="Zbritja %" Binding="{Binding DiscountPercent, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="TVSH %" Binding="{Binding VATRate, StringFormat=N0}" Width="80"/>
                            <DataGridTextColumn Header="Totali (&#xf53d;)" Binding="{Binding TotalValue, StringFormat=N2}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </Grid>
        </Border>
        
        <!-- Footer Buttons -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="&#x1F441; Shiko faturën" Style="{StaticResource ModernButton}"
                    Click="ViewReceipt_Click" Width="150" Margin="0,0,10,0"/>

            <Button Grid.Column="2" Content="&#x1F4C4; Printo faturën" Style="{StaticResource ModernButton}"
                    Click="PrintReceipt_Click" Width="150" Margin="0,0,10,0"/>

            <Button Grid.Column="3" Content="&#x1F4CA; Eksporto në Excel" Style="{StaticResource ModernButton}"
                    Click="ExportToExcel_Click" Width="180" Margin="0,0,10,0"/>
        </Grid>
    </Grid>
</Window>
