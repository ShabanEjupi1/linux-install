<Window x:Class="KosovaPOS.Windows.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KosovaPOS - License Activation" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Icon="/Resources/KosovaPOS.ico">
    <Grid Background="#F8FAFC">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="550" Margin="20">
            <!-- Header -->
            <TextBlock Text="KosovaPOS - License Activation" FontSize="24" FontWeight="Bold" 
                       Foreground="#1E3A5F" TextAlignment="Center" Margin="0,0,0,30"/>
            
            <TextBlock Text="This application requires license activation." FontSize="14" 
                       Foreground="#6B7280" TextAlignment="Center" Margin="0,0,0,20"/>

            <!-- Machine ID Section -->
            <TextBlock Text="Your Machine ID:" FontSize="12" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,8"/>
            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="12" Background="#FFFFFF" Margin="0,0,0,16">
                <Grid>
                    <TextBlock x:Name="MachineIdTextBlock" Text="Loading..." FontFamily="Courier New" 
                               FontSize="11" Foreground="#1F2937" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="MachineIdCopyButton" Content="Copy" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#3A7CA5" Foreground="White" Padding="12,6" FontSize="12" 
                            Cursor="Hand" Template="{DynamicResource ButtonTemplate}"/>
                </Grid>
            </Border>

            <!-- Customer Name -->
            <TextBlock Text="Your Name:" FontSize="12" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,8"/>
            <TextBox x:Name="CustomerNameTextBox" Height="40" Padding="12" FontSize="12" 
                     BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20"
                     Background="#FFFFFF" Foreground="#1F2937"
                     Watermark="Enter your name"/>

            <!-- License Key -->
            <TextBlock Text="License Key:" FontSize="12" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,8"/>
            <TextBox x:Name="LicenseKeyTextBox" Height="40" Padding="12" FontSize="12" 
                     BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20"
                     Background="#FFFFFF" Foreground="#1F2937"
                     Watermark="Paste your license key here"/>

            <!-- Info Box -->
            <Border BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="12" Background="#FEF3C7" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ℹ️ How to get your license:" FontSize="11" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,8"/>
                    <TextBlock Text="1. Send your Machine ID to support@kosovaBusiness.com" FontSize="10" Foreground="#92400E" Margin="0,0,0,4"/>
                    <TextBlock Text="2. Receive your license key via email" FontSize="10" Foreground="#92400E" Margin="0,0,0,4"/>
                    <TextBlock Text="3. Paste the key above and click Activate" FontSize="10" Foreground="#92400E"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" x:Name="ActivateButton" Content="Activate License" Height="44"
                        Background="#2D6A4F" Foreground="White" FontSize="12" FontWeight="Bold"
                        Cursor="Hand" Click="ActivateButton_Click"/>
                
                <Button Grid.Column="2" x:Name="CloseButton" Content="Exit" Height="44"
                        Background="#6B7280" Foreground="White" FontSize="12" FontWeight="Bold"
                        Cursor="Hand" Click="CloseButton_Click"/>
            </Grid>

            <TextBlock Text="License expires yearly on the same date." FontSize="10" Foreground="#6B7280" 
                       TextAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
