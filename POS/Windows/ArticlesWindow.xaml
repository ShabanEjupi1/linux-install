<Window x:Class="KosovaPOS.Windows.ArticlesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Artikujt" Height="850" Width="1400"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="HeaderCountText" Text="&#x1F4E6; Artikujt" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryColor}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Gjithsej: " FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="TotalArticlesText" Text="0" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryColor}"/>
                        <TextBlock Text="  |  N&#x00EB; stok: " FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="InStockText" Text="0" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessColor}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CloseButton" Content="&#x1F6AA; Mbyll (Alt+M)"
                        Style="{StaticResource ModernButton}" Click="CloseButton_Click"
                        Width="150" VerticalAlignment="Center"
                        Background="{StaticResource DangerColor}"/>
            </Grid>
        </Border>

        <!-- Toolbar: Search, Filter, Print -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,10">
            <StackPanel>
                <!-- Search and filter row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F50D; K&#x00EB;rko:" VerticalAlignment="Center"
                               Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" x:Name="SearchTextBox" Height="36"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"
                             ToolTip="Ctrl+F &#x2013; k&#x00EB;rko sipas emrit, barkodit, kategori&#x00EB;s ose furnizuesit"/>
                    <Button Grid.Column="2" Content="&#x1F50D;" Width="40" Height="36" Margin="4,0,16,0"
                            Click="SearchButton_Click"/>
                    <TextBlock Grid.Column="3" Text="Kategoria:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="4" x:Name="CategoryFilterComboBox" Height="36" Margin="0,0,16,0"
                              SelectionChanged="CategoryFilterComboBox_SelectionChanged"/>
                    <TextBlock Grid.Column="5" x:Name="ResultCountText" VerticalAlignment="Center"
                               FontStyle="Italic" Foreground="Gray"/>
                    <Button Grid.Column="6" Content="&#x1F504; Rifresko" Style="{StaticResource ModernButton}"
                            Click="RefreshButton_Click" Width="115"/>
                </Grid>

                <!-- Print by category row -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F5A8; Printo sipas kategori&#x00EB;s:" VerticalAlignment="Center"
                               Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="1" x:Name="PrintCategoryComboBox" Height="36" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Printo kategori&#x00EB;n" Style="{StaticResource ModernButton}"
                            Click="PrintByCategoryButton_Click" Width="155" Margin="0,0,8,0" Background="#0284C7"/>
                    <Button Grid.Column="3" Content="Printo seleksionin" Style="{StaticResource ModernButton}"
                            Click="PrintSelectedButton_Click" Width="155" Background="#0369A1"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,0">
            <DataGrid x:Name="ArticlesDataGrid"
                      Style="{StaticResource POSDataGrid}"
                      AutoGenerateColumns="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      MouseDoubleClick="ArticlesDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                    <DataGridTextColumn Header="Barkodi" Binding="{Binding Barcode}" Width="130"/>
                    <DataGridTextColumn Header="Emri i Artikullit" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Nj&#x00EB;sia" Binding="{Binding Unit}" Width="75"/>
                    <DataGridTextColumn Header="Paketa" Binding="{Binding Pack}" Width="75"/>
                    <DataGridTextColumn Header="&#x00C7;mimi (&#x20AC;)" Binding="{Binding SalesPrice, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Stoku" Binding="{Binding StockQuantity, StringFormat=N0}" Width="85"/>
                    <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}" Width="130"/>
                    <DataGridTextColumn Header="Furnizuesi" Binding="{Binding Supplier}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer: Action Buttons -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <!-- CRUD Buttons (left) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="&#x2795; Shto (Alt+O)" Style="{StaticResource ModernButton}"
                            Click="AddButton_Click" Width="135" Margin="0,0,6,0"
                            Background="{StaticResource SuccessColor}"/>
                    <Button Content="&#x270F; Ndrysho (Alt+N)" Style="{StaticResource ModernButton}"
                            Click="EditButton_Click" Width="155" Margin="0,0,6,0"/>
                    <Button Content="&#x1F5D1; Fshi (Alt+F)" Style="{StaticResource ModernButton}"
                            Click="DeleteButton_Click" Width="120" Margin="0,0,6,0"
                            Background="#DC2626"/>
                    <Button Content="&#x1F4E6; Stoqet" Style="{StaticResource ModernButton}"
                            Click="ViewStockButton_Click" Width="105"
                            Background="{StaticResource AccentColor}"/>
                </StackPanel>

                <!-- Barcode Printing (center-left) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Kopje:" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                    <Button Content="&#x25B2;" Width="28" Height="36" Click="IncreaseCopiesButton_Click"
                            Background="#64748B" Margin="0,0,2,0"/>
                    <TextBox x:Name="BarcodeCopiesTextBox" Text="1" Width="52" Height="36"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             FontSize="15" FontWeight="Bold"
                             PreviewTextInput="BarcodeCopiesTextBox_PreviewTextInput"
                             KeyDown="BarcodeCopiesTextBox_KeyDown"/>
                    <Button Content="&#x25BC;" Width="28" Height="36" Click="DecreaseCopiesButton_Click"
                            Background="#64748B" Margin="2,0,6,0"/>
                    <Button x:Name="BarcodeButton" Content="Alt+B - Printo barkod"
                            Style="{StaticResource ModernButton}" Click="BarcodeButton_Click"
                            Width="175" Background="#7C3AED"/>
                </StackPanel>

                <!-- Export / Sync (right) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="WebPushButton" Content="&#x1F4E4; D&#x00EB;rgo Web"
                            Style="{StaticResource ModernButton}" Click="WebPushButton_Click"
                            Width="120" Margin="0,0,6,0" Background="#6366F1"/>
                    <Button x:Name="WebSyncButton" Content="&#x1F310; Sinkronizo Web"
                            Style="{StaticResource ModernButton}" Click="WebSyncButton_Click"
                            Width="155" Margin="0,0,6,0" Background="#0891B2"/>
                    <Button Content="&#x1F4CA; Excel (Alt+E)" Style="{StaticResource ModernButton}"
                            Click="ExcelButton_Click" Width="125" Margin="0,0,6,0" Background="#059669"/>
                    <Button Content="&#x1F5A8; Lista" Style="{StaticResource ModernButton}"
                            Click="PrintListButton_Click" Width="90" Background="#0284C7"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>