<Window x:Class="KosovaPOS.Windows.QuickPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sa para dha klienti?" 
        Height="428" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        ShowInTaskbar="False">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Total Amount Display -->
        <Border Grid.Row="0" Background="#2196F3" Padding="10" CornerRadius="6" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="TOTALI" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TotalAmountText" 
                           Text="0.00 €" 
                           FontSize="20" 
                           FontWeight="SemiBold" 
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Cash Received Input -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Sa para dha klienti?" 
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,5"/>
            <TextBox x:Name="CashReceivedTextBox" 
                     Style="{StaticResource ModernTextBox}"
                     Height="36" 
                     FontSize="14" 
                     TextAlignment="Center"
                     VerticalContentAlignment="Center"
                     Background="White"
                     BorderBrush="#4CAF50"
                     BorderThickness="2"
                     PreviewKeyDown="CashReceivedTextBox_KeyDown"/>
        </StackPanel>
        
        <!-- Change Amount Display - Prominent section -->
        <Border Grid.Row="2" x:Name="ChangeBorder" Background="#FFEB3B" Padding="15" CornerRadius="6" Margin="0,5,0,15">
            <StackPanel>
                <TextBlock Text="&#x1F4B0; KUSURI - KTHEJE KLIENTIT:" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                <TextBlock x:Name="ChangeAmountText" 
                           Text="0.00 €" 
                           FontSize="20" 
                           FontWeight="SemiBold" 
                           Foreground="#15803D"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ChangeMessageText" 
                           Text="Arkëtari duhet t'i kthejë klientit këtë shumë" 
                           FontSize="14" 
                           FontStyle="Italic"
                           Foreground="#666"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        
        <!-- Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="OkButton" 
                    Grid.Column="0"
                    Content="&#x2714; OK (PRINTO)" 
                    Height="44"
                    Margin="0,0,5,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Ok_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#4CAF50"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button x:Name="CancelButton" 
                    Grid.Column="1"
                    Content="✗ ANULO" 
                    Height="44"
                    Margin="5,0,0,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#F44336"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Cancel_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#F44336"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DA190B"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
