<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["KosovaPOS.Web.styles.css"]" />

    @* Installable as a desktop app (Edge/Chrome "Install KosovaPOS") so the till
       runs in its own window instead of a browser tab. *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#1e293b" />
    <meta name="application-name" content="KosovaPOS" />

    @* Pages carry their own <PageTitle>, but they no longer prerender — so until the circuit is
       up there is no title at all and the tab reads as the URL. HeadOutlet overwrites this the
       moment the page renders; it only ever shows during the shell. *@
    <title>KosovaPOS</title>

    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/download.js"]"></script>
    @* Acknowledges the click, shows the wait, fades the page in. Loaded after blazor.web.js so
       Blazor.addEventListener('enhancedload') is there to hook. *@
    <script src="@Assets["js/nav.js"]"></script>
    <script>
        // Registering a fetch-handling service worker is what makes the browser
        // offer "Install". It caches nothing — see service-worker.js.
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => navigator.serviceWorker.register('/service-worker.js'));
        }
    </script>
</body>

</html>
