@inherits LayoutComponentBase
@using System.Security.Claims
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject BusinessProfileService Profile
@inject CurrentBusiness CurrentBiz
@inject NavigationManager Nav

@* The layout renders in static SSR even when the page inside it is
   InteractiveServer, so the sidebar cannot use @onclick. The mobile drawer is
   therefore a pure-CSS checkbox toggle, and it resets on every navigation —
   which is the behaviour we want anyway. *@

<div class="shell">
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-scrim"></label>

    <aside class="sidenav">
        <a href="/" class="brand">
            <span class="brand-mark">K</span>
            <span class="brand-text">
                <strong>@BusinessName</strong>
                <small>@ProfileLabel</small>
            </span>
        </a>

        <nav class="nav-scroll">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="nav-ico">🏠</span> Ballina
            </NavLink>

            @if (_canSell)
            {
                <p class="nav-group">Shitja</p>
                <NavLink class="nav-link" href="/sale"><span class="nav-ico">🛒</span> Shitje</NavLink>
                <NavLink class="nav-link" href="/faturat"><span class="nav-ico">🧾</span> Faturat</NavLink>
                <NavLink class="nav-link" href="/kthimet"><span class="nav-ico">↩️</span> Kthimet</NavLink>
                <NavLink class="nav-link" href="/porosite"><span class="nav-ico">🌐</span> Porositë online</NavLink>
            }

            @if (_canArticles || _canStock || _canPurchases)
            {
                <p class="nav-group">Stoku</p>
                @if (_canArticles)
                {
                    <NavLink class="nav-link" href="/articles"><span class="nav-ico">📦</span> Artikujt</NavLink>
                    <NavLink class="nav-link" href="/foto"><span class="nav-ico">📷</span> Fotot</NavLink>
                }
                @if (_canStock)
                {
                    <NavLink class="nav-link" href="/stoku"><span class="nav-ico">📊</span> Gjendja</NavLink>
                    <NavLink class="nav-link" href="/inventari"><span class="nav-ico">🗃️</span> Inventari</NavLink>
                    <NavLink class="nav-link" href="/barkod"><span class="nav-ico">🏷️</span> Barkodi</NavLink>
                }
                @if (_canPurchases)
                {
                    <NavLink class="nav-link" href="/blerjet"><span class="nav-ico">📥</span> Blerjet</NavLink>
                }
            }

            @if (_canSell || _canFinance || _canReports)
            {
                <p class="nav-group">Financa</p>
                @if (_canSell)
                {
                    <NavLink class="nav-link" href="/arka"><span class="nav-ico">💵</span> Arka</NavLink>
                }
                @if (_canFinance)
                {
                    <NavLink class="nav-link" href="/financat"><span class="nav-ico">💰</span> Financat</NavLink>
                }
                @if (_canReports)
                {
                    <NavLink class="nav-link" href="/raportet"><span class="nav-ico">📈</span> Raportet</NavLink>
                    <NavLink class="nav-link" href="/librat"><span class="nav-ico">📚</span> Librat e TVSH-së</NavLink>
                }
            }

            @* Every link under Sistemi is permission-gated, so the heading has to
               go too — a Cashier would otherwise see an empty section. *@
            @if (_canPartners || _canManageUsers || _canSettings || _canAudit)
            {
                <p class="nav-group">Sistemi</p>
                @if (_canPartners)
                {
                    <NavLink class="nav-link" href="/partneret"><span class="nav-ico">🤝</span> Partnerët</NavLink>
                }
                @if (_canManageUsers)
                {
                    <NavLink class="nav-link" href="/perdoruesit"><span class="nav-ico">👥</span> Përdoruesit</NavLink>
                }
                @if (_canAudit)
                {
                    <NavLink class="nav-link" href="/auditimi"><span class="nav-ico">🔎</span> Auditimi</NavLink>
                }
                @if (_canSettings)
                {
                    <NavLink class="nav-link" href="/cilesimet"><span class="nav-ico">⚙️</span> Cilësimet</NavLink>
                    <NavLink class="nav-link" href="/pajisjet"><span class="nav-ico">🖨️</span> Pajisjet</NavLink>
                }
            }

            @if (_isPlatformAdmin)
            {
                <p class="nav-group">Platforma</p>
                <NavLink class="nav-link" href="/admin/bizneset"><span class="nav-ico">🏢</span> Bizneset</NavLink>
                <NavLink class="nav-link" href="/admin/auditimi"><span class="nav-ico">🔎</span> Auditimi</NavLink>
            }
        </nav>
    </aside>

    <div class="shell-main">
        @if (_impersonator is not null)
        {
            <div class="impersonation-bar" role="status">
                <span>
                    👁️ Po veproni si <strong>@_fullName</strong> në <strong>@BusinessName</strong>.
                    Operatori: <strong>@_impersonator</strong>.
                </span>
                <form method="post" action="/admin/impersonate/exit">
                    <AntiforgeryToken />
                    <button type="submit" class="btn-ghost">Kthehu te platforma</button>
                </form>
            </div>
        }
        <header class="appbar">
            <label for="nav-toggle" class="nav-burger" aria-label="Menyja">☰</label>
            <h2 class="appbar-title">@BusinessName</h2>
            <span class="spacer"></span>
            <div class="user">
                <span class="user-name">@_fullName</span>
                <span class="user-role">@_role</span>
            </div>
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit" class="btn-ghost">Dil</button>
            </form>
        </header>

        @* The pages render with prerender:false, so this slot holds nothing at all until the
           circuit connects — see RenderModes. The layout is server-rendered and arrives with the
           first byte, so it is the only thing that CAN fill that gap.

           It is an overlay, and it is never taken out of the DOM — js/nav.js only hides it. Both
           of those are forced by Blazor's enhanced navigation: it will not insert a new element
           into a slot an interactive component owns (a skeleton removed after the first page
           would never come back on the second), and the outgoing page's DOM belongs to its
           circuit, so covering it is safe where replacing it is not.

           Both shapes are rendered and CSS shows one, because the shape has to change at the
           instant of the CLICK — the server does not know where we are going until it is asked,
           and by then the wait it was meant to fill has already started. *@
        <div class="shell-content">
            <div class="shell-skeleton @(IsTillRoute ? "as-till" : "as-page")" aria-hidden="true">
                <div class="sk-shape sk-shape-till">
                    <div class="sale">
                        <section class="catalogue">
                            <div class="sk sk-search"></div>
                            <div class="grid">
                                @for (var i = 0; i < 12; i++)
                                {
                                    <div class="sk sk-prod"></div>
                                }
                            </div>
                        </section>
                        <section class="sk sk-cart"></section>
                    </div>
                </div>
                <div class="sk-shape sk-shape-page">
                    <div class="mgmt">
                        <Skeleton Tiles="3" Rows="7" />
                    </div>
                </div>

                @* A skeleton still shimmering after fifteen seconds is not a wait, it is a hang.
                   Shown by js/nav.js in place of the shape when the circuit never comes up. *@
                <div class="sk-stuck">
                    <p>Serveri po vonohet me përgjigje.</p>
                    <button type="button" class="btn-primary sk-retry">Provo përsëri</button>
                </div>
            </div>
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private BusinessSettings? _settings;
    private bool _canManageUsers;
    private bool _canReports;
    private bool _canFinance;
    private bool _canPurchases;
    private bool _canPartners;
    private bool _canArticles;
    private bool _canSell;
    private bool _canStock;
    private bool _canSettings;
    private bool _canAudit;
    private bool _isPlatformAdmin;
    private string? _impersonator;
    private string _fullName = "";
    private string _role = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _fullName = user.FindFirst(AuthService.FullNameClaim)?.Value
                        ?? user.Identity?.Name ?? "";
            _role = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
            _isPlatformAdmin = user.HasClaim(AuthService.PlatformAdminClaim, "true");
            _impersonator = user.FindFirst(AuthService.ImpersonatorClaim)?.Value is { Length: > 0 } imp ? imp : null;

            bool Can(string perm) => user.HasClaim(AuthService.PermissionClaim, perm);
            _canManageUsers = Can("users");
            _canReports     = Can("reports");
            _canFinance     = Can("finance");
            _canPurchases   = Can("purchases");
            _canPartners    = Can("partners");
            _canArticles    = Can("articles");
            _canSell        = Can("sell");
            _canStock       = Can("stock");
            _canSettings    = Can("settings");
            _canAudit       = Can("audit");
        }

        // A platform admin has no business, so there is no database to read settings
        // from. Asking anyway would throw NoBusinessInScopeException and take down
        // the shell they navigate the admin console with.
        if (await CurrentBiz.GetAsync() is not null)
            _settings = await Profile.GetSettingsAsync();
    }

    /// <summary>
    /// The till is the one screen whose shape is nothing like the others — a product grid beside
    /// a cart, not a table under some tiles. Standing a list-shaped skeleton in front of it would
    /// move everything the instant the real page landed, which is the exact fault skeletons exist
    /// to avoid.
    /// </summary>
    private bool IsTillRoute =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').Split('?')[0]
           .StartsWith("sale", StringComparison.OrdinalIgnoreCase);

    private string BusinessName => string.IsNullOrWhiteSpace(_settings?.BusinessName)
        ? (_isPlatformAdmin ? "Platforma" : "KosovaPOS")
        : _settings!.BusinessName;

    private string ProfileLabel => _settings?.Profile switch
    {
        BusinessProfile.FoodAndBeverage => "Restorant",
        BusinessProfile.Hospitality => "Hoteleri",
        BusinessProfile.Wholesale => "Shumicë",
        BusinessProfile.Pharmacy => "Farmaci",
        BusinessProfile.Rental => "Qira",
        BusinessProfile.Services => "Shërbime",
        _ => "Dyqan (Retail)"
    };
}
