@page "/faturat"
@attribute [Authorize(Policy = "perm:sell")]
@rendermode InteractiveServer
@using KosovaPOS.Core.Services
@using KosovaPOS.Web.Services
@inject SalesService Sales
@inject HardwareBridge Hw

<PageTitle>Faturat — KosovaPOS</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Faturat e fundit</h1>
            <span class="muted">@_sales.Count fatura</span>
        </div>
        <button class="btn-ghost" @onclick="Reload">↻ Rifresko</button>
    </header>

    <div class="table-wrap">
        @if (_loading)
        {
            <p class="muted">Duke ngarkuar…</p>
        }
        else
        {
            <table class="grid-table">
                <thead>
                    <tr>
                        <th>Nr.</th>
                        <th>Data</th>
                        <th>Ora</th>
                        <th>Arkëtari</th>
                        <th>Pagesa</th>
                        <th class="num">Artikuj</th>
                        <th class="num">Totali</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _sales)
                    {
                        <tr class="clickable" @onclick="() => Open(s.ReceiptNumber)">
                            <td class="mono">#@s.ReceiptNumber</td>
                            <td>@s.Date.ToString("dd.MM.yyyy")</td>
                            <td>@s.Time</td>
                            <td>@s.Cashier</td>
                            <td>@s.PaymentMethod</td>
                            <td class="num">@s.ItemCount</td>
                            <td class="num strong">@s.TotalAmount.ToString("0.00") €</td>
                            <td class="actions">
                                <button class="btn-mini" title="Shiko">👁️</button>
                                <button class="btn-mini" title="Printo kuponin 80mm" disabled="@_printing"
                                        @onclick="() => Print(s.ReceiptNumber, Doc.Receipt80)"
                                        @onclick:stopPropagation="true">🧾 Kupon</button>
                                <button class="btn-mini" title="Printo faturën A4" disabled="@_printing"
                                        @onclick="() => Print(s.ReceiptNumber, Doc.InvoiceA4)"
                                        @onclick:stopPropagation="true">📄 A4</button>
                                <button class="btn-mini" title="Printo fletëdërgesën A4" disabled="@_printing"
                                        @onclick="() => Print(s.ReceiptNumber, Doc.WaybillA4)"
                                        @onclick:stopPropagation="true">🚚 Fletëdërgesë</button>
                            </td>
                        </tr>
                    }
                    @if (!_sales.Any())
                    {
                        <tr><td colspan="8" class="muted center">Asnjë faturë ende.</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (_detailNumber is not null)
{
    <div class="modal-backdrop" @onclick="() => _detailNumber = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>Fatura #@_detailNumber</h2>
            @if (_detailLoading)
            {
                <p class="muted">Duke ngarkuar…</p>
            }
            else
            {
                <table class="grid-table">
                    <thead>
                        <tr>
                            <th>Artikulli</th>
                            <th class="num">Sasia</th>
                            <th class="num">Çmimi</th>
                            <th class="num">Totali</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _detail)
                        {
                            <tr>
                                <td>@l.Name</td>
                                <td class="num">@l.Quantity.ToString("0.##")</td>
                                <td class="num">@l.Price.ToString("0.00") €</td>
                                <td class="num">@l.Total.ToString("0.00") €</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="num strong">TVSH</td>
                            <td class="num strong">@_detail.Sum(l => l.VATValue).ToString("0.00") €</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="num strong">TOTALI</td>
                            <td class="num strong">@_detail.Sum(l => l.Total).ToString("0.00") €</td>
                        </tr>
                    </tfoot>
                </table>
            }
            @if (_printError is not null)
            {
                <div class="sale-msg err">@_printError</div>
            }
            <div class="modal-actions">
                <button class="btn-ghost" disabled="@_printing"
                        @onclick="() => Print(_detailNumber!.Value.ToString(), Doc.Receipt80)">🧾 Kuponi 80mm</button>
                <button class="btn-ghost" disabled="@_printing"
                        @onclick="() => Print(_detailNumber!.Value.ToString(), Doc.WaybillA4)">🚚 Fletëdërgesë A4</button>
                <button class="btn-primary" disabled="@_printing"
                        @onclick="() => Print(_detailNumber!.Value.ToString(), Doc.InvoiceA4)">📄 Printo faturën A4</button>
                <button class="btn-ghost" @onclick="() => _detailNumber = null">Mbyll</button>
            </div>
        </div>
    </div>
}

@code {
    private List<SalesSummary> _sales = new();
    private bool _loading = true;

    private long? _detailNumber;
    private List<ReceiptLine> _detail = new();
    private bool _detailLoading;
    private bool _printing;
    private string? _printError;

    /// <summary>Which paper a past sale is being asked for.</summary>
    private enum Doc { Receipt80, InvoiceA4, WaybillA4 }

    /// <summary>
    /// Reprints a past sale without leaving the list. The 80mm receipt goes to the thermal
    /// printer as raw ESC/POS when the agent is installed; the A4 invoice and the A4 waybill are
    /// drawn by the browser in a hidden frame. None of them opens a tab — the shop searching for
    /// a receipt from last Tuesday should still be looking at that search when the paper comes out.
    /// </summary>
    private async Task Print(string receiptNumber, Doc doc)
    {
        if (!long.TryParse(receiptNumber, out var numri)) return;
        _printing = true;
        _printError = null;
        try
        {
            var r = doc switch
            {
                Doc.InvoiceA4 => await Hw.PrintUrlAsync($"/fatura/{numri}"),
                Doc.WaybillA4 => await Hw.PrintUrlAsync($"/fletedergese/{numri}"),
                _ => await Hw.PrintReceiptAnyWayAsync(numri),
            };

            if (!r.Ok) _printError = $"Printimi dështoi: {r.Error}";
        }
        finally { _printing = false; }
    }

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _loading = true;
        _sales = await Sales.GetRecentSalesAsync(100);
        _loading = false;
    }

    private async Task Open(string receiptNumber)
    {
        if (!long.TryParse(receiptNumber, out var numri)) return;
        _detailNumber = numri;
        _detailLoading = true;
        _detail = await Sales.GetReceiptDetailAsync(numri);
        _detailLoading = false;
    }
}
