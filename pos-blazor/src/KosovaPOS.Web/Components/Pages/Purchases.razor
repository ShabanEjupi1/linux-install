@page "/blerjet"
@attribute [Authorize(Policy = "perm:purchases")]
@rendermode InteractiveServer
@using System.Security.Claims
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject CatalogService Catalog
@inject PurchaseService PurchaseSvc
@inject Audit Audit

<PageTitle>Blerjet — KosovaPOS</PageTitle>

@if (_view == View.Entry)
{
    <div class="sale">
        <!-- Left: catalogue to pick articles from -->
        <section class="catalogue">
            <div class="search-row">
                <input @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKey"
                       placeholder="Kërko emër ose skano barkod…" class="search-box" autofocus />
                @if (_editingNumri is not null)
                {
                    <span class="edit-badge">✏️ Duke ndryshuar blerjen #@_editingNumri</span>
                }
                <button class="btn-ghost" @onclick="ShowRecent">← Blerjet</button>
            </div>
            <div class="grid">
                @if (_loading)
                {
                    <p class="muted">Duke ngarkuar…</p>
                }
                else
                {
                    @foreach (var a in FilteredArticles)
                    {
                        <button class="prod" @onclick="() => AddLine(a)">
                            <span class="prod-name">@a.Name</span>
                            <span class="prod-price">@a.PurchasePrice.ToString("0.00") €</span>
                            <span class="prod-stock">stok @a.StockQuantity.ToString("0.##")</span>
                        </button>
                    }
                    @if (!FilteredArticles.Any())
                    {
                        <p class="muted">Asnjë artikull.</p>
                    }
                }
            </div>
        </section>

        <!-- Right: purchase document -->
        <section class="cart">
            <h2>Blerje e re #@_docNumber</h2>
            <div class="pur-head">
                <div class="field">
                    <label>Furnizuesi</label>
                    <select class="input" @bind="_supplierId">
                        <option value="0">— pa furnizues —</option>
                        @foreach (var s in _suppliers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Nr. faturës</label>
                    <input class="input" @bind="_invoiceNumber" />
                </div>
                <div class="field">
                    <label>Lloji</label>
                    <select class="input" @bind="_purchaseType">
                        <option value="Vendore">Vendore</option>
                        <option value="Import">Import</option>
                        <option value="Shpenzime">Shpenzime</option>
                    </select>
                </div>
                <label class="chk"><input type="checkbox" @bind="_isPaid" /> E paguar</label>
            </div>

            <div class="cart-items pur-lines">
                @if (_lines.Count == 0)
                {
                    <p class="muted">Zgjidh artikuj nga e majta.</p>
                }
                else
                {
                    <table class="lines-table">
                        <thead>
                            <tr><th>Artikulli</th><th>Sasia</th><th>Furn.</th><th>Shitje</th><th>TVSH</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _lines)
                            {
                                <tr>
                                    <td class="ln-name">@l.ArticleName</td>
                                    <td><input type="number" step="0.001" class="ln-in" @bind="l.Quantity" /></td>
                                    <td><input type="number" step="0.01" class="ln-in" @bind="l.PurchasePrice" /></td>
                                    <td><input type="number" step="0.01" class="ln-in" @bind="l.SalesPrice" /></td>
                                    <td>
                                        <select class="ln-in" @bind="l.VATRate">
                                            <option value="18">18</option>
                                            <option value="8">8</option>
                                            <option value="0">0</option>
                                        </select>
                                    </td>
                                    <td><button class="cl-del" @onclick="() => _lines.Remove(l)">×</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="totals">
                <div class="t-row"><span>Nën-total</span><span>@Subtotal.ToString("0.00") €</span></div>
                <div class="t-row"><span>TVSH</span><span>@VatTotal.ToString("0.00") €</span></div>
                <div class="t-row grand"><span>TOTALI</span><span>@Total.ToString("0.00") €</span></div>
            </div>

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="sale-msg @(_success ? "ok" : "err")">@_message</div>
            }

            <button class="complete" disabled="@(_lines.Count == 0 || _busy)" @onclick="Save">
                @(_busy ? "Duke ruajtur…" : "RUAJ BLERJEN")
            </button>
        </section>
    </div>
}
else
{
    <div class="mgmt">
        <header class="mgmt-head">
            <div>
                <h1>Blerjet</h1>
                <span class="muted">
                    @if (FilteredRecent.Count() == _recent.Count)
                    {
                        @($"{_recent.Count} blerje")
                    }
                    else
                    {
                        @($"{FilteredRecent.Count()} nga {_recent.Count} blerje")
                    }
                </span>
            </div>
            <button class="btn-primary" @onclick="ShowEntry">+ Blerje e re</button>
        </header>

        <div class="search-row">
            <input @bind="_recentSearch" @bind:event="oninput" @bind:after="() => _shown = PageSize"
                   placeholder="Kërko nr. dokumenti, nr. fature, lloj ose datë…" class="search-box" />
        </div>

        <div class="table-wrap">
            @if (_recentLoading)
            {
                <p class="muted">Duke ngarkuar…</p>
            }
            else
            {
                <table class="grid-table">
                    <thead>
                        <tr>
                            <th>Nr.</th><th>Fatura</th><th>Data</th><th>Ora</th>
                            <th>Lloji</th><th class="num">Artikuj</th><th class="num">Totali</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ShownRecent)
                        {
                            <tr class="clickable" @onclick="() => OpenDetail(p.DocumentNumber)">
                                <td class="mono">#@p.DocumentNumber</td>
                                <td>@p.InvoiceNumber</td>
                                <td>@p.Date.ToString("dd.MM.yyyy")</td>
                                <td>@p.Time</td>
                                <td>@p.PurchaseType</td>
                                <td class="num">@p.ItemCount</td>
                                <td class="num strong">@p.TotalAmount.ToString("0.00") €</td>
                                <td class="actions" @onclick:stopPropagation="true">
                                    <button class="btn-mini" title="Shiko" @onclick="() => OpenDetail(p.DocumentNumber)">👁️</button>
                                    <button class="btn-mini" title="Ndrysho" @onclick="() => EditPurchase(p.DocumentNumber)">✏️</button>
                                    <button class="btn-mini danger" title="Fshi"
                                            @onclick="() => _deleteNumber = long.Parse(p.DocumentNumber)">🗑️</button>
                                </td>
                            </tr>
                        }
                        @if (!FilteredRecent.Any())
                        {
                            <tr><td colspan="8" class="muted center">
                                @(_recent.Count == 0 ? "Asnjë blerje ende." : "Asnjë blerje nuk përputhet me kërkimin.")
                            </td></tr>
                        }
                    </tbody>
                </table>

                @if (FilteredRecent.Count() > _shown)
                {
                    <div class="more-row">
                        <span class="muted">Po shfaqen @_shown nga @FilteredRecent.Count() blerje.</span>
                        <button class="btn-ghost" @onclick="() => _shown += PageSize">Shfaq më shumë</button>
                    </div>
                }
            }
        </div>
    </div>
}

@if (_detailNumber is not null)
{
    <div class="modal-backdrop" @onclick="() => _detailNumber = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>Blerja #@_detailNumber</h2>
            @if (_detailLoading)
            {
                <p class="muted">Duke ngarkuar…</p>
            }
            else
            {
                <table class="grid-table">
                    <thead>
                        <tr><th>Artikulli</th><th class="num">Sasia</th><th class="num">Çmimi furn.</th><th class="num">Totali</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _detail)
                        {
                            <tr>
                                <td>@l.Name</td>
                                <td class="num">@l.Quantity.ToString("0.##")</td>
                                <td class="num">@l.PurchasePrice.ToString("0.00") €</td>
                                <td class="num">@l.Total.ToString("0.00") €</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><td colspan="3" class="num strong">TOTALI</td><td class="num strong">@_detail.Sum(l => l.Total).ToString("0.00") €</td></tr>
                    </tfoot>
                </table>
            }
            <div class="modal-actions">
                <button class="btn-primary" @onclick="() => EditPurchase(_detailNumber!.Value.ToString())">✏️ Ndrysho</button>
                <button class="btn-ghost" @onclick="() => _detailNumber = null">Mbyll</button>
            </div>
        </div>
    </div>
}

@if (_deleteNumber is not null)
{
    <div class="modal-backdrop" @onclick="() => _deleteNumber = null">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>Fshi blerjen #@_deleteNumber?</h2>
            <p class="muted">
                Rreshtat e blerjes fshihen dhe <strong>stoku që kjo blerje shtoi do të zbritet</strong>.
                Nëse artikujt janë shitur ndërkohë, stoku mund të dalë negativ — kjo është e vërteta e
                gjendjes, jo gabim. Veprimi nuk kthehet mbrapa.
            </p>
            <div class="modal-actions">
                <button class="btn-danger" @onclick="ConfirmDelete" disabled="@_busy">
                    @(_busy ? "Duke fshirë…" : "Fshi")
                </button>
                <button class="btn-ghost" @onclick="() => _deleteNumber = null">Anulo</button>
            </div>
        </div>
    </div>
}

@code {
    private enum View { Entry, Recent }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // The tab opens on the LIST, like /faturat. Opening on the empty entry form made
    // 361 existing purchase documents look like they didn't exist.
    private View _view = View.Recent;

    /// <summary>Set while the entry form is editing an existing document rather than creating one.</summary>
    private long? _editingNumri;

    // Entry state
    private List<Article> _articles = new();
    private List<Supplier> _suppliers = new();
    private readonly List<PurchaseDraftItem> _lines = new();
    private string _search = "";
    private string _docNumber = "";
    private string _invoiceNumber = "";
    private string _purchaseType = "Vendore";
    private int _supplierId;
    private bool _isPaid;
    private bool _loading = true, _busy, _success;
    private string? _message;
    private string _worker = "";

    // Recent state
    private List<PurchaseSummary> _recent = new();
    private bool _recentLoading;
    private long? _detailNumber;
    private List<PurchaseLineView> _detail = new();
    private bool _detailLoading;

    private string _recentSearch = "";
    private int _shown = PageSize;
    private const int PageSize = 100;

    /// <summary>
    /// Every purchase the shop has ever entered, narrowed by whatever was typed. The list used to
    /// stop at the newest 100 documents with nothing to say the rest existed — a shop with 361 of
    /// them could not find last spring's delivery at all.
    /// </summary>
    private IEnumerable<PurchaseSummary> FilteredRecent
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_recentSearch)) return _recent;
            var s = _recentSearch.Trim();
            return _recent.Where(p =>
                p.DocumentNumber.Contains(s, StringComparison.OrdinalIgnoreCase)
                || p.InvoiceNumber.Contains(s, StringComparison.OrdinalIgnoreCase)
                || p.PurchaseType.Contains(s, StringComparison.OrdinalIgnoreCase)
                || p.Date.ToString("dd.MM.yyyy").Contains(s, StringComparison.OrdinalIgnoreCase));
        }
    }

    // Drawn a page at a time: the whole history is IN the list, but handing the browser 361 rows
    // of table on first paint is a stall the till does not need.
    private IEnumerable<PurchaseSummary> ShownRecent => FilteredRecent.Take(_shown);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var u = (await AuthState).User;
            _worker = u.FindFirst(AuthService.FullNameClaim)?.Value ?? u.Identity?.Name ?? "";
        }
        _articles = await Catalog.GetAllArticlesAsync();
        _suppliers = await PurchaseSvc.GetSuppliersAsync();
        _docNumber = await PurchaseSvc.GetNextDocumentNumberAsync();
        _loading = false;
        await LoadRecent();
    }

    private async Task LoadRecent()
    {
        _recentLoading = true;
        _recent = await PurchaseSvc.GetAllPurchasesAsync();
        _recentLoading = false;
    }

    private IEnumerable<Article> FilteredArticles
    {
        get
        {
            IEnumerable<Article> q = _articles;
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(a => a.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || a.Barcode.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q.Take(60);
        }
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_search)) return;
        var hit = _articles.FirstOrDefault(a => a.Barcode == _search.Trim())
                  ?? await Catalog.FindByBarcodeAsync(_search.Trim());
        if (hit is not null)
        {
            AddLine(hit);
            _search = "";
        }
    }

    private void AddLine(Article a)
    {
        var existing = _lines.FirstOrDefault(l => l.ArticleId == a.Id);
        if (existing is not null)
        {
            existing.Quantity += 1;
        }
        else
        {
            _lines.Add(new PurchaseDraftItem
            {
                ArticleId = a.Id,
                Barcode = a.Barcode,
                ArticleName = a.Name,
                Quantity = 1,
                PurchasePrice = a.PurchasePrice,
                SalesPrice = a.SalesPrice,
                VATRate = a.VATRate
            });
        }
        _message = null;
    }

    // Net (pre-VAT) value of a line, after discount.
    private static decimal Net(PurchaseDraftItem l) =>
        l.PurchasePrice * (1 - l.DiscountPercent / 100) * l.Quantity;
    private decimal Subtotal => _lines.Sum(Net);
    private decimal VatTotal => _lines.Sum(l => Net(l) * l.VATRate / 100);
    private decimal Total => Subtotal + VatTotal;

    private async Task Save()
    {
        if (_lines.Count == 0) return;
        _busy = true;
        _message = null;
        try
        {
            var draft = new PurchaseDraft
            {
                DocumentNumber = string.IsNullOrWhiteSpace(_invoiceNumber) ? _docNumber : _invoiceNumber,
                Date = DateTime.Now,
                SupplierId = _supplierId,
                PurchaseType = _purchaseType,
                IsPaid = _isPaid,
                Worker = _worker,
                Items = _lines.ToList()
            };
            if (_editingNumri is { } editNumri)
            {
                // Rewrites the document in place: old stock reversed, new applied.
                if (!await PurchaseSvc.UpdatePurchaseAsync(editNumri, draft))
                {
                    _success = false;
                    _message = "Ndryshimi dështoi. Provo përsëri.";
                    return;
                }
                await Audit.LogAsync(AuditAction.Update, "Purchase", (int)editNumri, draft.DocumentNumber,
                    details: $"{draft.Items.Count} rreshta · {Total:0.00} € · stoku u rregullua");

                _success = true;
                _message = $"Blerja #{editNumri} u ndryshua · stoku u rregullua.";
            }
            else
            {
                var savedNumri = await PurchaseSvc.SavePurchaseAsync(draft);
                if (savedNumri is null)
                {
                    _success = false;
                    _message = "Ruajtja dështoi. Provo përsëri.";
                    return;
                }

                await Audit.LogAsync(AuditAction.Create, "Purchase", (int)savedNumri, draft.DocumentNumber,
                    details: $"{draft.Items.Count} rreshta · {Total:0.00} €");

                _success = true;
                _message = $"Blerja #{savedNumri} u ruajt · stoku u përditësua.";
            }

            _editingNumri = null;
            _lines.Clear();
            _invoiceNumber = "";
            _isPaid = false;
            // Refresh catalogue stock + next doc number for the following entry.
            _articles = await Catalog.GetAllArticlesAsync();
            _docNumber = await PurchaseSvc.GetNextDocumentNumberAsync();
            await LoadRecent();
            _view = View.Recent;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ShowRecent()
    {
        _view = View.Recent;
        await LoadRecent();
    }

    /// <summary>Opens the entry form for a NEW purchase (never an edit).</summary>
    private void ShowEntry()
    {
        _editingNumri = null;
        _lines.Clear();
        _invoiceNumber = "";
        _isPaid = false;
        _supplierId = 0;
        _purchaseType = "Vendore";
        _message = null;
        _view = View.Entry;
    }

    /// <summary>Loads an existing document into the entry form for editing.</summary>
    private async Task EditPurchase(string documentNumber)
    {
        if (!long.TryParse(documentNumber, out var numri)) return;
        var draft = await PurchaseSvc.GetPurchaseDraftAsync(numri);
        if (draft is null) return;

        _editingNumri = numri;
        _lines.Clear();
        _lines.AddRange(draft.Items);
        _invoiceNumber = draft.DocumentNumber;
        _supplierId = draft.SupplierId;
        _purchaseType = draft.PurchaseType;
        _isPaid = draft.IsPaid;
        _message = null;
        _detailNumber = null;
        _view = View.Entry;
    }

    private long? _deleteNumber;

    private async Task ConfirmDelete()
    {
        if (_deleteNumber is not { } numri) return;
        _busy = true;
        try
        {
            var ok = await PurchaseSvc.DeletePurchaseAsync(numri);
            if (ok)
            {
                // Deleting a purchase takes goods back out of stock. Without this row,
                // the inventory simply shrinks and nothing says who shrank it.
                await Audit.LogAsync(AuditAction.Delete, "Purchase", (int)numri, $"#{numri}",
                    details: "Blerja u fshi · stoku u kthye.");
            }

            _success = ok;
            _message = ok
                ? $"Blerja #{numri} u fshi · stoku u kthye."
                : $"Fshirja e blerjes #{numri} dështoi.";
            _deleteNumber = null;
            _articles = await Catalog.GetAllArticlesAsync();
            await LoadRecent();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenDetail(string documentNumber)
    {
        if (!long.TryParse(documentNumber, out var numri)) return;
        _detailNumber = numri;
        _detailLoading = true;
        _detail = await PurchaseSvc.GetPurchaseDetailAsync(numri);
        _detailLoading = false;
    }
}
