@page "/login"
@layout EmptyLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using KosovaPOS.Core.Services
@inject AuthService Auth
@inject BusinessRegistry Businesses
@inject BusinessHostResolver Hosts
@inject NavigationManager Nav

<PageTitle>Kyçu — KosovaPOS</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <h1>KosovaPOS</h1>
        @if (_pinnedByHost && _pinnedBusinessName is not null)
        {
            <p class="subtitle">@_pinnedBusinessName</p>
        }
        else
        {
            <p class="subtitle">Kyçu në sistem</p>
        }

        <EditForm Model="Model" OnValidSubmit="TryLogin" FormName="login" method="post">
            <DataAnnotationsValidator />

            @* On a business subdomain the host names the business, so the code is
               fixed — showing the field would only invite a mismatch. On the apex
               (pos.spacecode.tech) there is no host business, so it is asked for. *@
            @if (!_pinnedByHost)
            {
                <div class="field">
                    <label>Kodi i biznesit</label>
                    <InputText @bind-Value="Model.BusinessCode" class="input" autocomplete="organization"
                               autocapitalize="off" spellcheck="false" />
                </div>
            }

            <div class="field">
                <label>Përdoruesi</label>
                <InputText @bind-Value="Model.Username" class="input" autocomplete="username" />
            </div>
            <div class="field">
                <label>Fjalëkalimi</label>
                <InputText type="password" @bind-Value="Model.Password" class="input" autocomplete="current-password" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="error">@_error</div>
            }

            <button type="submit" class="btn">Kyçu</button>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private LoginModel Model { get; set; } = new();
    private string? _error;

    private bool _pinnedByHost;
    private string? _pinnedBusinessName;

    /// <summary>
    /// Remembers the last business code on this device, for the apex login only.
    /// A till is used by one shop, so its cashiers should type the code once, not
    /// every morning. Not a security boundary — it prefills a field, it does not
    /// grant anything. On a business subdomain the host supplies the code, so this
    /// is unused.
    /// </summary>
    private const string LastBusinessCookie = "KosovaPOS.Biz";

    protected override async Task OnInitializedAsync()
    {
        // BL0008: a form post can hand back a null model.
        Model ??= new();

        // The host is the source of truth when it is a business subdomain. This runs
        // after form binding, so a POST that tries to smuggle a different business
        // code onto pos-bmd is overwritten with bmd before it is ever used.
        var hostCode = Hosts.CodeFromHost(HttpContext.Request.Host.Value);
        var hostBusiness = hostCode is null ? null : await Businesses.GetActiveByCodeAsync(hostCode);
        if (hostBusiness is not null)
        {
            // A live business subdomain (e.g. pos-811274183): pin it, hide the code field.
            _pinnedByHost = true;
            Model.BusinessCode = hostBusiness.Code;
            _pinnedBusinessName = hostBusiness.Name;
        }
        else if (string.IsNullOrWhiteSpace(Model.BusinessCode))
        {
            // Apex, OR a subdomain naming a business that no longer exists (a retired
            // code like pos-bmd). Don't pin to a dead code — that would be a login
            // dead-end with no way to type a valid one; fall back to the normal form.
            Model.BusinessCode = HttpContext.Request.Cookies[LastBusinessCookie] ?? "";
        }
    }

    private async Task TryLogin()
    {
        var business = await Businesses.GetActiveByCodeAsync(Model.BusinessCode);

        // One message for "no such business", "no such user" and "wrong password".
        // Distinguishing them would turn this form into an oracle for which
        // businesses exist on the platform.
        var user = business is null
            ? null
            : await Auth.AuthenticateAsync(business, Model.Username, Model.Password);

        if (business is null || user is null)
        {
            _error = "Kodi i biznesit, përdoruesi ose fjalëkalimi është gabim.";
            return;
        }

        // Only worth remembering on the apex; on a subdomain the host already carries it.
        if (!_pinnedByHost)
        {
            HttpContext.Response.Cookies.Append(LastBusinessCookie, business.Code, new CookieOptions
            {
                MaxAge = TimeSpan.FromDays(365),
                HttpOnly = true,
                Secure = HttpContext.Request.IsHttps,
                SameSite = SameSiteMode.Lax,
                IsEssential = true,
            });
        }

        var principal = AuthService.BuildPrincipal(user, business, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);

        // On the apex (pos.spacecode.tech) send the user to their shop's own
        // subdomain, so every session lands on a URL that names its business — the
        // shared cookie carries the sign-in across. Only in production: on a
        // business subdomain the host already matches, and on localhost there is no
        // subdomain to go to. Guarded by IsUnderBaseHost so dev stays on "/".
        if (!_pinnedByHost && Hosts.IsUnderBaseHost(HttpContext.Request.Host.Value))
        {
            Nav.NavigateTo(Hosts.UrlForCode(business.Code), forceLoad: true);
            return;
        }

        Nav.NavigateTo("/", forceLoad: true);
    }

    public class LoginModel
    {
        public string BusinessCode { get; set; } = "";
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
