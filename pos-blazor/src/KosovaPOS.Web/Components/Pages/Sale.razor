@page "/sale"
@attribute [Authorize(Policy = "perm:sell")]
@rendermode InteractiveServer
@using System.Security.Claims
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject CatalogService Catalog
@inject SalesService Sales
@inject UserService Users
@inject HardwareBridge Hw
@inject LocalState Local
@inject Audit Audit

<PageTitle>Shitje — KosovaPOS</PageTitle>

<div class="sale">
    <!-- Left: catalogue -->
    <section class="catalogue">
        <div class="search-row">
            <input @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKey"
                   placeholder="Kërko emër ose skano barkod…" class="search-box" autofocus />
            @if (_categories.Count > 0)
            {
                <select value="@_activeCategory" class="cat-select"
                        @onchange="e => SetCategory(e.Value?.ToString())">
                    <option value="">Të gjitha</option>
                    @foreach (var c in _categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            }
        </div>

        <div class="grid">
            @if (_loading)
            {
                <p class="muted">Duke ngarkuar artikujt…</p>
            }
            else
            {
                @foreach (var a in FilteredArticles)
                {
                    <button class="prod" @onclick="() => AddToCart(a)">
                        <span class="prod-name">@a.Name</span>
                        <span class="prod-price">@a.SalesPrice.ToString("0.00") €</span>
                        <span class="prod-stock @(a.StockQuantity <= 0 ? "out" : "")">@a.StockQuantity.ToString("0.##")</span>
                    </button>
                }
                @if (!FilteredArticles.Any())
                {
                    <p class="muted">Asnjë artikull.</p>
                }
            }
        </div>
    </section>

    <!-- Right: cart -->
    <section class="cart">
        <div class="cart-head">
            <h2>Fatura</h2>
            <span class="agent-badge @(_agentOnline ? (_agentReal ? "on" : "mock") : "off")"
                  title="@_agentTitle">
                <span class="dot"></span>@(_agentOnline ? (_agentReal ? "Pajisje" : "Pajisje (test)") : "Pa pajisje")
            </span>
        </div>
        <div class="cart-items">
            @if (_cart.Count == 0)
            {
                <p class="muted">Shporta është bosh.</p>
            }
            @foreach (var line in _cart)
            {
                <div class="cart-line">
                    <div class="cl-name">@line.ArticleName</div>
                    <div class="cl-qty touch">
                        <button @onclick="() => ChangeQty(line, -1)">−</button>
                        <span>@line.Quantity.ToString("0.##")</span>
                        <button @onclick="() => ChangeQty(line, 1)">+</button>
                    </div>
                    <div class="cl-price">@line.TotalValue.ToString("0.00") €</div>
                    <button class="cl-del" @onclick="() => Remove(line)">×</button>
                </div>
            }
        </div>

        <div class="totals">
            <div class="t-row"><span>Nën-total (pa TVSH)</span><span>@Subtotal.ToString("0.00") €</span></div>
            <div class="t-row"><span>TVSH (e përfshirë)</span><span>@VatTotal.ToString("0.00") €</span></div>
            <div class="t-row grand"><span>TOTALI</span><span>@Total.ToString("0.00") €</span></div>
        </div>

        <div class="pay">
            <div class="pay-methods">
                @foreach (var m in _methods)
                {
                    <button class="pm @(_payment == m ? "active" : "")" @onclick="() => SetPayment(m)">@m</button>
                }
            </div>
            <label class="fiscal-toggle">
                <input type="checkbox" @bind="_printFiscal" @bind:after="SavePrefs" />
                Printo faturën fiskale
            </label>
            <label class="fiscal-toggle">
                <input type="checkbox" @bind="_printReceipt" @bind:after="SavePrefs" />
                Printo kuponin termik
            </label>

            @* The printer belongs to this PC, not to the shop row: two tills share one login and
               one settings table, but not one printer. So the choice is remembered in this
               browser — and it is remembered, which is the whole point: it used to be re-read
               from settings on every visit and any pick the cashier made was gone by the time
               they came back from another screen. *@
            <PrinterPicker Label="Printeri i kuponit" Printers="_printers"
                           Value="_receiptPrinter" ValueChanged="SetReceiptPrinter" />

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="sale-msg @(_success ? "ok" : "err")">@_message</div>
            }

            @* The fiscal printer refused the receipt. Nine times in ten that is its article
               memory disagreeing with ours after a price change, and clearing it is the fix —
               so the fix is right here, next to the failure, rather than in a settings screen
               the cashier has no permission to open. *@
            @if (_fiscalFailed && _lastNumri is not null)
            {
                <ClearFiscalArticles ButtonClass="btn-ghost" OnCleared="RetryFiscal" />
            }

            @* Reprint of the sale just saved — from right here. Raw ESC/POS through the agent
               when it is installed (no dialog), a hidden print frame when it is not. Neither
               opens a tab: the till screen is the one screen the cashier must never lose. *@
            @if (_lastNumri is not null)
            {
                <div class="print-links">
                    <button class="btn-ghost" disabled="@_printing" @onclick="() => Reprint(Doc.Receipt80)">
                        🧾 Kupon 80mm
                    </button>
                    <button class="btn-ghost" disabled="@_printing" @onclick="() => Reprint(Doc.InvoiceA4)">
                        📄 Faturë A4
                    </button>
                    <button class="btn-ghost" disabled="@_printing" @onclick="() => Reprint(Doc.WaybillA4)">
                        🚚 Fletëdërgesë A4
                    </button>
                </div>
            }

            <button class="complete" disabled="@(_cart.Count == 0 || _busy)" @onclick="StartCheckout">
                @(_busy ? "Duke ruajtur…" : "PËRFUNDO (F12)")
            </button>
        </div>
    </section>
</div>

@* ── The money in the customer's hand ───────────────────────────────────────────────────
   A cash sale ends with a subtraction the cashier used to do in their head while the
   customer waited. So the till asks for the note it was handed, and shows the change in
   figures big enough to read across the counter. Card and transfer skip this entirely:
   there is nothing tendered and nothing to give back. *@
@if (_tender)
{
    <div class="modal-backdrop">
        <div class="modal tender" @onclick:stopPropagation="true">
            <h2>Sa para dha klienti?</h2>

            <div class="tender-total">
                <span>Për pagesë</span>
                <strong>@Total.ToString("0.00") €</strong>
            </div>

            <input type="number" step="0.01" min="0" class="tender-box" id="tender-box"
                   @bind="_paid" @bind:event="oninput" @onkeydown="TenderKey" />

            <div class="tender-quick">
                @foreach (var amount in CashSuggestions)
                {
                    <button class="btn-ghost" @onclick="() => _paid = amount">@amount.ToString("0.00") €</button>
                }
            </div>

            @* Negative means the note does not cover the sale — say so instead of showing a
               change of 0.00 €, which reads as "nothing to give back" and is a way to be short. *@
            <div class="tender-change @(_paid < Total ? "short" : "")">
                <span>@(_paid < Total ? "Mungon" : "Kusuri")</span>
                <strong>@Math.Abs(Total - _paid).ToString("0.00") €</strong>
            </div>

            <div class="modal-actions">
                <button class="btn-primary" disabled="@(_busy || _paid < Total)" @onclick="Complete">
                    @(_busy ? "Duke ruajtur…" : "Përfundo shitjen")
                </button>
                <button class="btn-ghost" disabled="@_busy" @onclick="() => _tender = false">Anulo</button>
            </div>
        </div>
    </div>
}

@* The change owed, after the sale is safely in the database — held on screen until the
   cashier dismisses it, because they are counting coins out of a drawer while it is up. *@
@if (_changeDue is { } due)
{
    <div class="modal-backdrop" @onclick="() => _changeDue = null">
        <div class="modal tender" @onclick:stopPropagation="true">
            <h2>Fatura #@_lastNumri u ruajt</h2>
            <div class="tender-change big">
                <span>KUSURI</span>
                <strong>@due.ToString("0.00") €</strong>
            </div>
            <p class="muted">Paguar @_lastPaid.ToString("0.00") € · Totali @_lastTotal.ToString("0.00") €</p>
            <div class="modal-actions">
                <button class="btn-primary" @onclick="() => _changeDue = null">Në rregull</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Article> _articles = new();
    private List<string> _categories = new();
    private readonly List<ReceiptItem> _cart = new();
    private readonly string[] _methods = { "Para në dorë", "Kartë", "Transfer" };

    private string _search = "";
    private string _activeCategory = "";
    private string _payment = "Para në dorë";
    private decimal _paid;
    private bool _loading = true, _busy, _success;
    private string? _message;

    /// <summary>The tender prompt is open, waiting to be told what the customer handed over.</summary>
    private bool _tender;

    /// <summary>Change owed on the sale just saved. Non-null while the change panel is up.</summary>
    private decimal? _changeDue;
    private decimal _lastPaid, _lastTotal;

    private bool _printFiscal = true;
    private bool _printReceipt;
    /// <summary>The journal number of the sale just saved, so it can be printed from the browser.</summary>
    private long? _lastNumri;
    private Receipt? _lastReceipt;
    private bool _fiscalFailed;
    private bool _agentOnline, _agentReal, _printing;
    private string _agentTitle = "Agjenti i pajisjeve nuk është kontrolluar ende";

    /// <summary>The receipt printer chosen on THIS PC; empty means the shop default.</summary>
    private string? _receiptPrinter;
    private KosovaPOS.Agent.Contracts.PrinterList? _printers;

    /// <summary>Which paper the cashier asked for. All three come off the same saved sale.</summary>
    private enum Doc { Receipt80, InvoiceA4, WaybillA4 }

    // ---- What the till remembers ------------------------------------------------------------
    //
    // Blazor destroys this component the moment the cashier opens another screen, and it used to
    // take everything with it: a customer's basket, already scanned, gone because someone checked
    // a price on /stoku. So the till's state lives in the browser as well as in the circuit.
    //
    // But the basket and the till's SETTINGS have opposite lifetimes, and storing them together
    // was the bug: finishing a sale correctly clears the basket, and it was clearing the printer,
    // the payment method and the print toggles along with it — so every sale reset the till to
    // factory settings and the cashier re-picked their printer all day long. They are two records
    // under two keys now: the cart dies with the sale, the preferences outlive it.

    private sealed record DraftLine(int ArticleId, string Barcode, string Name,
                                    decimal Price, decimal Quantity, decimal VatRate);

    private sealed record SaleDraftState(List<DraftLine> Lines);

    /// <summary>Settings of THIS till, kept across sales, navigations and logins.</summary>
    private sealed record TillPrefs(string Payment, bool PrintFiscal, bool PrintReceipt, string? Category);

    private bool _restored;

    private async Task SaveDraft()
    {
        if (!_restored) return; // don't overwrite a stored cart with the empty one we start with

        if (_cart.Count == 0)
        {
            await Local.RemoveAsync(LocalKeys.SaleDraft);
            return;
        }

        await Local.SaveAsync(LocalKeys.SaleDraft, new SaleDraftState(
            _cart.Select(l => new DraftLine(l.ArticleId, l.Barcode, l.ArticleName,
                                            l.Price, l.Quantity, l.VATRate)).ToList()));
    }

    private async Task SavePrefs()
    {
        if (!_restored) return;
        await Local.SaveAsync(LocalKeys.TillPrefs,
            new TillPrefs(_payment, _printFiscal, _printReceipt, _activeCategory));
    }

    /// <summary>
    /// Puts back the cart that was on this till when the cashier last left it. Prices come from
    /// the DRAFT, not from the catalogue: what was quoted to the customer standing there is what
    /// was scanned, and silently re-pricing a basket behind their back is worse than losing it.
    /// </summary>
    private async Task RestoreAsync()
    {
        var prefs = await Local.LoadAsync<TillPrefs>(LocalKeys.TillPrefs);
        var draft = await Local.LoadAsync<SaleDraftState>(LocalKeys.SaleDraft);
        _receiptPrinter = await Local.LoadAsync<string>(LocalKeys.ReceiptPrinter);
        _restored = true;

        if (prefs is not null)
        {
            if (!string.IsNullOrWhiteSpace(prefs.Payment)) _payment = prefs.Payment;
            _printFiscal = prefs.PrintFiscal;
            _printReceipt = prefs.PrintReceipt;
            // Only restore a category that still exists — a shelf can be renamed, and a filter
            // pinned to a category that is gone shows an empty catalogue that looks like a crash.
            if (!string.IsNullOrWhiteSpace(prefs.Category) && _categories.Contains(prefs.Category!))
                _activeCategory = prefs.Category!;
        }

        if (draft is null || draft.Lines.Count == 0) return;

        _cart.Clear();
        foreach (var l in draft.Lines)
        {
            _cart.Add(new ReceiptItem
            {
                ArticleId = l.ArticleId,
                Barcode = l.Barcode,
                ArticleName = l.Name,
                Price = l.Price,
                Quantity = l.Quantity,
                VATRate = l.VatRate,
            });
        }

        _message = "Shporta e papërfunduar u rikthye.";
        _success = true;
    }

    private async Task SetPayment(string method)
    {
        _payment = method;
        await SavePrefs();
    }

    private async Task SetCategory(string? category)
    {
        _activeCategory = category ?? "";
        await SavePrefs();
    }

    private async Task SetReceiptPrinter(string? printer)
    {
        _receiptPrinter = printer;
        await Local.SaveAsync(LocalKeys.ReceiptPrinter, printer ?? "");
    }

    /// <summary>
    /// Re-sends the fiscal receipt for the sale that was just refused, after the printer's article
    /// memory has been cleared. The sale is already in the database and is not touched: this
    /// prints it, it does not sell it again.
    /// </summary>
    private async Task RetryFiscal()
    {
        if (_lastReceipt is null) return;
        _printing = true;
        try
        {
            var fr = await Hw.PrintFiscalAsync(_lastReceipt, timeoutSeconds: 30);
            _success = fr.Ok;
            _fiscalFailed = !fr.Ok;
            _message = fr.Ok
                ? $"Fatura #{_lastNumri} — fatura fiskale u printua."
                : $"Fatura fiskale përsëri nuk u printua: {fr.Error}";
        }
        finally { _printing = false; }
    }

    /// <summary>
    /// Reprints the sale just saved without leaving the till. The 80mm receipt goes out as raw
    /// ESC/POS when the agent is here and is drawn by the browser when it is not; the two A4
    /// documents are always drawn by the browser (the agent has no A4 path) — but in a hidden
    /// frame, so the cart, the change due and the customer in front of the cashier stay on screen.
    /// </summary>
    private async Task Reprint(Doc doc)
    {
        if (_lastNumri is null) return;
        _printing = true;
        try
        {
            var r = doc switch
            {
                Doc.InvoiceA4 => await Hw.PrintUrlAsync($"/fatura/{_lastNumri}"),
                Doc.WaybillA4 => await Hw.PrintUrlAsync($"/fletedergese/{_lastNumri}"),
                _ => await Hw.PrintReceiptAnyWayAsync(_lastNumri.Value, _receiptPrinter),
            };

            if (!r.Ok)
            {
                _success = false;
                _message = $"Printimi dështoi: {r.Error}";
            }
        }
        finally { _printing = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        _articles = await Catalog.GetAllArticlesAsync();
        _categories = await Catalog.GetCategoriesAsync();
        _loading = false;
    }

    // JS interop is only available after the component becomes interactive — which is also the
    // first moment the browser can be asked what was on this till when it was last left.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RestoreAsync();
        await RefreshAgentStatusAsync();
    }

    private async Task RefreshAgentStatusAsync()
    {
        var health = await Hw.GetHealthAsync();
        _agentOnline = health is not null;
        _agentReal = health?.RealHardware ?? false;
        _agentTitle = health is null
            ? "Agjenti i pajisjeve nuk u gjet — faturat fiskale nuk do të printohen."
            : $"{health.Fiscal.Model} · {health.Fiscal.ComPort} · {(health.RealHardware ? "pajisje reale" : "modaliteti test")}";

        // The list is REPLACED only when a new one actually arrives. This runs after every sale,
        // and a momentarily unreachable agent used to blank it — which took the printer dropdown
        // off the screen mid-shift and made the cashier's choice look like it had been forgotten.
        var printers = _agentOnline ? await Hw.GetPrintersAsync() : null;
        if (printers is { Printers.Count: > 0 }) _printers = printers;

        StateHasChanged();
    }

    private IEnumerable<Article> FilteredArticles
    {
        get
        {
            IEnumerable<Article> q = _articles;
            if (!string.IsNullOrWhiteSpace(_activeCategory))
            {
                // Folded, not compared: the shelf is stored as both "Shtepi" and "Shtëpi", and
                // an equality test on the dropdown's spelling hides most of it.
                var key = CatalogService.CategoryKey(_activeCategory);
                q = q.Where(a => !string.IsNullOrWhiteSpace(a.Category)
                              && CatalogService.CategoryKey(a.Category) == key);
            }
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(a => a.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || a.Barcode.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q.Take(60);
        }
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_search)) return;
        // Exact barcode scan → add directly
        var hit = _articles.FirstOrDefault(a => a.Barcode == _search.Trim())
                  ?? await Catalog.FindByBarcodeAsync(_search.Trim());
        if (hit is not null)
        {
            await AddToCart(hit);
            _search = "";
        }
    }

    /// <summary>
    /// Cash ends at the tender prompt; card and transfer go straight through — there is no note
    /// to hand over and no change to give, so asking for one would be a keystroke per sale for
    /// nothing.
    /// </summary>
    private async Task StartCheckout()
    {
        if (_cart.Count == 0 || _busy) return;

        if (!IsCash)
        {
            _paid = Total;
            await Complete();
            return;
        }

        _paid = Total;              // exact money is the common case; the buttons cover the rest
        _tender = true;
        _message = null;
    }

    private async Task TenderKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _paid >= Total && !_busy) await Complete();
        else if (e.Key == "Escape") _tender = false;
    }

    /// <summary>
    /// The notes a customer plausibly hands over for this total: the exact amount, then the
    /// round figures above it. Anything at or below the total is not an offer of payment.
    /// </summary>
    private IEnumerable<decimal> CashSuggestions
    {
        get
        {
            var total = Total;
            var candidates = new List<decimal> { total, Math.Ceiling(total) };
            candidates.AddRange(new[] { 5m, 10m, 20m, 50m, 100m });

            return candidates
                .Where(c => c >= total && c > 0)
                .Distinct()
                .OrderBy(c => c)
                .Take(5);
        }
    }

    private async Task AddToCart(Article a)
    {
        var existing = _cart.FirstOrDefault(l => l.ArticleId == a.Id);
        if (existing is not null)
        {
            existing.Quantity += 1;
        }
        else
        {
            _cart.Add(new ReceiptItem
            {
                ArticleId = a.Id,
                Barcode = a.Barcode,
                ArticleName = a.Name,
                Price = a.SalesPrice,
                Quantity = 1,
                VATRate = a.VATRate
            });
        }
        _message = null;
        SyncPaid();
        await SaveDraft();
    }

    private async Task ChangeQty(ReceiptItem line, decimal delta)
    {
        line.Quantity += delta;
        if (line.Quantity <= 0) _cart.Remove(line);
        SyncPaid();
        await SaveDraft();
    }

    private async Task Remove(ReceiptItem line)
    {
        _cart.Remove(line);
        SyncPaid();
        await SaveDraft();
    }

    // The cart carries the tender until the prompt sets it; nothing is defaulted behind it.
    private void SyncPaid() => _paid = Total;

    private decimal Subtotal => _cart.Sum(l => l.TotalValue - l.VATValue);
    private decimal VatTotal => _cart.Sum(l => l.VATValue);
    private decimal Total => _cart.Sum(l => l.TotalValue);
    private decimal Change => Math.Max(0, _paid - Total);

    private bool IsCash => _payment == _methods[0];

    private async Task Complete()
    {
        if (_cart.Count == 0) return;
        _busy = true;
        _message = null;
        try
        {
            // Read the cashier's name from the DATABASE, not from the login cookie: the cookie's
            // copy was taken at sign-in, so a user who has since been renamed keeps printing their
            // old name on every receipt until they happen to log out again.
            var cashierName = AuthState is null
                ? ""
                : await Users.CurrentFullNameAsync((await AuthState).User);

            var total = Total;
            var paid = _paid < total ? total : _paid;

            var receiptNo = await Sales.GetNextReceiptNumberAsync();
            var receipt = new Receipt
            {
                ReceiptNumber = receiptNo,
                Date = DateTime.Now,
                CashierName = cashierName,
                PaymentMethod = _payment,
                TotalAmount = total,
                PaidAmount = paid,
                LeftAmount = paid - total,
                Items = _cart.ToList()
            };

            var savedNumri = await Sales.SaveReceiptAsync(receipt);
            if (savedNumri is null)
            {
                _success = false;
                _message = "Ruajtja dështoi. Provo përsëri.";
                return;
            }

            _success = true;
            _lastNumri = savedNumri;
            // Held so the fiscal receipt can be re-sent after the printer's memory is cleared,
            // without ringing the sale up a second time.
            _lastReceipt = receipt;

            var change = paid - total;
            _message = $"Fatura #{savedNumri} u ruajt · Kusuri {change:0.00} €";

            // The sale is in the database, so the prompt has done its job. The change panel takes
            // its place — and only for cash, since a card sale has no coins to count back.
            _tender = false;
            _lastPaid = paid;
            _lastTotal = total;
            _changeDue = IsCash ? change : null;

            await Audit.LogAsync(AuditAction.Sale, "Receipt", (int)savedNumri, receiptNo,
                details: $"{total:0.00} € · {_payment} · {receipt.Items.Count} artikuj");

            // The sale is already persisted; fiscal printing is best-effort and
            // must never roll it back. Report but don't fail the sale if it can't print.
            if (_printFiscal)
            {
                var fr = await Hw.PrintFiscalAsync(receipt, timeoutSeconds: 30);
                if (fr.Ok)
                {
                    _message += " · Fatura fiskale u printua";
                    _fiscalFailed = false;
                }
                else
                {
                    _success = false; // amber-style note: sale ok, print not
                    _message += $" · ⚠ Fatura fiskale nuk u printua: {fr.Error}";

                    // The commonest reason the device refuses a receipt is that it is holding an
                    // article under a name or tax group that no longer matches ours — and the fix
                    // is to clear its memory. Offer that here, where the cashier is standing, and
                    // not on a settings screen they cannot open.
                    _fiscalFailed = true;
                }
                await RefreshAgentStatusAsync();
            }

            // Courtesy thermal receipt on the configured (any) thermal printer. Also
            // best-effort — the sale stands whether or not it prints. Laid out from what
            // was just persisted, so the paper is the sale, not the cart it came from.
            if (_printReceipt)
            {
                var rr = await Hw.PrintReceiptAsync(savedNumri.Value, _receiptPrinter);
                _message += rr.Ok ? " · Kuponi u printua" : $" · ⚠ Kuponi nuk u printua: {rr.Error}";
                if (!rr.Ok) _success = false;
                await RefreshAgentStatusAsync();
            }

            _cart.Clear();
            _paid = 0;
            // The basket is now a sale in the database. Leaving it in the browser as well would
            // hand the next customer the last one's shopping.
            await Local.RemoveAsync(LocalKeys.SaleDraft);
            // Refresh stock counts shown in the grid
            _articles = await Catalog.GetAllArticlesAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
