@page "/sale"
@attribute [Authorize(Policy = "perm:sell")]
@rendermode InteractiveServer
@using System.Security.Claims
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject CatalogService Catalog
@inject SalesService Sales
@inject HardwareBridge Hw
@inject Audit Audit

<PageTitle>Shitje — KosovaPOS</PageTitle>

<div class="sale">
    <!-- Left: catalogue -->
    <section class="catalogue">
        <div class="search-row">
            <input @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKey"
                   placeholder="Kërko emër ose skano barkod…" class="search-box" autofocus />
            @if (_categories.Count > 0)
            {
                <select @bind="_activeCategory" class="cat-select">
                    <option value="">Të gjitha</option>
                    @foreach (var c in _categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            }
        </div>

        <div class="grid">
            @if (_loading)
            {
                <p class="muted">Duke ngarkuar artikujt…</p>
            }
            else
            {
                @foreach (var a in FilteredArticles)
                {
                    <button class="prod" @onclick="() => AddToCart(a)">
                        <span class="prod-name">@a.Name</span>
                        <span class="prod-price">@a.SalesPrice.ToString("0.00") €</span>
                        <span class="prod-stock @(a.StockQuantity <= 0 ? "out" : "")">@a.StockQuantity.ToString("0.##")</span>
                    </button>
                }
                @if (!FilteredArticles.Any())
                {
                    <p class="muted">Asnjë artikull.</p>
                }
            }
        </div>
    </section>

    <!-- Right: cart -->
    <section class="cart">
        <div class="cart-head">
            <h2>Fatura</h2>
            <span class="agent-badge @(_agentOnline ? (_agentReal ? "on" : "mock") : "off")"
                  title="@_agentTitle">
                <span class="dot"></span>@(_agentOnline ? (_agentReal ? "Pajisje" : "Pajisje (test)") : "Pa pajisje")
            </span>
        </div>
        <div class="cart-items">
            @if (_cart.Count == 0)
            {
                <p class="muted">Shporta është bosh.</p>
            }
            @foreach (var line in _cart)
            {
                <div class="cart-line">
                    <div class="cl-name">@line.ArticleName</div>
                    <div class="cl-qty">
                        <button @onclick="() => ChangeQty(line, -1)">−</button>
                        <span>@line.Quantity.ToString("0.##")</span>
                        <button @onclick="() => ChangeQty(line, 1)">+</button>
                    </div>
                    <div class="cl-price">@line.TotalValue.ToString("0.00") €</div>
                    <button class="cl-del" @onclick="() => Remove(line)">×</button>
                </div>
            }
        </div>

        <div class="totals">
            <div class="t-row"><span>Nën-total (pa TVSH)</span><span>@Subtotal.ToString("0.00") €</span></div>
            <div class="t-row"><span>TVSH (e përfshirë)</span><span>@VatTotal.ToString("0.00") €</span></div>
            <div class="t-row grand"><span>TOTALI</span><span>@Total.ToString("0.00") €</span></div>
        </div>

        <div class="pay">
            <div class="pay-methods">
                @foreach (var m in _methods)
                {
                    <button class="pm @(_payment == m ? "active" : "")" @onclick="() => _payment = m">@m</button>
                }
            </div>
            <div class="pay-row">
                <label>Paguar</label>
                <input type="number" step="0.01" @bind="_paid" class="paid-box" />
            </div>
            <div class="pay-row change">
                <span>Kusuri</span>
                <span>@Change.ToString("0.00") €</span>
            </div>
            <label class="fiscal-toggle">
                <input type="checkbox" @bind="_printFiscal" />
                Printo faturën fiskale
            </label>
            <label class="fiscal-toggle">
                <input type="checkbox" @bind="_printReceipt" />
                Printo kuponin termik
            </label>

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="sale-msg @(_success ? "ok" : "err")">@_message</div>
            }

            @* The fiscal printer refused the receipt. Nine times in ten that is its article
               memory disagreeing with ours after a price change, and clearing it is the fix —
               so the fix is right here, next to the failure, rather than in a settings screen
               the cashier has no permission to open. *@
            @if (_fiscalFailed && _lastNumri is not null)
            {
                <ClearFiscalArticles ButtonClass="btn-ghost" OnCleared="RetryFiscal" />
            }

            @* Reprint of the sale just saved — from right here. Raw ESC/POS through the agent
               when it is installed (no dialog), a hidden print frame when it is not. Neither
               opens a tab: the till screen is the one screen the cashier must never lose. *@
            @if (_lastNumri is not null)
            {
                <div class="print-links">
                    <button class="btn-ghost" disabled="@_printing" @onclick="() => Reprint(false)">
                        🧾 Printo kuponin (80mm)
                    </button>
                    <button class="btn-ghost" disabled="@_printing" @onclick="() => Reprint(true)">
                        📄 Faturë A4
                    </button>
                </div>
            }

            <button class="complete" disabled="@(_cart.Count == 0 || _busy)" @onclick="Complete">
                @(_busy ? "Duke ruajtur…" : "PËRFUNDO (F12)")
            </button>
        </div>
    </section>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Article> _articles = new();
    private List<string> _categories = new();
    private readonly List<ReceiptItem> _cart = new();
    private readonly string[] _methods = { "Para në dorë", "Kartë", "Transfer" };

    private string _search = "";
    private string _activeCategory = "";
    private string _payment = "Para në dorë";
    private decimal _paid;
    private bool _loading = true, _busy, _success;
    private string? _message;
    private string _cashierName = "";

    private bool _printFiscal = true;
    private bool _printReceipt;
    /// <summary>The journal number of the sale just saved, so it can be printed from the browser.</summary>
    private long? _lastNumri;
    private Receipt? _lastReceipt;
    private bool _fiscalFailed;
    private bool _agentOnline, _agentReal, _printing;
    private string _agentTitle = "Agjenti i pajisjeve nuk është kontrolluar ende";

    /// <summary>
    /// Re-sends the fiscal receipt for the sale that was just refused, after the printer's article
    /// memory has been cleared. The sale is already in the database and is not touched: this
    /// prints it, it does not sell it again.
    /// </summary>
    private async Task RetryFiscal()
    {
        if (_lastReceipt is null) return;
        _printing = true;
        try
        {
            var fr = await Hw.PrintFiscalAsync(_lastReceipt, timeoutSeconds: 30);
            _success = fr.Ok;
            _fiscalFailed = !fr.Ok;
            _message = fr.Ok
                ? $"Fatura #{_lastNumri} — fatura fiskale u printua."
                : $"Fatura fiskale përsëri nuk u printua: {fr.Error}";
        }
        finally { _printing = false; }
    }

    /// <summary>
    /// Reprints the sale just saved without leaving the till. The 80mm receipt goes out as raw
    /// ESC/POS when the agent is here and is drawn by the browser when it is not; the A4 invoice
    /// is always drawn by the browser (the agent has no A4 path) — but in a hidden frame, so the
    /// cart, the change due and the customer in front of the cashier all stay on screen.
    /// </summary>
    private async Task Reprint(bool a4)
    {
        if (_lastNumri is null) return;
        _printing = true;
        try
        {
            var r = a4
                ? await Hw.PrintUrlAsync($"/fatura/{_lastNumri}")
                : await Hw.PrintReceiptAnyWayAsync(_lastNumri.Value);

            if (!r.Ok)
            {
                _success = false;
                _message = $"Printimi dështoi: {r.Error}";
            }
        }
        finally { _printing = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var u = (await AuthState).User;
            _cashierName = u.FindFirst(AuthService.FullNameClaim)?.Value ?? u.Identity?.Name ?? "";
        }
        _articles = await Catalog.GetAllArticlesAsync();
        _categories = await Catalog.GetCategoriesAsync();
        _loading = false;
    }

    // JS interop is only available after the component becomes interactive.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshAgentStatusAsync();
    }

    private async Task RefreshAgentStatusAsync()
    {
        var health = await Hw.GetHealthAsync();
        _agentOnline = health is not null;
        _agentReal = health?.RealHardware ?? false;
        _agentTitle = health is null
            ? "Agjenti i pajisjeve nuk u gjet — faturat fiskale nuk do të printohen."
            : $"{health.Fiscal.Model} · {health.Fiscal.ComPort} · {(health.RealHardware ? "pajisje reale" : "modaliteti test")}";
        StateHasChanged();
    }

    private IEnumerable<Article> FilteredArticles
    {
        get
        {
            IEnumerable<Article> q = _articles;
            if (!string.IsNullOrWhiteSpace(_activeCategory))
                q = q.Where(a => a.Category == _activeCategory);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(a => a.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || a.Barcode.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q.Take(60);
        }
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_search)) return;
        // Exact barcode scan → add directly
        var hit = _articles.FirstOrDefault(a => a.Barcode == _search.Trim())
                  ?? await Catalog.FindByBarcodeAsync(_search.Trim());
        if (hit is not null)
        {
            AddToCart(hit);
            _search = "";
        }
    }

    private void AddToCart(Article a)
    {
        var existing = _cart.FirstOrDefault(l => l.ArticleId == a.Id);
        if (existing is not null)
        {
            existing.Quantity += 1;
        }
        else
        {
            _cart.Add(new ReceiptItem
            {
                ArticleId = a.Id,
                Barcode = a.Barcode,
                ArticleName = a.Name,
                Price = a.SalesPrice,
                Quantity = 1,
                VATRate = a.VATRate
            });
        }
        _message = null;
        SyncPaid();
    }

    private void ChangeQty(ReceiptItem line, decimal delta)
    {
        line.Quantity += delta;
        if (line.Quantity <= 0) _cart.Remove(line);
        SyncPaid();
    }

    private void Remove(ReceiptItem line)
    {
        _cart.Remove(line);
        SyncPaid();
    }

    // Keep "paid" defaulted to the total for quick cash sales until the user overrides.
    private void SyncPaid() => _paid = Total;

    private decimal Subtotal => _cart.Sum(l => l.TotalValue - l.VATValue);
    private decimal VatTotal => _cart.Sum(l => l.VATValue);
    private decimal Total => _cart.Sum(l => l.TotalValue);
    private decimal Change => Math.Max(0, _paid - Total);

    private async Task Complete()
    {
        if (_cart.Count == 0) return;
        _busy = true;
        _message = null;
        try
        {
            var receiptNo = await Sales.GetNextReceiptNumberAsync();
            var receipt = new Receipt
            {
                ReceiptNumber = receiptNo,
                Date = DateTime.Now,
                CashierName = _cashierName,
                PaymentMethod = _payment,
                TotalAmount = Total,
                PaidAmount = _paid < Total ? Total : _paid,
                LeftAmount = Change,
                Items = _cart.ToList()
            };

            var savedNumri = await Sales.SaveReceiptAsync(receipt);
            if (savedNumri is null)
            {
                _success = false;
                _message = "Ruajtja dështoi. Provo përsëri.";
                return;
            }

            _success = true;
            _lastNumri = savedNumri;
            // Held so the fiscal receipt can be re-sent after the printer's memory is cleared,
            // without ringing the sale up a second time.
            _lastReceipt = receipt;
            var change = Change;
            _message = $"Fatura #{savedNumri} u ruajt · Kusuri {change:0.00} €";

            await Audit.LogAsync(AuditAction.Sale, "Receipt", (int)savedNumri, receiptNo,
                details: $"{Total:0.00} € · {_payment} · {_cart.Count} artikuj");

            // The sale is already persisted; fiscal printing is best-effort and
            // must never roll it back. Report but don't fail the sale if it can't print.
            if (_printFiscal)
            {
                var fr = await Hw.PrintFiscalAsync(receipt, timeoutSeconds: 30);
                if (fr.Ok)
                {
                    _message += " · Fatura fiskale u printua";
                    _fiscalFailed = false;
                }
                else
                {
                    _success = false; // amber-style note: sale ok, print not
                    _message += $" · ⚠ Fatura fiskale nuk u printua: {fr.Error}";

                    // The commonest reason the device refuses a receipt is that it is holding an
                    // article under a name or tax group that no longer matches ours — and the fix
                    // is to clear its memory. Offer that here, where the cashier is standing, and
                    // not on a settings screen they cannot open.
                    _fiscalFailed = true;
                }
                await RefreshAgentStatusAsync();
            }

            // Courtesy thermal receipt on the configured (any) thermal printer. Also
            // best-effort — the sale stands whether or not it prints. Laid out from what
            // was just persisted, so the paper is the sale, not the cart it came from.
            if (_printReceipt)
            {
                var rr = await Hw.PrintReceiptAsync(savedNumri.Value);
                _message += rr.Ok ? " · Kuponi u printua" : $" · ⚠ Kuponi nuk u printua: {rr.Error}";
                if (!rr.Ok) _success = false;
                await RefreshAgentStatusAsync();
            }

            _cart.Clear();
            _paid = 0;
            // Refresh stock counts shown in the grid
            _articles = await Catalog.GetAllArticlesAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
