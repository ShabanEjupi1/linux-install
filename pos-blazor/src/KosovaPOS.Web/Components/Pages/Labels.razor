@page "/etiketa"
@attribute [Authorize(Policy = "perm:stock")]
@layout EmptyLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using KosovaPOS.Core.Printing
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject CatalogService Catalog
@inject BusinessProfileService Profile
@inject HardwareBridge Hw
@inject IJSRuntime JS

@* Barcode labels.

   Printing prefers the AGENT: it sends raw TSPL to the HPRT, the printer's own firmware
   draws the bars, and no print dialog opens. This page's SVG rendering is the fallback for
   a PC with no agent — a web page cannot send raw bytes to a printer, so the bars are drawn
   as graphics (which is what the desktop's own GenerateTSPLWithBitmap fallback did) and go
   out through the HPRT's Windows driver. Either way the layout is the same, and mirrors
   POS2/Services/BarcodePrinterService.GenerateTSPLLabel: company name small at the top,
   article name under it, the price large in the middle, the barcode across the bottom.

   The browser fallback cannot suppress the print dialog — no web page can. Launch Chrome
   with --kiosk-printing (tools/kiosk-shortcut.ps1) and even the fallback prints silently. *@

<PageTitle>Etiketat — KosovaPOS</PageTitle>

@* The page size IS the label stock, and the stock is a parameter — so this rule cannot
   live in app.css. Margin 0: the driver owns the label's edges, and a CSS margin here
   would shrink the barcode until a scanner refuses it. *@
<HeadContent>
    <style>
        @@media print {
            @@page { size: @(_wMm)mm @(_hMm)mm; margin: 0; }
        }
    </style>
</HeadContent>

<div class="inv-toolbar">
    <a class="btn-ghost" href="/barkod">← Barkodi</a>
    <button class="btn-primary" @onclick="Print" disabled="@(_labels.Count == 0 || _busy)">
        @(_busy ? "Duke printuar…" : $"🖨️ Printo {_labels.Count} etiketa")
    </button>
    @if (_status is not null)
    {
        <span class="muted print-hint">@_status</span>
    }
</div>

@if (_labels.Count == 0)
{
    <div class="lbl-empty">
        <p>Asnjë etiketë për të printuar.</p>
        <p class="muted">Zgjidh artikujt te <a href="/barkod">Barkodi</a> dhe shtyp “Printo nga shfletuesi”.</p>
    </div>
}
else
{
    @if (_unencodable.Count > 0)
    {
        @* Screen-only: a code that cannot be encoded still prints, but as text, exactly as
           the desktop did. Saying so beats letting the shop discover it at the scanner. *@
        <div class="sale-msg err lbl-warn">
            @_unencodable.Count artikuj nuk kanë barkod që printohet dot në këtë etiketë (bosh,
            me shkronja jo-ASCII, 13 shifra me shifër kontrolli të gabuar, ose shumë i gjatë për
            @(_wMm) mm) — etiketa printohet, por vetëm me tekst, pa vija që lexohen nga skaneri:
            @string.Join(", ", _unencodable.Take(6))@(_unencodable.Count > 6 ? "…" : "")
        </div>
    }

    <div class="lbl-sheet">
        @foreach (var lbl in _labels)
        {
            <div class="lbl" style="width:@(_wMm)mm; height:@(_hMm)mm;">
                <div class="lbl-shop">@_shopName</div>
                <div class="lbl-name">@lbl.Name</div>
                <div class="lbl-price">@lbl.Price.ToString("0.00") EUR</div>

                <div class="lbl-code">
                    @if (lbl.Svg is not null)
                    {
                        @((MarkupString)lbl.Svg)
                        <div class="lbl-digits">@lbl.Barcode</div>
                    }
                    else
                    {
                        <div class="lbl-digits lbl-nobar">@(string.IsNullOrWhiteSpace(lbl.Barcode) ? "PA BARKOD" : lbl.Barcode)</div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    /// <summary>
    /// The print queue, as <c>id x copies</c> pairs — e.g. <c>?q=12x3,40x1</c>. Passed in the
    /// URL rather than held in server state so the page can be reloaded, bookmarked and
    /// reprinted after a paper jam without rebuilding the queue.
    /// </summary>
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    /// <summary>Label stock, in mm. Defaults to the 55×25 the desktop assumed for the HPRT.</summary>
    [SupplyParameterFromQuery(Name = "w")] public int? W { get; set; }
    [SupplyParameterFromQuery(Name = "h")] public int? H { get; set; }

    /// <summary>?auto=1 opens the print dialog once the labels have rendered.</summary>
    [SupplyParameterFromQuery(Name = "auto")] public string? Auto { get; set; }

    private sealed record Label(string Name, string Barcode, decimal Price, string? Svg);

    private readonly List<Label> _labels = new();

    /// <summary>The queue as the agent wants it — one entry per article, with its copy count.</summary>
    private readonly List<(Article Article, int Copies)> _queue = new();

    private readonly List<string> _unencodable = new();
    private string _shopName = "";
    private string? _labelPrinter;
    private int _wMm = 55, _hMm = 25;
    private bool _printed, _busy;
    private string? _status;

    protected override async Task OnInitializedAsync()
    {
        _wMm = W is >= 20 and <= 200 ? W.Value : 55;
        _hMm = H is >= 10 and <= 200 ? H.Value : 25;

        var shop = await Profile.GetSettingsAsync();
        _shopName = string.IsNullOrWhiteSpace(shop?.BusinessName) ? "" : shop!.BusinessName!;
        _labelPrinter = shop?.BarcodePrinter;

        var wanted = ParseQueue(Q);
        if (wanted.Count == 0) return;

        var articles = (await Catalog.GetAllArticlesAsync())
            .Where(a => wanted.ContainsKey(a.Id))
            .ToDictionary(a => a.Id);

        // Bar height scales with the label: a 4.5mm barcode on a 25mm label is what the
        // desktop asked TSPL for (35 dots at 8 dots/mm), and it stays legible if the shop
        // switches to taller stock.
        var barMm = Math.Max(4.0, _hMm * 0.18);

        // The bars must fit INSIDE the label, minus its side padding. A barcode wider than
        // the label is not a wide barcode — it is a clipped one, and a clipped barcode still
        // looks right while scanning nowhere. Shrink the module to fit; if even the smallest
        // scannable bar won't fit, print the number as text and say so.
        var usableMm = _wMm - 3;

        foreach (var (id, copies) in wanted)
        {
            if (!articles.TryGetValue(id, out var a)) continue;

            var module = BarcodeSvg.FitModuleMm(a.Barcode, usableMm);
            var svg = module is null ? null : BarcodeSvg.Render(a.Barcode, heightMm: barMm, moduleMm: module.Value);

            if (svg is null && !_unencodable.Contains(a.Name))
                _unencodable.Add(a.Name);

            _queue.Add((a, copies));
            for (int i = 0; i < copies; i++)
                _labels.Add(new Label(a.Name, a.Barcode, a.SalesPrice, svg));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_printed || _labels.Count == 0 || Auto != "1") return;
        _printed = true;
        await Print();
        StateHasChanged();
    }

    /// <summary>
    /// Agent first: raw TSPL to the HPRT, no print dialog. It goes article by article so a
    /// jam does not discard the rest of the queue. If the very first label cannot be sent
    /// (no agent on this PC), nothing has printed yet, so the whole queue safely falls back
    /// to the browser; a failure *after* something printed must not, or the shop gets
    /// duplicates.
    /// </summary>
    private async Task Print()
    {
        _busy = true;
        _status = null;
        try
        {
            var sent = 0;
            var failed = new List<string>();

            foreach (var (article, copies) in _queue)
            {
                var result = await Hw.PrintBarcodeAsync(article, copies, _labelPrinter, _wMm, _hMm);
                if (result.Ok) sent += copies;
                else if (sent == 0) { await JS.InvokeVoidAsync("print"); return; }
                else failed.Add($"{article.Name}: {result.Error}");
            }

            _status = failed.Count == 0
                ? $"{sent} etiketa u dërguan te printeri i etiketave."
                : $"{sent} etiketa u printuan · {failed.Count} dështuan: {string.Join(" · ", failed.Take(3))}";
        }
        finally { _busy = false; }
    }

    /// <summary>Parses <c>12x3,40x1</c>. Silently drops anything malformed — a bad URL must not 500 the till.</summary>
    private static Dictionary<int, int> ParseQueue(string? q)
    {
        var result = new Dictionary<int, int>();
        if (string.IsNullOrWhiteSpace(q)) return result;

        foreach (var part in q.Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            var bits = part.Split('x', 2);
            if (!int.TryParse(bits[0], out var id) || id <= 0) continue;

            var copies = bits.Length > 1 && int.TryParse(bits[1], out var c) ? c : 1;
            if (copies is < 1 or > 200) copies = Math.Clamp(copies, 1, 200);

            result[id] = result.TryGetValue(id, out var had) ? Math.Min(200, had + copies) : copies;
        }
        return result;
    }
}
