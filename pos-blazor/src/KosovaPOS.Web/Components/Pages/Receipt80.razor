@page "/kupon/{Numri:long}"
@attribute [Authorize(Policy = "perm:sell")]
@layout EmptyLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using KosovaPOS.Core.Printing
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject SalesService Sales
@inject BusinessProfileService Profile
@inject HardwareBridge Hw
@inject IJSRuntime JS

@* An 80mm thermal receipt. The layout is NOT built here: ReceiptFormatter lays it out as
   fixed-width monospace lines (the same grid the desktop drew with Courier New through GDI,
   which is why its receipts came out right on the Epson). This page only renders them, and
   the agent emits the identical lines as ESC/POS — one document, two outputs.

   Printing prefers the agent, because raw ESC/POS goes straight to the thermal printer with
   NO print dialog. The browser's window.print() is the fallback for a PC with no agent, and
   it cannot suppress that dialog — no web page can. Launch Chrome with --kiosk-printing
   (tools/kiosk-shortcut.ps1) and even the fallback prints silently.

   The FISCAL receipt still needs the agent — F-Link is driven by dropping a file in a
   watched folder, which a browser cannot do — so this is the customer copy, not the
   ATK-fiscal one. *@

<PageTitle>Kupon @Numri — KosovaPOS</PageTitle>

@* The paper this document prints on. Two traps, both of which were live:

   1. It MUST live here, not in app.css: @@page is a GLOBAL rule, so the A4 invoice's @@page
      and this one fight in a shared stylesheet and one document prints on the wrong paper.

   2. `size: 80mm auto` is INVALID CSS — the spec allows `auto`, or one or two lengths, but
      not a length mixed with `auto`. Chrome drops the whole declaration and silently falls
      back to Letter/A4. So the height has to be a real number: we know the line count and
      the line height, so we compute the exact length of the receipt. That also means the
      thermal printer feeds no blank paper past the cut. *@
<HeadContent>
    <style>
        @@media print {
            @@page { size: 80mm @(HeightMm)mm; margin: 0; }
        }
    </style>
</HeadContent>

@if (_notFound)
{
    <div class="inv-toolbar"><a class="btn-ghost" href="/faturat">← Faturat</a></div>
    <div class="r80"><p>Fatura #@Numri nuk u gjet.</p></div>
}
else if (_lines is null)
{
    <div class="r80"><p>Duke ngarkuar…</p></div>
}
else
{
    <div class="inv-toolbar">
        <a class="btn-ghost" href="/faturat">← Faturat</a>
        <button class="btn-primary" @onclick="Print" disabled="@_busy">
            @(_busy ? "Duke printuar…" : "🖨️ Printo kuponin")
        </button>
        @if (_status is not null)
        {
            <span class="muted print-hint">@_status</span>
        }
    </div>

    @* One <pre>: the formatter has already padded every line to the column grid, so the
       browser must not re-wrap or re-space anything. Emphasis rides on a class per line, and
       the newline is emitted explicitly — Razor swallows the literal one between elements. *@
    <pre class="r80">@foreach (var line in _lines)
      {<span class="@Css(line.Emphasis)">@line.Text</span>@("\n")}</pre>
}

@code {
    [Parameter] public long Numri { get; set; }

    /// <summary>?auto=1 opens the print dialog as soon as the receipt has rendered.</summary>
    [SupplyParameterFromQuery(Name = "auto")] public string? Auto { get; set; }

    private List<ReceiptTextLine>? _lines;
    private bool _notFound;
    private bool _printed;
    private bool _busy;
    private string? _status;

    /// <summary>
    /// The paper length, derived from what is actually on it. Must agree with app.css:
    /// font-size 2.85mm × line-height 1.25 = 3.5625mm per line, plus the extra height of
    /// the 1.35em title line, plus a tail so the last line clears the cutter.
    /// </summary>
    private int HeightMm
    {
        get
        {
            const double LineMm = 2.85 * 1.25;
            const double TitleExtraMm = 2.85 * 0.35 * 1.25;
            const double TailMm = 8;

            var count = _lines?.Count ?? 0;
            return (int)Math.Ceiling(count * LineMm + TitleExtraMm + TailMm);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var invoice = await Sales.GetInvoiceAsync(Numri);
        if (invoice is null) { _notFound = true; return; }

        var shop = await Profile.GetSettingsAsync();
        _lines = ReceiptFormatter.Format(invoice, HardwareBridge.ReceiptHeaderFor(shop));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Print once, after the receipt is actually on screen — the browser fallback prints
        // the DOM, and printing during prerender would produce a blank page.
        if (_printed || _lines is null || Auto != "1") return;
        _printed = true;
        await Print();
        StateHasChanged();
    }

    /// <summary>
    /// Agent first: it prints the same document as raw ESC/POS, with no dialog to click
    /// through. Only a PC without the agent falls back to the browser.
    /// </summary>
    private async Task Print()
    {
        _busy = true;
        _status = null;
        try
        {
            var sent = await Hw.PrintReceiptAsync(Numri);
            if (sent.Ok)
            {
                _status = "Kuponi u dërgua te printeri termik.";
                return;
            }

            await JS.InvokeVoidAsync("print");
        }
        finally { _busy = false; }
    }

    private static string Css(ReceiptEmphasis e) => e switch
    {
        ReceiptEmphasis.Title => "r80-title",
        ReceiptEmphasis.Bold  => "r80-bold",
        _                     => "",
    };
}
