@page "/dyqani"
@layout KosovaPOS.Web.Components.Layout.ShopLayout
@using KosovaPOS.Core.Services
@inject ShopService Shop
@inject BusinessProfileService Profile

@* Static SSR on purpose — no @rendermode. A shop's product grid is exactly the kind of page
   Blazor Server is worst at: it would open a WebSocket per browsing customer and render HTML
   a search engine never sees. Rendered once per request, it costs a query (cached) and is a
   real document. Every interaction below is a plain form post. *@

<PageTitle>@_title</PageTitle>
<HeadContent>
    <meta name="description" content="@_tagline" />
</HeadContent>

@if (!_open)
{
    <div class="shop-closed">
        <h1>Dyqani është i mbyllur</h1>
        <p class="muted">Kthehuni së shpejti.</p>
    </div>
}
else
{
    <section class="shop-hero">
        <h1>@_title</h1>
        @if (!string.IsNullOrWhiteSpace(_tagline))
        {
            <p>@_tagline</p>
        }
    </section>

    @if (_categories.Count > 0)
    {
        <nav class="shop-cats">
            <a class="@(Category is null ? "on" : null)" href="/dyqani">Të gjitha</a>
            @foreach (var c in _categories)
            {
                <a class="@(string.Equals(c, Category, StringComparison.OrdinalIgnoreCase) ? "on" : null)"
                   href="@($"/dyqani?kategoria={Uri.EscapeDataString(c)}")">@c</a>
            }
        </nav>
    }

    @if (_products.Count == 0)
    {
        @* Until a human has named and photographed the first article in /foto, this IS the
           shop — an open storefront with nothing to list yet. It must read as "being
           stocked", not "broken". The category-filter miss is a different message: the shop
           has products, just none under that tab. *@
        <div class="shop-empty-state">
            <div class="shop-empty-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 8h12l-1 12H7L6 8Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" />
                </svg>
            </div>
            @if (Category is not null)
            {
                <h2>Asnjë produkt në këtë kategori</h2>
                <p class="muted">Provoni një kategori tjetër ose shikoni të gjitha produktet.</p>
                <a class="shop-add" href="/dyqani">Të gjitha produktet</a>
            }
            else
            {
                <h2>Dyqani po mbushet</h2>
                <p class="muted">Produktet po shtohen së shpejti — kthehuni pas pak.</p>
                @if (!string.IsNullOrWhiteSpace(_phone))
                {
                    <p class="muted">Për porosi: <a href="tel:@_phone">@_phone</a></p>
                }
            }
        </div>
    }
    else
    {
        <div class="shop-grid">
            @foreach (var p in _products)
            {
                <article class="shop-card @(p.InStock ? null : "out")">
                    <a class="shop-card-img" href="@($"/dyqani/produkti/{p.Id}")">
                        <ProductThumb Src="@p.MainPhoto" Alt="@p.Name" Class="shop-card-thumb" />
                        @if (!p.InStock)
                        {
                            <span class="shop-sold">S'ka në gjendje</span>
                        }
                    </a>

                    <div class="shop-card-body">
                        <a class="shop-card-name" href="@($"/dyqani/produkti/{p.Id}")">@p.Name</a>
                        <div class="shop-card-price">@p.Price.ToString("0.00") €</div>
                    </div>

                    @if (p.InStock)
                    {
                        <form method="post" action="/dyqani/shto">
                            <input type="hidden" name="articleId" value="@p.Id" />
                            <input type="hidden" name="back" value="@_backUrl" />
                            <button type="submit" class="shop-add">Shto në shportë</button>
                        </form>
                    }
                    else
                    {
                        <button class="shop-add" disabled>S'ka në gjendje</button>
                    }
                </article>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "kategoria")]
    public string? Category { get; set; }

    private bool _open;
    private string _title = "Dyqani";
    private string? _tagline;
    private string? _phone;
    private List<ShopProduct> _products = [];
    private List<string> _categories = [];
    private string _backUrl = "/dyqani";

    protected override async Task OnInitializedAsync()
    {
        var settings = await Profile.GetSettingsAsync();
        _open = settings?.ShopEnabled ?? false;
        if (!_open) return;

        _title = string.IsNullOrWhiteSpace(settings!.BusinessName) ? "Dyqani" : settings.BusinessName!;
        _tagline = settings.ShopTagline;
        _phone = settings.Phone;

        var all = await Shop.GetProductsAsync();
        _categories = await Shop.GetCategoriesAsync();

        _products = Category is null
            ? all
            : all.Where(p => string.Equals(p.Category, Category, StringComparison.OrdinalIgnoreCase)).ToList();

        _backUrl = Category is null ? "/dyqani" : $"/dyqani?kategoria={Uri.EscapeDataString(Category)}";
    }
}
