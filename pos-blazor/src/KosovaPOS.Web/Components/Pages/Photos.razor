@page "/foto"
@rendermode @(RenderModes.Interactive)
@attribute [Authorize(Policy = "perm:articles")]
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Models.Shop
@inject CatalogService Catalog
@inject PhotoService Library
@inject ShopListingService Listings
@inject BarcodeImageLookup Barcodes

@* The one screen that turns an accounting row into something a customer can buy. Photo AND
   name, together, because both are missing for the same reason (BMD has neither) and because
   whoever fills them in is standing in front of the item holding a phone — making them visit
   two screens per article, 74 times, is how the job doesn't get done. *@

<PageTitle>Produktet në dyqan</PageTitle>

<h1>Produktet në dyqan</h1>
<p class="muted">
    Një produkt shfaqet në dyqanin online vetëm kur ka <strong>foto</strong> dhe <strong>emër</strong>.
    Emri nga kontabiliteti ("Loder 0115012") nuk i tregon klientit asgjë, prandaj shkruani emrin
    e vërtetë të produktit.
    @if (_total > 0)
    {
        <text><br />@_ready nga @_total artikuj janë gati për dyqan.</text>
    }
</p>

<div class="row" style="gap:10px;margin:16px 0">
    <input @bind="_search" @bind:event="oninput" placeholder="Kërko sipas emrit ose barkodit…" style="flex:1" />
    <label class="row" style="gap:6px;align-items:center">
        <input type="checkbox" @bind="_onlyMissing" />
        Vetëm ato që s'janë gati
    </label>
    <label class="row" style="gap:6px;align-items:center">
        <input type="checkbox" @bind="_onlyInStock" />
        Vetëm në gjendje
    </label>
</div>

@if (_loading)
{
    <Skeleton />
}
else
{
    <div class="photo-list">
        @foreach (var article in Filtered().Take(60))
        {
            var count = _counts.GetValueOrDefault(article.Id, 0);
            var title = _titles.GetValueOrDefault(article.Id);
            var named = !string.IsNullOrWhiteSpace(title);
            var ready = named && count > 0;

            <div class="photo-row @(_open == article.Id ? "open" : null)">
                <button class="photo-head" @onclick="() => ToggleAsync(article.Id)">
                    <span class="photo-tick @(ready ? "on" : null)">@(ready ? "✓" : "—")</span>
                    <span class="photo-name">
                        @* The shop name when it has one; otherwise the accountant's name, so the
                           row is still findable on the shelf while it waits to be named. *@
                        @if (named)
                        {
                            @title
                        }
                        else
                        {
                            <em class="muted">@article.Name</em>
                        }
                        <span class="muted">@article.Barcode · @article.SalesPrice.ToString("0.00") € ·
                            @(article.StockQuantity > 0 ? $"{article.StockQuantity:0.##} copë" : "s'ka gjendje")</span>
                    </span>
                    <span class="photo-need">
                        @if (!named)
                        {
                            <span class="badge warn">pa emër</span>
                        }
                        @if (count == 0)
                        {
                            <span class="badge warn">pa foto</span>
                        }
                        @if (ready)
                        {
                            <span class="muted">@count foto</span>
                        }
                    </span>
                </button>

                @if (_open == article.Id)
                {
                    <div class="photo-body">
                        <div class="photo-name-edit">
                            <label>
                                Emri për klientin
                                <input @bind="_title" maxlength="200"
                                       placeholder="p.sh. Kamion druri, i kuq" />
                            </label>
                            <label>
                                Përshkrimi <span class="muted">(opsional)</span>
                                <textarea @bind="_description" maxlength="2000" rows="2"
                                          placeholder="Nga çka është bërë, madhësia, për çfarë moshe…"></textarea>
                            </label>
                            <div class="row" style="gap:8px;align-items:center">
                                <button class="btn-primary" disabled="@_busy" @onclick="() => SaveListingAsync(article.Id)">
                                    Ruaj emrin
                                </button>
                                @if (_saved == article.Id)
                                {
                                    <span class="muted small">U ruajt.</span>
                                }
                                <span class="muted small">Emri në kontabilitet mbetet "@article.Name".</span>
                            </div>
                        </div>

                        @if (_current.Count > 0)
                        {
                            <div class="photo-strip">
                                @foreach (var photo in _current)
                                {
                                    <figure class="@(photo.SortOrder == 0 ? "main" : null)">
                                        <img src="@photo.Url" alt="" />
                                        <figcaption>
                                            @if (photo.SortOrder == 0)
                                            {
                                                <span class="badge">Kryesore</span>
                                            }
                                            else
                                            {
                                                <button class="link" @onclick="() => MakeMainAsync(photo.Id)">Bëje kryesore</button>
                                            }
                                            <button class="link danger" @onclick="() => DeleteAsync(photo.Id)">Fshij</button>
                                        </figcaption>
                                    </figure>
                                }
                            </div>
                        }

                        @if (_current.Count < ArticlePhoto.MaxPerArticle)
                        {
                            <div class="photo-add">
                                <div class="row" style="gap:8px">
                                    <input @bind="_url" placeholder="Ngjit adresën e fotos (https://…)" style="flex:1" />
                                    <button class="btn-primary" disabled="@_busy" @onclick="() => AddUrlAsync(article.Id)">
                                        Shto nga adresa
                                    </button>
                                </div>

                                @* capture="environment" opens the rear camera straight from the phone,
                                   which is how these 74 photos are actually going to get taken. *@
                                <InputFile OnChange="@(e => UploadAsync(article.Id, e))" accept="image/*" capture="environment" multiple />

                                @if (BarcodeImageLookup.IsValidEan(article.Barcode))
                                {
                                    <button class="btn-ghost" disabled="@_busy" @onclick="() => LookupAsync(article.Barcode!)">
                                        Kërko foto sipas barkodit
                                    </button>
                                }
                                else
                                {
                                    @* Said plainly, because it is the whole reason this screen is
                                       manual: without a real barcode there is nothing to look the
                                       product up BY. The name is "Loder 0115012". *@
                                    <p class="muted small">
                                        Ky artikull nuk ka barkod të vlefshëm (EAN), prandaj foto nuk mund të kërkohet
                                        automatikisht — duhet ngarkuar ose ngjitur adresa.
                                    </p>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="muted small">Ky artikull ka maksimumin e fotove.</p>
                        }

                        @if (_candidates.Count > 0)
                        {
                            <div class="photo-candidates">
                                <h3>Propozime nga barkodi</h3>
                                @foreach (var candidate in _candidates)
                                {
                                    <p class="muted small">@candidate.Title @(candidate.Brand is null ? "" : $"· {candidate.Brand}") · @candidate.Source</p>
                                    <div class="photo-strip">
                                        @foreach (var image in candidate.Images)
                                        {
                                            <figure>
                                                <img src="@image" alt="" />
                                                <figcaption>
                                                    <button class="link" disabled="@_busy" @onclick="() => AddCandidateAsync(article.Id, image)">
                                                        Shto këtë
                                                    </button>
                                                </figcaption>
                                            </figure>
                                        }
                                    </div>
                                }
                                <p class="muted small">
                                    Kontrollojeni foton para se ta shtoni — barkodi mund t'i përkasë një varianti tjetër.
                                </p>
                            </div>
                        }
                        else if (_searchedBarcode)
                        {
                            <p class="muted small">Asnjë foto nuk u gjet për këtë barkod.</p>
                        }

                        @if (_error is not null)
                        {
                            <p class="error">@_error</p>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (!Filtered().Any())
    {
        <p class="muted">Asnjë artikull nuk përputhet.</p>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Article> _articles = [];
    private Dictionary<long, int> _counts = [];
    private Dictionary<long, string> _titles = [];
    private List<ArticlePhoto> _current = [];
    private List<BarcodeCandidate> _candidates = [];

    private long? _open;
    private long? _saved;
    private string _search = "";
    private bool _onlyMissing = true;   // the default, because this screen exists to fill the gaps
    private bool _onlyInStock = true;   // and the in-stock ones are the only ones that can be sold today
    private bool _loading = true;
    private bool _busy;
    private bool _searchedBarcode;
    private string _url = "";
    private string _title = "";
    private string _description = "";
    private string _userName = "";
    private string? _error;

    private int _total;
    private int _ready;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _userName = user.FindFirst(AuthService.FullNameClaim)?.Value ?? user.Identity?.Name ?? "";
        }

        _articles = await Catalog.GetAllArticlesAsync();
        await RefreshCountsAsync();
        _loading = false;
    }

    private async Task RefreshCountsAsync()
    {
        _counts = await Library.CountsAsync();
        _titles = await Listings.TitlesAsync();
        _total = _articles.Count;
        // Ready means "on the website": both halves, exactly as ShopService decides it.
        _ready = _articles.Count(a => _counts.ContainsKey(a.Id) && _titles.ContainsKey(a.Id));
    }

    private bool IsReady(Article a) => _counts.ContainsKey(a.Id) && _titles.ContainsKey(a.Id);

    private IEnumerable<Article> Filtered()
    {
        IEnumerable<Article> query = _articles;

        if (_onlyInStock)
            query = query.Where(a => a.StockQuantity > 0);

        if (_onlyMissing)
            query = query.Where(a => !IsReady(a));

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var needle = _search.Trim();
            query = query.Where(a =>
                a.Name.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                a.Barcode.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                (_titles.GetValueOrDefault(a.Id) ?? "").Contains(needle, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderByDescending(a => a.StockQuantity);
    }

    private async Task ToggleAsync(long id)
    {
        _error = null;
        _candidates = [];
        _searchedBarcode = false;
        _url = "";
        _saved = null;

        if (_open == id)
        {
            _open = null;
            return;
        }

        _open = id;
        _current = await Library.GetForArticleAsync(id);

        var listing = await Listings.GetAsync(id);
        _title = listing?.Title ?? "";
        _description = listing?.Description ?? "";
    }

    private async Task SaveListingAsync(long articleId)
    {
        _busy = true;
        _error = null;
        try
        {
            await Listings.SaveAsync(articleId, _title, _description, _userName);
            _saved = articleId;
            await RefreshCountsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task ReloadAsync(long articleId)
    {
        _current = await Library.GetForArticleAsync(articleId);
        await RefreshCountsAsync();
    }

    private async Task AddUrlAsync(long articleId)
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Library.AddFromUrlAsync(articleId, _url);
            if (!result.Ok) { _error = result.Error; return; }

            _url = "";
            await ReloadAsync(articleId);
        }
        finally { _busy = false; }
    }

    private async Task AddCandidateAsync(long articleId, string imageUrl)
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Library.AddFromUrlAsync(articleId, imageUrl);
            if (!result.Ok) { _error = result.Error; return; }

            await ReloadAsync(articleId);
        }
        finally { _busy = false; }
    }

    private async Task UploadAsync(long articleId, InputFileChangeEventArgs e)
    {
        _busy = true;
        _error = null;
        try
        {
            foreach (var file in e.GetMultipleFiles(ArticlePhoto.MaxPerArticle))
            {
                await using var stream = file.OpenReadStream(PhotoService.MaxBytes);
                var result = await Library.AddFromUploadAsync(articleId, stream, file.Name, file.ContentType);
                if (!result.Ok) { _error = result.Error; break; }
            }

            await ReloadAsync(articleId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task LookupAsync(string barcode)
    {
        _busy = true;
        _error = null;
        _candidates = [];
        try
        {
            _candidates = (await Barcodes.LookupAsync(barcode)).ToList();
            _searchedBarcode = true;
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(int photoId)
    {
        if (_open is not long articleId) return;

        await Library.DeleteAsync(photoId);
        await ReloadAsync(articleId);
    }

    private async Task MakeMainAsync(int photoId)
    {
        if (_open is not long articleId) return;

        await Library.MakeMainAsync(photoId);
        await ReloadAsync(articleId);
    }
}
