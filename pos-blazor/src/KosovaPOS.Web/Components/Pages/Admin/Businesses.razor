@page "/admin/bizneset"
@attribute [Authorize(Policy = AuthService.PlatformPolicy)]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using KosovaPOS.Core.Data
@using KosovaPOS.Core.Services
@using KosovaPOS.Models.Control
@inject BusinessRegistry Registry
@inject BusinessProvisioner Provisioner
@inject BusinessHostResolver Hosts

<PageTitle>Bizneset — Platforma</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Bizneset</h1>
            <span class="muted">Çdo biznes ka bazën e vet të të dhënave.</span>
        </div>
        <button class="btn-primary btn-lg" @onclick="() => _showCreate = !_showCreate">
            @(_showCreate ? "Mbyll" : "+ Biznes i ri")
        </button>
    </header>

    @if (_created is not null)
    {
        <div class="card" style="border-left:4px solid var(--ok, #2e7d32)">
            <h3>Biznesi "@_created.Business.Name" u krijua.</h3>
            <p class="muted">Kodi i kyçjes: <strong>@_created.Business.Code</strong> · Baza: <code>@_created.Business.DatabaseName</code></p>
            <p>Adresa: <a href="@Hosts.UrlForCode(_created.Business.Code)" target="_blank" rel="noopener">@Hosts.HostForCode(_created.Business.Code)</a></p>
            @if (_created.GeneratedAdminPassword is not null)
            {
                <p>
                    Fjalëkalimi i administratorit — <strong>shfaqet vetëm një herë</strong>:
                    <code>@_created.GeneratedAdminPassword</code>
                </p>
            }
            @if (_created.AdoptedExistingDatabase)
            {
                <p class="error">
                    Kujdes: baza <code>@_created.Business.DatabaseName</code> ekzistonte më parë dhe u përdor ashtu siç ishte.
                </p>
            }
        </div>
    }

    @if (_showCreate)
    {
        <div class="card">
            <h3>Biznes i ri</h3>
            <EditForm Model="Form" OnValidSubmit="Create" FormName="create-business">
                <div class="field">
                    <label>Emri</label>
                    <InputText @bind-Value="Form.Name" class="input" />
                </div>
                <div class="field">
                    <label>Kodi i kyçjes</label>
                    <InputText @bind-Value="Form.Code" class="input" autocapitalize="off" spellcheck="false" />
                    <small class="muted">
                        Shkronja të vogla, shifra dhe nënvijë. Baza do të quhet <code>pos_@(Form.Code)</code>.
                    </small>
                </div>
                <div class="field">
                    <label>Administratori i parë</label>
                    <InputText @bind-Value="Form.AdminUsername" class="input" autocapitalize="off" />
                    <small class="muted">Fjalëkalimi gjenerohet dhe shfaqet një herë.</small>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="error">@_error</div>
                }

                <button type="submit" class="btn-primary" disabled="@_busy">
                    @(_busy ? "Duke krijuar…" : "Krijo")
                </button>
            </EditForm>
        </div>
    }

    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th>Emri</th>
                    <th>Kodi</th>
                    <th>Adresa</th>
                    <th>Baza e të dhënave</th>
                    <th>Statusi</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in _businesses)
                {
                    <tr>
                        <td>@b.Name</td>
                        <td><code>@b.Code</code></td>
                        <td><a href="@Hosts.UrlForCode(b.Code)" target="_blank" rel="noopener">@Hosts.HostForCode(b.Code)</a></td>
                        <td><code>@b.DatabaseName</code></td>
                        <td>@(b.IsActive ? "Aktiv" : "Joaktiv")</td>
                        <td>
                            <button class="btn-ghost" @onclick="() => Toggle(b)" disabled="@_busy">
                                @(b.IsActive ? "Çaktivizo" : "Aktivizo")
                            </button>
                        </td>
                    </tr>
                }
                @if (_businesses.Count == 0)
                {
                    <tr><td colspan="6" class="muted">Asnjë biznes.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private IReadOnlyList<Business> _businesses = [];
    private CreateForm Form { get; set; } = new();
    private ProvisionResult? _created;
    private string? _error;
    private bool _showCreate;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await Reload();

    // Uncached: the registry's snapshot deliberately hides deactivated businesses,
    // and this is the one screen that must show them.
    private async Task Reload() => _businesses = await Registry.ListAllUncachedAsync();

    private async Task Create()
    {
        _busy = true;
        _error = null;
        _created = null;
        try
        {
            _created = await Provisioner.CreateBusinessAsync(Form.Code, Form.Name, Form.AdminUsername);
            Form = new CreateForm();
            _showCreate = false;
            await Reload();
        }
        catch (Exception e) when (e is ArgumentException or InvalidOperationException)
        {
            _error = e.Message;
        }
        catch (Exception e)
        {
            // Provisioning touches CREATE DATABASE and a migration run; surface the
            // real reason rather than a blank screen, because the operator is the
            // only person who can fix it.
            _error = $"Krijimi dështoi: {e.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Toggle(Business b)
    {
        _busy = true;
        try
        {
            await Registry.SetActiveAsync(b.Id, !b.IsActive);
            await Reload();
        }
        finally
        {
            _busy = false;
        }
    }

    public class CreateForm
    {
        public string Name { get; set; } = "";
        public string Code { get; set; } = "";
        public string AdminUsername { get; set; } = "";
    }
}
