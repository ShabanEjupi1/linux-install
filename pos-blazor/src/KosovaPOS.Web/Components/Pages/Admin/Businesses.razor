@page "/admin/bizneset"
@attribute [Authorize(Policy = AuthService.PlatformPolicy)]
@rendermode RenderModes.Interactive
@using Microsoft.AspNetCore.Authorization
@using KosovaPOS.Core.Data
@using KosovaPOS.Core.Services
@using KosovaPOS.Models.Control
@using Microsoft.AspNetCore.Components.Authorization
@using KosovaPOS.Web.Services
@inject BusinessRegistry Registry
@inject BusinessProvisioner Provisioner
@inject BusinessHostResolver Hosts
@inject AuditService AuditLog
@inject Audit Audit

<PageTitle>Bizneset — Platforma</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Bizneset</h1>
            <span class="muted">Çdo biznes ka bazën e vet të të dhënave.</span>
        </div>
        <button class="btn-primary btn-lg" @onclick="() => _showCreate = !_showCreate">
            @(_showCreate ? "Mbyll" : "+ Biznes i ri")
        </button>
    </header>

    @if (_created is not null)
    {
        <div class="card" style="border-left:4px solid var(--ok, #2e7d32)">
            <h3>Biznesi "@_created.Business.Name" u krijua.</h3>
            <p class="muted">Kodi i kyçjes: <strong>@_created.Business.Code</strong> · Baza: <code>@_created.Business.DatabaseName</code></p>
            <p>Adresa: <a href="@Hosts.UrlForCode(_created.Business.Code)">@Hosts.HostForCode(_created.Business.Code)</a></p>
            @if (_created.GeneratedAdminPassword is not null)
            {
                <p>
                    Fjalëkalimi i administratorit — <strong>shfaqet vetëm një herë</strong>:
                    <code>@_created.GeneratedAdminPassword</code>
                </p>
            }
            @if (_created.AdoptedExistingDatabase)
            {
                <p class="error">
                    Kujdes: baza <code>@_created.Business.DatabaseName</code> ekzistonte më parë dhe u përdor ashtu siç ishte.
                </p>
            }
        </div>
    }

    @if (_showCreate)
    {
        <div class="card">
            <h3>Biznes i ri</h3>
            <EditForm Model="Form" OnValidSubmit="Create" FormName="create-business">
                <div class="field">
                    <label>Emri</label>
                    <InputText @bind-Value="Form.Name" class="input" />
                </div>
                <div class="field">
                    <label>Kodi i kyçjes</label>
                    <InputText @bind-Value="Form.Code" class="input" autocapitalize="off" spellcheck="false" />
                    <small class="muted">
                        Shkronja të vogla, shifra dhe nënvijë. Baza do të quhet <code>pos_@(Form.Code)</code>.
                    </small>
                </div>
                <div class="field">
                    <label>Administratori i parë</label>
                    <InputText @bind-Value="Form.AdminUsername" class="input" autocapitalize="off" />
                    <small class="muted">Fjalëkalimi gjenerohet dhe shfaqet një herë.</small>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="error">@_error</div>
                }

                <button type="submit" class="btn-primary" disabled="@_busy">
                    @(_busy ? "Duke krijuar…" : "Krijo")
                </button>
            </EditForm>
        </div>
    }

    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th>Emri</th>
                    <th>Kodi</th>
                    <th>Adresa</th>
                    <th>Dyqani online</th>
                    <th>Baza e të dhënave</th>
                    <th>Statusi</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in _businesses)
                {
                    <tr>
                        <td>@b.Name</td>
                        <td><code>@b.Code</code></td>
                        <td><a href="@Hosts.UrlForCode(b.Code)">@Hosts.HostForCode(b.Code)</a></td>
                        <td>
                            @* The public domain the shop answers on. It lives in the control database
                               rather than the business's own settings because it is what CHOOSES the
                               database — it must resolve before any business row can be read. *@
                            <div class="row" style="gap:6px">
                                <input class="input mono" style="min-width:170px"
                                       value="@b.ShopDomain"
                                       @onchange="e => SetDomain(b, e.Value?.ToString())"
                                       placeholder="enisi.tech"
                                       autocapitalize="off" spellcheck="false" disabled="@_busy" />
                            </div>
                        </td>
                        <td><code>@b.DatabaseName</code></td>
                        <td>@(b.IsActive ? "Aktiv" : "Joaktiv")</td>
                        <td>
                            @if (b.IsActive)
                            {
                                <a class="btn-ghost" href="@($"/admin/imitim/{b.Id}")">Imito</a>
                            }
                            <button class="btn-ghost" @onclick="() => Toggle(b)" disabled="@_busy">
                                @(b.IsActive ? "Çaktivizo" : "Aktivizo")
                            </button>
                        </td>
                    </tr>
                }
                @if (_businesses.Count == 0)
                {
                    <tr><td colspan="7" class="muted">Asnjë biznes.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<Business> _businesses = [];
    private CreateForm Form { get; set; } = new();
    private ProvisionResult? _created;
    private string? _error;
    private bool _showCreate;
    private bool _busy;

    /// <summary>The platform operator these acts are recorded against.</summary>
    private string _operator = "?";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            _operator = (await AuthState).User.Identity?.Name ?? "?";

        await Reload();
    }

    // Uncached: the registry's snapshot deliberately hides deactivated businesses,
    // and this is the one screen that must show them.
    private async Task Reload() => _businesses = await Registry.ListAllUncachedAsync();

    private async Task Create()
    {
        _busy = true;
        _error = null;
        _created = null;
        try
        {
            _created = await Provisioner.CreateBusinessAsync(Form.Code, Form.Name, Form.AdminUsername);

            await AuditLog.WritePlatformAsync(_operator, AuditAction.BusinessCreate, _created.Business,
                targetUser: Form.AdminUsername, ip: Audit.IpAddress,
                details: _created.AdoptedExistingDatabase
                    ? $"Adoptoi bazën ekzistuese {_created.Business.DatabaseName}."
                    : $"Krijoi bazën {_created.Business.DatabaseName}.");

            Form = new CreateForm();
            _showCreate = false;
            await Reload();
        }
        catch (Exception e) when (e is ArgumentException or InvalidOperationException)
        {
            _error = e.Message;
        }
        catch (Exception e)
        {
            // Provisioning touches CREATE DATABASE and a migration run; surface the
            // real reason rather than a blank screen, because the operator is the
            // only person who can fix it.
            _error = $"Krijimi dështoi: {e.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Toggle(Business b)
    {
        _busy = true;
        try
        {
            // Read before the write, not after: b comes from an AsNoTracking list so it
            // happens to keep the old value today, but a log line whose wording depends
            // on a field staying stale is one refactor away from saying the opposite of
            // what happened.
            var activating = !b.IsActive;

            await Registry.SetActiveAsync(b.Id, activating);

            // Deactivation locks every user of a shop out within the registry's TTL.
            // It is the most disruptive button on the platform; it does not get to be
            // the only one that leaves no trace.
            await AuditLog.WritePlatformAsync(_operator, AuditAction.BusinessUpdate, b,
                ip: Audit.IpAddress,
                details: activating ? "Biznesi u aktivizua." : "Biznesi u çaktivizua.");

            await Reload();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Points a business's public shop at a domain, or clears it. Audited like every other
    /// write here: this one line decides which shop the whole internet sees at enisi.tech,
    /// and a silent change to it would be indistinguishable from a hijack.
    /// </summary>
    private async Task SetDomain(Business b, string? domain)
    {
        var normalised = BusinessRegistry.NormaliseShopDomain(domain);
        if (normalised == b.ShopDomain)
            return;

        _busy = true;
        try
        {
            await Registry.SetShopDomainAsync(b.Id, normalised);

            await AuditLog.WritePlatformAsync(_operator, AuditAction.BusinessUpdate, b,
                ip: Audit.IpAddress,
                details: normalised is null
                    ? "Domeni i dyqanit online u hoq."
                    : $"Dyqani online u lidh me {normalised}.");

            await Reload();
        }
        finally
        {
            _busy = false;
        }
    }

    public class CreateForm
    {
        public string Name { get; set; } = "";
        public string Code { get; set; } = "";
        public string AdminUsername { get; set; } = "";
    }
}
