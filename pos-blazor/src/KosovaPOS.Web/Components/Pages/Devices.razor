@page "/pajisjet"
@attribute [Authorize(Policy = "perm:settings")]
@rendermode InteractiveServer
@using KosovaPOS.Core.Printing
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject BusinessProfileService Profile
@inject HardwareBridge Hw
@inject AgentPackage Package
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Everything a shop PC needs to print without a print dialog, served from the POS itself.
   Nothing is copied to the cashier PC by hand: this page hands out the agent and the exact
   command to install it, with THIS shop's address and printer names already in it. *@

<PageTitle>Pajisjet — KosovaPOS</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Pajisjet e këtij kompjuteri</h1>
            <span class="muted">Instalo agjentin që printon pa dialog printimi.</span>
        </div>
        <span class="agent-badge @(_agentOnline ? (_agentReal ? "on" : "mock") : "off")" title="@_agentTitle">
            <span class="dot"></span>@(_agentOnline ? (_agentReal ? "Pajisje" : "Pajisje (test)") : "Pa pajisje")
        </span>
    </header>

    @if (AgentOutdated)
    {
        <div class="sale-msg err">
            Agjenti i instaluar këtu është versioni <strong>@_agentVersion</strong>, ndërsa ky server
            shpërndan <strong>@Package.Version</strong>. Një agjent i vjetër printon gabimisht
            <strong>ë</strong> dhe <strong>ç</strong> (dhe nuk lajmëron për këtë) dhe e shtyp çmimin
            e etiketës të vogël. Ekzekuto përsëri komandën e instalimit më poshtë — e zëvendëson
            atë të vjetrin, pa e çinstaluar.
        </div>
    }

    @if (_agentOnline)
    {
        <div class="sale-msg ok">
            Agjenti është i instaluar në këtë kompjuter@(_agentVersion is null ? "" : $" (versioni {_agentVersion})").
            Kuponat dhe etiketat printohen drejtpërdrejt te printerët, <strong>pa dialog printimi</strong>.
            @if (!_agentReal)
            {
                <text>
                    Por është në <strong>modalitet testi</strong> — asgjë nuk shkon te pajisjet reale.
                    Ekzekuto komandën më poshtë edhe një herë, pa <code>-Mock</code>.
                </text>
            }
        </div>
    }
    else
    {
        <div class="sale-msg err">
            Agjenti nuk po përgjigjet në këtë kompjuter, prandaj printimi kalon nëpër shfletuesin,
            i cili hap dialogun e printimit në çdo shitje. Ndiq hapat më poshtë.
        </div>
    }

    <h2 class="section-title">1. Zgjidh printerët</h2>

    @if (_printers is not null)
    {
        @* The agent is here, so the PC's real printers can be listed. Picking beats typing:
           a mistyped Windows printer name fails silently and looks exactly like a printer
           that is switched off. *@
        <p class="muted setup-p">
            Printerët e instaluar në këtë kompjuter. Zgjedhja ruhet për gjithë biznesin dhe
            zbatohet menjëherë — agjenti nuk ka nevojë të riinstalohet.
        </p>
        <div class="setup-grid">
            <label>Printeri i kuponave (80mm)
                <select @bind="_receiptPrinter">
                    <option value="">— printeri i parazgjedhur i Windows-it —</option>
                    @foreach (var p in _printers.Printers)
                    {
                        <option value="@p">@p @(p == _printers.Default ? "(parazgjedhur)" : "")</option>
                    }
                </select>
            </label>
            <label>Printeri i etiketave
                <select @bind="_barcodePrinter">
                    <option value="">— printeri i parazgjedhur i Windows-it —</option>
                    @foreach (var p in _printers.Printers)
                    {
                        <option value="@p">@p @(p == _printers.Default ? "(parazgjedhur)" : "")</option>
                    }
                </select>
            </label>
            <button class="btn-primary" @onclick="SavePrinters" disabled="@_saving">
                @(_saving ? "Duke ruajtur…" : "Ruaj")
            </button>
            <button class="btn-ghost" @onclick="TestPrint" disabled="@_saving">🧾 Provo kuponin</button>
            <button class="btn-ghost" @onclick="TestLabel" disabled="@_saving">🏷️ Provo etiketën</button>
        </div>
    }
    else
    {
        @* No agent on this PC (or an older one, before /printers existed): the list cannot be
           read, so fall back to typing the names. *@
        <p class="muted setup-p">
            Agjenti nuk po përgjigjet, prandaj lista e printerëve nuk lexohet dot. Shkruaj emrat
            ashtu si duken te <em>Windows → Printers &amp; scanners</em>, ose instalo agjentin
            më poshtë dhe rifresko këtë faqe për t'i zgjedhur nga lista.
        </p>
        <div class="setup-grid">
            <label>Printeri i kuponave (80mm)
                <input @bind="_receiptPrinter" placeholder="p.sh. POS-80" />
            </label>
            <label>Printeri i etiketave
                <input @bind="_barcodePrinter" placeholder="p.sh. HPRT HT300" />
            </label>
            <button class="btn-primary" @onclick="SavePrinters" disabled="@_saving">
                @(_saving ? "Duke ruajtur…" : "Ruaj emrat")
            </button>
        </div>
    }

    @if (_saveMsg is not null)
    {
        <div class="sale-msg @(_saveOk ? "ok" : "err")">@_saveMsg</div>
    }

    <h2 class="section-title">2. Shkronjat shqipe (ë, ç) dhe etiketa</h2>

    @* A thermal printer decides for itself which code pages its firmware honours, and one that
       ignores the page it was told to use reports no error — it just prints δ where ë belongs.
       Nothing here can ask it. So the shop prints the sample, reads the paper, and picks the
       line that came out right. *@
    <p class="muted setup-p">
        Nëse kuponi shtyp <code>δ</code> ose <code>?</code> në vend të <strong>ë</strong> dhe
        <strong>ç</strong>, printeri nuk e njeh kodimin e zgjedhur. Shtyp
        <em>Provo kodimin</em>: printohet nga një rresht për çdo kodim, secili i shënuar me
        numrin e vet. Shiko letrën, gjej rreshtin ku <strong>Ë ë Ç ç</strong> duken saktë, dhe
        zgjidh atë numër këtu.
    </p>

    <div class="setup-grid">
        <label>Kodimi i kuponit
            <select @bind="_codePage">
                @foreach (var opt in ReceiptCodePages.All)
                {
                    <option value="@opt.Value">@opt.Label</option>
                }
            </select>
        </label>
        <label>Etiketa — gjerësia (mm)
            <input type="number" min="20" max="200" @bind="_labelW" />
        </label>
        <label>Etiketa — lartësia (mm)
            <input type="number" min="10" max="200" @bind="_labelH" />
        </label>
        <button class="btn-primary" @onclick="SavePrinters" disabled="@_saving">
            @(_saving ? "Duke ruajtur…" : "Ruaj")
        </button>
        <button class="btn-ghost" @onclick="TestCodePages" disabled="@(_saving || !_agentOnline)">
            🔤 Provo kodimin
        </button>
    </div>

    <h2 class="section-title">3. Printeri fiskal</h2>
    <p class="muted setup-p">
        Printeri fiskal mban një kopje të vetën të artikujve dhe refuzon një shitje kur emri ose
        grupi i TVSH-së nuk përputhet me atë që ka ai në memorie — prandaj pas ndryshimit të një
        çmimi mund të bllokohet. Pastrimi i memories e zhbllokon; artikujt e POS-it nuk preken.
        Arkëtarët e kanë të njëjtin buton te <a href="/arka">Arka</a>.
    </p>
    <div class="modal-actions">
        <ClearFiscalArticles ButtonClass="btn-ghost" />
    </div>

    <h2 class="section-title">4. Instalo agjentin në këtë kompjuter</h2>

    @if (!Package.Available)
    {
        <div class="sale-msg err">
            Paketa e agjentit nuk është e ngarkuar në këtë server. Ndërtoje me
            <code>tools/build-release.sh</code> dhe ridepoloje.
        </div>
    }
    else
    {
        <p class="muted setup-p">
            Hap <strong>PowerShell si Administrator</strong> në kompjuterin e arkës (jo këtu, nëse je
            larg tij), dhe ngjit këtë komandë. E shkarkon agjentin nga ky server, e instalon si shërbim
            të Windows-it dhe e nis vetë.
        </p>

        <pre class="setup-cmd">@InstallCommand</pre>

        <div class="modal-actions">
            <button class="btn-primary" @onclick="CopyCommand">📋 Kopjo komandën</button>
            <a class="btn-ghost" href="/shkarko/agjenti.zip">
                ⬇️ Shkarko paketën (@Package.SizeMb.ToString("0") MB@(Package.Version is null ? "" : $", v{Package.Version}"))
            </a>
            <button class="btn-ghost" @onclick="RefreshAgentStatusAsync">Kontrollo agjentin</button>
        </div>

        <p class="muted setup-p">
            Pas instalimit, rifresko këtë faqe: shenja lart duhet të kthehet në <strong>Pajisje</strong>.
            Për një provë pa prekur pajisjet reale, shto <code>-Mock</code> në fund të komandës.
        </p>
    }

    <h2 class="section-title">5. Nëse agjenti nuk mund të instalohet</h2>
    <p class="muted setup-p">
        Pa agjent, printimi bëhet nga shfletuesi — dhe asnjë faqe interneti nuk mund ta mbyllë
        dialogun e printimit të Chrome-it. Chrome-i vetë mundet: kjo shkurtore e hap POS-in me
        <code>--kiosk-printing</code>, dhe printimi bëhet menjëherë, pa dialog.
    </p>
    <div class="sale-msg err">
        Kujdes: kiosk-printing printon <strong>gjithmonë te printeri i parazgjedhur i Windows-it</strong> —
        faqja nuk e zgjedh dot. Me dy printerë (kupona + etiketa) vetëm njëri merr letrën e duhur,
        dhe fatura A4 do të dalë në rrotullën termike. Përdore vetëm si zgjidhje kalimtare.
    </div>
    @if (Package.Available)
    {
        <div class="modal-actions">
            <a class="btn-ghost" href="/shkarko/kiosk.ps1">⬇️ kiosk-shortcut.ps1</a>
        </div>
    }
</div>

@code {
    private BusinessSettings? _shop;
    private string? _receiptPrinter, _barcodePrinter;
    private string _codePage = ReceiptCodePages.Default;
    private int _labelW = 55, _labelH = 25;
    private KosovaPOS.Agent.Contracts.PrinterList? _printers;
    private bool _saving, _saveOk;
    private string? _saveMsg;

    private bool _agentOnline, _agentReal;
    private string? _agentVersion;
    private string _agentTitle = "Agjenti i pajisjeve nuk është kontrolluar ende";

    /// <summary>
    /// The installed agent is older than the package this server hands out. Worth saying out
    /// loud: an agent from before the code-page fix prints δ for every ë and cannot be told
    /// otherwise, and nothing in its behaviour reveals that it is out of date — it prints, the
    /// letters are just wrong.
    /// </summary>
    private bool AgentOutdated =>
        _agentOnline && _agentVersion is { Length: > 0 } installed && Package.Version is { Length: > 0 } shipped &&
        Version.TryParse(installed, out var i) && Version.TryParse(shipped, out var s) && i < s;

    /// <summary>
    /// The command the shop actually pastes. It carries THIS host — a shop on its own
    /// subdomain must not install an agent that only trusts the apex, or the browser's call
    /// to 127.0.0.1 is refused by the agent's CORS policy.
    /// </summary>
    private string InstallCommand
    {
        get
        {
            var origin = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
            var cmd = $"irm {origin}/shkarko/instalo.ps1 -OutFile \"$env:TEMP\\instalo.ps1\"; " +
                      $"& \"$env:TEMP\\instalo.ps1\" -PosUrl \"{origin}\"";

            if (!string.IsNullOrWhiteSpace(_receiptPrinter))
                cmd += $" -ReceiptPrinter \"{_receiptPrinter}\"";
            if (!string.IsNullOrWhiteSpace(_barcodePrinter))
                cmd += $" -BarcodePrinter \"{_barcodePrinter}\"";

            return cmd;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _shop = await Profile.GetSettingsAsync();
        _receiptPrinter = _shop?.ReceiptPrinter;
        _barcodePrinter = _shop?.BarcodePrinter;
        _codePage = string.IsNullOrWhiteSpace(_shop?.ReceiptCodePage) ? ReceiptCodePages.Default : _shop!.ReceiptCodePage;
        _labelW = _shop?.LabelWidthMm is > 0 ? _shop.LabelWidthMm : 55;
        _labelH = _shop?.LabelHeightMm is > 0 ? _shop.LabelHeightMm : 25;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshAgentStatusAsync();
        StateHasChanged();
    }

    private async Task RefreshAgentStatusAsync()
    {
        var health = await Hw.GetHealthAsync();
        _agentOnline = health is not null;
        _agentReal = health?.RealHardware ?? false;
        _agentVersion = health?.Version;
        _agentTitle = health is null
            ? "Agjenti i pajisjeve nuk po përgjigjet"
            : $"{(health.RealHardware ? "pajisje reale" : "modaliteti test")}";

        _printers = _agentOnline ? await Hw.GetPrintersAsync() : null;
    }

    private async Task TestPrint()
    {
        _saving = true;
        try
        {
            var r = await Hw.PrintTestReceiptAsync();
            _saveOk = r.Ok;
            _saveMsg = r.Ok
                ? "Prova u dërgua te printeri i kuponave."
                : $"Prova dështoi: {r.Error}";
        }
        finally { _saving = false; }
    }

    private async Task TestLabel()
    {
        _saving = true;
        try
        {
            var r = await Hw.PrintTestLabelAsync();
            _saveOk = r.Ok;
            _saveMsg = r.Ok
                ? $"U dërgua një etiketë provë ({_labelW}×{_labelH} mm). Skanoje: barkodi duhet të lexohet."
                : $"Prova dështoi: {r.Error}";
        }
        finally { _saving = false; }
    }

    /// <summary>
    /// Prints the encoding sample: the same "Ë ë Ç ç" under every code page we can select, each
    /// line labelled with the page that printed it. The shop reads the paper — this is the only
    /// place the answer exists, because a printer that ignores a code page does not say so.
    /// </summary>
    private async Task TestCodePages()
    {
        _saving = true;
        try
        {
            var r = await Hw.PrintCodePageSampleAsync();
            _saveOk = r.Ok;
            _saveMsg = r.Ok
                ? "Prova u printua. Gjej rreshtin ku Ë ë Ç ç duken saktë dhe zgjidh atë kodim më sipër."
                : $"Prova dështoi: {r.Error}";
        }
        finally { _saving = false; }
    }

    /// <summary>
    /// Saves through the settings row we loaded, not a fresh one: SaveSettingsAsync copies
    /// every field it is handed, so a blank object would wipe the shop's name and fiscal
    /// numbers on its way to changing two printer names.
    /// </summary>
    private async Task SavePrinters()
    {
        _saving = true;
        _saveMsg = null;
        try
        {
            var shop = _shop ??= await Profile.GetSettingsAsync();
            shop.ReceiptPrinter = _receiptPrinter;
            shop.BarcodePrinter = _barcodePrinter;
            shop.ReceiptCodePage = _codePage;
            shop.LabelWidthMm = Math.Clamp(_labelW, 20, 200);
            shop.LabelHeightMm = Math.Clamp(_labelH, 10, 200);

            await Profile.SaveSettingsAsync(shop);
            _saveOk = true;
            // The POS sends the printer name with every print job, so this takes effect on the
            // next sale — the agent is not reconfigured and does not need reinstalling.
            _saveMsg = "U ruajt. Zbatohet menjëherë, pa riinstalim të agjentit.";
        }
        finally { _saving = false; }
    }

    private async Task CopyCommand() =>
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", InstallCommand);
}
