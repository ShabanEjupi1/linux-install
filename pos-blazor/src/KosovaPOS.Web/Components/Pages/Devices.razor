@page "/pajisjet"
@attribute [Authorize(Policy = "perm:settings")]
@rendermode InteractiveServer
@using KosovaPOS.Core.Printing
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject BusinessProfileService Profile
@inject HardwareBridge Hw
@inject AgentPackage Package
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Everything a shop PC needs to print without a print dialog, served from the POS itself.
   Nothing is copied to the cashier PC by hand: this page hands out the agent and the exact
   command to install it, with THIS shop's address and printer names already in it. *@

<PageTitle>Pajisjet — KosovaPOS</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Pajisjet e këtij kompjuteri</h1>
            <span class="muted">Instalo agjentin që printon pa dialog printimi.</span>
        </div>
        <span class="agent-badge @(_agentOnline ? (_agentReal ? "on" : "mock") : "off")" title="@_agentTitle">
            <span class="dot"></span>@(_agentOnline ? (_agentReal ? "Pajisje" : "Pajisje (test)") : "Pa pajisje")
        </span>
    </header>

    @if (AgentOutdated)
    {
        <div class="sale-msg err">
            Agjenti i instaluar këtu është versioni <strong>@_agentVersion</strong>, ndërsa ky server
            shpërndan <strong>@Package.Version</strong>. Një agjent i vjetër nuk di të printojë
            <strong>faturën A4</strong> te printeri i zgjedhur (e printon shfletuesi, te printeri i
            parazgjedhur i Windows-it) dhe shtyp gabimisht <strong>ë</strong> dhe <strong>ç</strong>.
            Ekzekuto përsëri komandën e instalimit më poshtë — e zëvendëson atë të vjetrin, pa e çinstaluar.
        </div>
    }

    @if (_agentOnline)
    {
        <div class="sale-msg ok">
            Agjenti është i instaluar në këtë kompjuter@(_agentVersion is null ? "" : $" (versioni {_agentVersion})").
            Kuponat, etiketat dhe faturat A4 printohen drejtpërdrejt te printerët e zgjedhur,
            <strong>pa dialog printimi</strong>.
            @if (!_agentReal)
            {
                <text>
                    Por është në <strong>modalitet testi</strong> — asgjë nuk shkon te pajisjet reale.
                    Ekzekuto komandën më poshtë edhe një herë, pa <code>-Mock</code>.
                </text>
            }
        </div>
    }
    else
    {
        <div class="sale-msg err">
            Agjenti nuk po përgjigjet në këtë kompjuter, prandaj printimi kalon nëpër shfletuesin,
            i cili hap dialogun e printimit në çdo shitje dhe <strong>nuk e zgjedh dot printerin</strong>.
            Ndiq hapat më poshtë.
        </div>
    }

    <h2 class="section-title">1. Zgjidh printerët</h2>

    @* Tri printerë, tri letra të ndryshme: rrotulla termike, etiketa, dhe A4-shi. Fatura A4 e
       dërguar te printeri i kuponave del si një metër letër termike — prandaj ka printerin e vet. *@
    <p class="muted setup-p">
        Zgjedhja ruhet për gjithë biznesin dhe zbatohet menjëherë — agjenti nuk ka nevojë të
        riinstalohet. Të njëjtat cilësime gjenden edhe te <a href="/cilesimet">Cilësimet</a>.
    </p>

    <PrinterSetup OnSaved="OnPrintersSaved" />

    <h2 class="section-title">2. Shkronjat shqipe (ë, ç)</h2>

    @* A thermal printer decides for itself which code pages its firmware honours, and one that
       ignores the page it was told to use reports no error — it just prints δ where ë belongs.
       Nothing here can ask it. So the shop prints the sample, reads the paper, and picks the
       line that came out right. *@
    <p class="muted setup-p">
        Nëse kuponi shtyp <code>δ</code> ose <code>?</code> në vend të <strong>ë</strong> dhe
        <strong>ç</strong>, printeri nuk e njeh kodimin e zgjedhur. Shtyp
        <em>Provo kodimin</em> më sipër: printohet nga një rresht për çdo kodim, secili i shënuar me
        numrin e vet. Shiko letrën, gjej rreshtin ku <strong>Ë ë Ç ç</strong> duken saktë, dhe
        zgjidh atë numër te <em>Kodimi i kuponit</em>.
    </p>

    <h2 class="section-title">3. Printeri fiskal</h2>
    <p class="muted setup-p">
        Printeri fiskal mban një kopje të vetën të artikujve dhe refuzon një shitje kur emri ose
        grupi i TVSH-së nuk përputhet me atë që ka ai në memorie — prandaj pas ndryshimit të një
        çmimi mund të bllokohet. Pastrimi i memories e zhbllokon; artikujt e POS-it nuk preken.
        Arkëtarët e kanë të njëjtin buton te <a href="/arka">Arka</a>.
    </p>
    <div class="modal-actions">
        <ClearFiscalArticles ButtonClass="btn-ghost" />
    </div>

    <h2 class="section-title">4. Instalo agjentin në këtë kompjuter</h2>

    @if (!Package.Available)
    {
        <div class="sale-msg err">
            Paketa e agjentit nuk është e ngarkuar në këtë server. Ndërtoje me
            <code>tools/build-release.sh</code> dhe ridepoloje.
        </div>
    }
    else
    {
        <p class="muted setup-p">
            Hap <strong>PowerShell si Administrator</strong> në kompjuterin e arkës (jo këtu, nëse je
            larg tij), dhe ngjit këtë komandë. E shkarkon agjentin nga ky server, e instalon si shërbim
            të Windows-it dhe e nis vetë.
        </p>

        <pre class="setup-cmd">@InstallCommand</pre>

        <div class="modal-actions">
            <button class="btn-primary" @onclick="CopyCommand">📋 Kopjo komandën</button>
            <button class="btn-ghost" @onclick="RefreshAgentStatusAsync">Kontrollo agjentin</button>
        </div>

        <p class="muted setup-p">
            Pas instalimit, rifresko këtë faqe: shenja lart duhet të kthehet në <strong>Pajisje</strong>.
            Për një provë pa prekur pajisjet reale, shto <code>-Mock</code> në fund të komandës.
        </p>

        <h3 class="section-title">Ose shkarko paketën dhe instaloje me dorë</h3>

        @* The plain zip needed hand-editing on the shop PC to know its POS and its printers, and
           the only place that knowledge exists is HERE. So the download is built per shop: it
           carries konfigurimi.env, and install-agent.ps1 reads it — no arguments, no editing. *@
        <p class="muted setup-p">
            Kjo paketë ndërtohet <strong>për këtë biznes</strong>: brenda saj shkon
            <code>konfigurimi.env</code> me adresën e këtij POS-i dhe emrat e printerëve që zgjodhe
            më sipër, si dhe udhëzimi <code>LEXOME.txt</code>. Shpaketoje, kliko me të djathtën mbi
            <code>instalo-ketu.cmd</code> → <em>Run as administrator</em>. Nuk ka çka të redaktohet.
        </p>
        <div class="modal-actions">
            <a class="btn-ghost" href="/shkarko/paketa-ime.zip">
                ⬇️ Shkarko paketën e këtij biznesi (@Package.SizeMb.ToString("0") MB@(Package.Version is null ? "" : $", v{Package.Version}"))
            </a>
            <a class="btn-ghost" href="/shkarko/agjenti.zip">⬇️ Paketa e thjeshtë (pa konfigurim)</a>
        </div>
    }

    <h2 class="section-title">5. Nëse agjenti nuk mund të instalohet</h2>
    <p class="muted setup-p">
        Pa agjent, printimi bëhet nga shfletuesi — dhe asnjë faqe interneti nuk mund ta mbyllë
        dialogun e printimit të Chrome-it. Chrome-i vetë mundet: kjo shkurtore e hap POS-in me
        <code>--kiosk-printing</code>, dhe printimi bëhet menjëherë, pa dialog.
    </p>
    <div class="sale-msg err">
        Kujdes: kiosk-printing printon <strong>gjithmonë te printeri i parazgjedhur i Windows-it</strong> —
        faqja nuk e zgjedh dot. Me tre printerë (kupona + etiketa + A4) vetëm njëri merr letrën e duhur,
        dhe fatura A4 do të dalë në rrotullën termike. Përdore vetëm si zgjidhje kalimtare.
    </div>
    @if (Package.Available)
    {
        <div class="modal-actions">
            <a class="btn-ghost" href="/shkarko/kiosk.ps1">⬇️ kiosk-shortcut.ps1</a>
        </div>
    }
</div>

@code {
    private BusinessSettings? _shop;

    private bool _agentOnline, _agentReal;
    private string? _agentVersion;
    private string _agentTitle = "Agjenti i pajisjeve nuk është kontrolluar ende";

    /// <summary>
    /// The installed agent is older than the package this server hands out. Worth saying out
    /// loud: an agent from before the A4 driver cannot print an invoice to the printer the shop
    /// chose — it falls back to the browser, and the browser prints to the Windows default. The
    /// invoice still comes out, just on the wrong paper, which is exactly the kind of failure
    /// nobody reports.
    /// </summary>
    private bool AgentOutdated =>
        _agentOnline && _agentVersion is { Length: > 0 } installed && Package.Version is { Length: > 0 } shipped &&
        Version.TryParse(installed, out var i) && Version.TryParse(shipped, out var s) && i < s;

    /// <summary>
    /// The command the shop actually pastes. It carries THIS host — a shop on its own
    /// subdomain must not install an agent that only trusts the apex, or the browser's call
    /// to 127.0.0.1 is refused by the agent's CORS policy.
    /// </summary>
    private string InstallCommand
    {
        get
        {
            var origin = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
            var cmd = $"irm {origin}/shkarko/instalo.ps1 -OutFile \"$env:TEMP\\instalo.ps1\"; " +
                      $"& \"$env:TEMP\\instalo.ps1\" -PosUrl \"{origin}\"";

            if (!string.IsNullOrWhiteSpace(_shop?.ReceiptPrinter))
                cmd += $" -ReceiptPrinter \"{_shop!.ReceiptPrinter}\"";
            if (!string.IsNullOrWhiteSpace(_shop?.BarcodePrinter))
                cmd += $" -BarcodePrinter \"{_shop!.BarcodePrinter}\"";
            if (!string.IsNullOrWhiteSpace(_shop?.InvoicePrinter))
                cmd += $" -InvoicePrinter \"{_shop!.InvoicePrinter}\"";

            return cmd;
        }
    }

    protected override async Task OnInitializedAsync() => _shop = await Profile.GetSettingsAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshAgentStatusAsync();
        StateHasChanged();
    }

    /// <summary>The install command quotes the printer names, so it has to be rebuilt when they change.</summary>
    private void OnPrintersSaved(BusinessSettings shop) => _shop = shop;

    private async Task RefreshAgentStatusAsync()
    {
        var health = await Hw.GetHealthAsync();
        _agentOnline = health is not null;
        _agentReal = health?.RealHardware ?? false;
        _agentVersion = health?.Version;
        _agentTitle = health is null
            ? "Agjenti i pajisjeve nuk po përgjigjet"
            : $"{(health.RealHardware ? "pajisje reale" : "modaliteti test")}";
    }

    private async Task CopyCommand() =>
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", InstallCommand);
}
