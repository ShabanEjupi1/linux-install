@page "/barkod"
@attribute [Authorize(Policy = "perm:stock")]
@rendermode RenderModes.Interactive
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject CatalogService Catalog
@inject BusinessProfileService Profile
@inject HardwareBridge Hw
@inject LocalState Local
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Barkodi — KosovaPOS</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Printimi i barkodave</h1>
            <span class="muted">Zgjidh artikullin, printo, kalo te tjetri.</span>
        </div>
        <span class="agent-badge @(_agentOnline ? (_agentReal ? "on" : "mock") : "off")" title="@_agentTitle">
            <span class="dot"></span>@(_agentOnline ? (_agentReal ? "Pajisje" : "Pajisje (test)") : "Pa pajisje")
        </span>
    </header>

    @if (!_agentOnline)
    {
        <div class="sale-msg err">
            Agjenti i pajisjeve nuk po përgjigjet në këtë kompjuter. Etiketat printohen përmes
            shfletuesit, i cili hap dialogun e printimit. Instaloje te <a href="/pajisjet">Pajisjet</a>.
        </div>
    }

    @* The print controls do not move and do not scroll away: the copies box, the printer and
       the button sit in the same place all day, and only the ARTICLE inside them changes. The
       cashier picks a product, presses Printo, picks the next one — the old page made them
       rebuild a queue and hunt for a button that had been pushed off-screen by search results. *@
    <div class="print-bar">
        <div class="print-bar-item">
            @if (_selected is null)
            {
                <span class="muted">Asnjë artikull i zgjedhur — kërko ose skano më poshtë.</span>
            }
            else
            {
                <strong>@_selected.Name</strong>
                <span class="mono">@_selected.Barcode</span>
                <span class="price-tag">@_selected.SalesPrice.ToString("0.00") €</span>
            }
        </div>

        @* The count is a stepper, not a spinbox. This runs on a touchscreen till, where the native
           number-input arrows are a few pixels tall and a fat-fingered miss is a wasted roll of
           labels. It still takes a typed number for the shop that wants 120 of them. *@
        <label class="chk">Kopje
            <CopyStepper @bind-Value="_copies" Min="1" Max="200" />
        </label>

        <PrinterPicker Label="Printeri" Printers="_printers"
                       Value="_labelPrinter" ValueChanged="SetLabelPrinter" />

        <button class="btn-primary big-print" disabled="@(_selected is null || _busy)" @onclick="PrintSelected">
            @(_busy ? "Duke printuar…" : $"🖨️ Printo ({Math.Max(1, _copies)})")
        </button>
    </div>

    @if (_status is not null)
    {
        <div class="sale-msg @(_statusOk ? "ok" : "err")">@_status</div>
    }

    <div class="search-row">
        <input @ref="_searchBox" @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKey"
               placeholder="Kërko emër ose barkod — ose skano artikullin…" class="search-box" />
        <label class="chk">
            <input type="checkbox" @bind="_autoPrintOnScan" />
            Printo vetë pas skanimit
        </label>
    </div>

    <div class="table-wrap">
        <table class="grid-table">
            <thead>
                <tr>
                    <th>Barkodi</th>
                    <th>Emërtimi</th>
                    <th class="num">Çm. shitje</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Matches)
                {
                    <tr class="clickable @(_selected?.Id == a.Id ? "row-selected" : "")" @onclick="() => Select(a)">
                        <td class="mono">@a.Barcode</td>
                        <td>@a.Name</td>
                        <td class="num">@a.SalesPrice.ToString("0.00")</td>
                        <td class="actions">
                            @if (string.IsNullOrWhiteSpace(a.Barcode))
                            {
                                <span class="muted">Pa barkod</span>
                            }
                            else
                            {
                                <button class="btn-mini" @onclick="() => Select(a)"
                                        @onclick:stopPropagation="true">Zgjidh</button>
                                <button class="btn-mini" @onclick="() => Enqueue(a)"
                                        @onclick:stopPropagation="true">+ Radha</button>
                            }
                        </td>
                    </tr>
                }
                @if (!Matches.Any())
                {
                    <tr><td colspan="4" class="muted center">
                        @(string.IsNullOrWhiteSpace(_search) ? "Shkruaj ose skano për të kërkuar." : "Asnjë artikull.")
                    </td></tr>
                }
            </tbody>
        </table>
    </div>

    @* Batch mode, for the day the shop re-prices a whole shelf. The one-at-a-time bar above is
       the everyday path; this exists so 30 labels are not 30 button presses. *@
    @if (_queue.Count > 0)
    {
        <h2 class="section-title">Radha e printimit (@TotalLabels etiketa)</h2>
        <div class="table-wrap">
            <table class="grid-table">
                <thead>
                    <tr>
                        <th>Barkodi</th>
                        <th>Emërtimi</th>
                        <th class="num">Kopje</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _queue)
                    {
                        <tr>
                            <td class="mono">@item.Article.Barcode</td>
                            <td>@item.Article.Name</td>
                            <td class="num">
                                <CopyStepper Value="item.Copies" Big="false"
                                             ValueChanged="n => SetCopies(item, n)" Min="1" Max="200" />
                            </td>
                            <td><button class="btn-mini" @onclick="() => _queue.Remove(item)">Hiq</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="modal-actions">
            <button class="btn-ghost" disabled="@_busy" @onclick="() => _queue.Clear()">Pastro radhën</button>
            <button class="btn-primary" disabled="@_busy" @onclick="PrintQueue">
                @(_busy ? "Duke printuar…" : $"🖨️ Printo radhën ({TotalLabels})")
            </button>
        </div>
    }
</div>

@code {
    private sealed class QueueItem
    {
        public required Article Article { get; init; }
        public int Copies { get; set; } = 1;
    }

    private List<Article> _all = new();
    private readonly List<QueueItem> _queue = new();
    private string _search = "";
    private int _copies = 1;
    private Article? _selected;
    private ElementReference _searchBox;

    /// <summary>
    /// A barcode scanner is a keyboard that types fast and ends with Enter. With this on, a
    /// scan selects the article AND prints its label — which is the whole job when someone is
    /// re-labelling a shelf, and it means the till never has to be touched.
    /// </summary>
    private bool _autoPrintOnScan = true;

    private bool _agentOnline, _agentReal, _busy, _statusOk;
    private string? _status;
    private string _agentTitle = "Agjenti i pajisjeve nuk është kontrolluar ende";

    /// <summary>
    /// The label printer, named. Leaving it null lets the agent fall back to this PC's default
    /// printer — which in a shop is the receipt printer, and 30 labels come out as 30 receipts.
    /// </summary>
    private string? _labelPrinter;
    private KosovaPOS.Agent.Contracts.PrinterList? _printers;

    /// <summary>The shop's label stock, so the browser fallback prints on the same size the agent
    /// would — not the hard-coded 55×25 the /etiketa page defaults to.</summary>
    private int _labelW = 55, _labelH = 25;

    protected override async Task OnInitializedAsync()
    {
        _all = await Catalog.GetAllArticlesAsync();
        var shop = await Profile.GetSettingsAsync();
        _labelPrinter = shop?.BarcodePrinter;
        if (shop?.LabelWidthMm  is > 0) _labelW = shop.LabelWidthMm;
        if (shop?.LabelHeightMm is > 0) _labelH = shop.LabelHeightMm;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // What this PC last printed labels on wins over the shop-wide default: the setting is one
        // row shared by every till, and the printer is not. Chosen once here, it is also the one
        // the Articles screen prints from.
        if (await Local.LoadAsync<string>(LocalKeys.LabelPrinter) is { Length: > 0 } saved)
            _labelPrinter = saved;

        await RefreshAgentStatusAsync();
        // The scanner types into whatever has focus; this page has exactly one thing worth
        // typing into, so it may as well already be focused when the page opens.
        try { await _searchBox.FocusAsync(); } catch (Exception) { }
        StateHasChanged();
    }

    private async Task RefreshAgentStatusAsync()
    {
        var health = await Hw.GetHealthAsync();
        _agentOnline = health is not null;
        _agentReal = health?.RealHardware ?? false;
        _agentTitle = health is null
            ? "Agjenti i pajisjeve nuk po përgjigjet"
            : $"{(health.RealHardware ? "pajisje reale" : "modaliteti test")}";

        _printers = _agentOnline ? await Hw.GetPrintersAsync() : null;
    }

    private IEnumerable<Article> Matches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search)) return Enumerable.Empty<Article>();
            var s = _search.Trim();
            return _all.Where(a => a.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                                || a.Barcode.Contains(s, StringComparison.OrdinalIgnoreCase))
                       .OrderBy(a => a.Name)
                       .Take(50);
        }
    }

    private int TotalLabels => _queue.Sum(i => i.Copies);

    private void Select(Article a)
    {
        if (string.IsNullOrWhiteSpace(a.Barcode)) return;
        _selected = a;
        _status = null;
    }

    /// <summary>
    /// Enter — from the keyboard or from a scanner's trailing Return. An exact barcode match is
    /// the scanner; a single search hit is the human. Anything ambiguous is left alone: printing
    /// the wrong label wastes stock and, worse, ends up on a shelf.
    /// </summary>
    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        // Escape wipes a half-typed name so the next scan is not appended onto it — same one-tap
        // clear the till has, from the keyboard, without leaving the box.
        if (e.Key == "Escape")
        {
            _search = "";
            await _searchBox.FocusAsync();
            return;
        }

        if (e.Key != "Enter") return;

        var s = _search.Trim();
        if (s.Length == 0) return;

        var hit = _all.FirstOrDefault(a => a.Barcode.Equals(s, StringComparison.OrdinalIgnoreCase))
                  ?? (Matches.Count() == 1 ? Matches.First() : null);
        if (hit is null) return;

        Select(hit);
        if (_autoPrintOnScan) await PrintSelected();

        // Clear for the next scan — a scanner appends, and "12345678901231234567890123" matches
        // nothing.
        _search = "";
        await _searchBox.FocusAsync();
    }

    private async Task PrintSelected()
    {
        if (_selected is null) return;
        await PrintAll(new[] { (_selected, Math.Clamp(_copies, 1, 200)) });
    }

    private async Task PrintQueue()
    {
        if (_queue.Count == 0) return;
        await PrintAll(_queue.Select(i => (i.Article, i.Copies)).ToList());
        // A batch that printed is done with; one that failed stays on the queue, ready to be
        // retried without being rebuilt article by article.
        if (_statusOk) _queue.Clear();
    }

    /// <summary>
    /// With an agent on this PC the labels go out from right here: raw TSPL, no dialog, no page
    /// change, the search still on screen for the next article. Without one the labels have to
    /// be DRAWN by the browser — and a page can only print itself — so they are rendered at
    /// /etiketa inside a hidden frame. Even then the shop never leaves this page.
    /// </summary>
    private async Task PrintAll(IReadOnlyCollection<(Article Article, int Copies)> jobs)
    {
        _busy = true;
        _status = null;
        try
        {
            if (!_agentOnline)
            {
                // No &auto=1: the hidden frame prints itself once the labels have rendered.
                // Asking the page to print as well would raise two dialogs.
                var q = string.Join(",", jobs.Select(j => $"{j.Article.Id}x{j.Copies}"));
                var r = await Hw.PrintUrlAsync($"/etiketa?q={Uri.EscapeDataString(q)}&w={_labelW}&h={_labelH}");
                _statusOk = r.Ok;
                _status = r.Ok
                    ? "Etiketat u dërguan te shfletuesi për printim."
                    : $"Printimi dështoi: {r.Error}";
                return;
            }

            var sent = 0;
            var failed = new List<string>();

            // Article by article, so a jam does not discard the rest of the batch.
            foreach (var (article, copies) in jobs)
            {
                var result = await Hw.PrintBarcodeAsync(article, copies, _labelPrinter);
                if (result.Ok) sent += copies;
                else failed.Add($"{article.Name}: {result.Error}");
            }

            _statusOk = failed.Count == 0;
            _status = _statusOk
                ? $"✅ {sent} etiketa u printuan."
                : $"{sent} u printuan · {failed.Count} dështuan: {string.Join(" · ", failed.Take(2))}";
        }
        finally { _busy = false; }
    }

    private void Enqueue(Article a)
    {
        if (string.IsNullOrWhiteSpace(a.Barcode)) return;
        var copies = Math.Clamp(_copies, 1, 200);
        var existing = _queue.FirstOrDefault(i => i.Article.Id == a.Id);
        if (existing is not null) existing.Copies += copies;
        else _queue.Add(new QueueItem { Article = a, Copies = copies });
    }

    private async Task SetLabelPrinter(string? printer)
    {
        _labelPrinter = printer;
        await Local.SaveAsync(LocalKeys.LabelPrinter, printer ?? "");
    }

    private void SetCopies(QueueItem item, int copies) => item.Copies = copies;
}
