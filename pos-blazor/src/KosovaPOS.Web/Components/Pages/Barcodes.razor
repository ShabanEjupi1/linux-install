@page "/barkod"
@attribute [Authorize(Policy = "perm:stock")]
@rendermode InteractiveServer
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject CatalogService Catalog
@inject BusinessProfileService Profile
@inject HardwareBridge Hw
@inject NavigationManager Nav

<PageTitle>Barkodi — KosovaPOS</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Printimi i barkodave</h1>
            <span class="muted">Kërko artikujt, shto në radhë dhe printo etiketat.</span>
        </div>
        <span class="agent-badge @(_agentOnline ? (_agentReal ? "on" : "mock") : "off")" title="@_agentTitle">
            <span class="dot"></span>@(_agentOnline ? (_agentReal ? "Pajisje" : "Pajisje (test)") : "Pa pajisje")
        </span>
    </header>

    @if (!_agentOnline)
    {
        <div class="sale-msg err">
            Agjenti i pajisjeve nuk po përgjigjet në këtë kompjuter. Etiketat printohen përmes
            shfletuesit, i cili hap dialogun e printimit.
        </div>
    }

    <div class="search-row">
        <input @bind="_search" @bind:event="oninput" placeholder="Kërko emër ose barkod…" class="search-box" />
        <label class="chk">Kopje <input type="number" min="1" class="thresh" @bind="_copies" /></label>
    </div>

    <div class="table-wrap">
        <table class="grid-table">
            <thead>
                <tr>
                    <th>Barkodi</th>
                    <th>Emërtimi</th>
                    <th class="num">Çm. shitje</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Matches)
                {
                    <tr>
                        <td class="mono">@a.Barcode</td>
                        <td>@a.Name</td>
                        <td class="num">@a.SalesPrice.ToString("0.00")</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(a.Barcode))
                            {
                                <span class="muted">Pa barkod</span>
                            }
                            else
                            {
                                <button class="btn-mini" @onclick="() => Enqueue(a)">Shto në radhë</button>
                            }
                        </td>
                    </tr>
                }
                @if (!Matches.Any())
                {
                    <tr><td colspan="4" class="muted center">
                        @(string.IsNullOrWhiteSpace(_search) ? "Shkruaj për të kërkuar." : "Asnjë artikull.")
                    </td></tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="section-title">Radha e printimit (@TotalLabels etiketa)</h2>
    <div class="table-wrap">
        <table class="grid-table">
            <thead>
                <tr>
                    <th>Barkodi</th>
                    <th>Emërtimi</th>
                    <th class="num">Kopje</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _queue)
                {
                    <tr>
                        <td class="mono">@item.Article.Barcode</td>
                        <td>@item.Article.Name</td>
                        <td class="num">
                            <button class="btn-mini" @onclick="() => Bump(item, -1)">−</button>
                            @item.Copies
                            <button class="btn-mini" @onclick="() => Bump(item, 1)">+</button>
                        </td>
                        <td><button class="btn-mini" @onclick="() => _queue.Remove(item)">Hiq</button></td>
                    </tr>
                }
                @if (_queue.Count == 0)
                {
                    <tr><td colspan="4" class="muted center">Radha është bosh.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="modal-actions">
        <button class="btn-ghost" disabled="@(_queue.Count == 0)" @onclick="() => _queue.Clear()">Pastro radhën</button>

        @* One button, because the choice is not the cashier's to make: with an agent the queue
           goes straight out as raw TSPL from this page (no dialog, no page change); without
           one it is handed to /etiketa, which draws the labels for the browser to print. *@
        <button class="btn-primary" disabled="@(_queue.Count == 0 || _busy)" @onclick="Print">
            @(_busy ? "Duke printuar…" : $"🖨️ Printo etiketat ({TotalLabels})")
        </button>

        @if (_status is not null)
        {
            <span class="muted print-hint">@_status</span>
        }
    </div>
</div>

@code {
    private sealed class QueueItem
    {
        public required Article Article { get; init; }
        public int Copies { get; set; } = 1;
    }

    /// <summary>
    /// With an agent on this PC the labels are printed from right here: raw TSPL, no dialog,
    /// no page change, the queue still on screen for the next batch. Leaving the till screen
    /// to reach a printer is a step the cashier never asked for.
    ///
    /// Without an agent the labels have to be *drawn* by the browser, and a page can only
    /// print itself — so that case still hands the queue to /etiketa. The queue travels in the
    /// URL (<c>id x copies</c>) so a jam can be reprinted by reloading, without rebuilding it.
    /// </summary>
    private async Task Print()
    {
        if (!_agentOnline)
        {
            var q = string.Join(",", _queue.Select(i => $"{i.Article.Id}x{i.Copies}"));
            Nav.NavigateTo($"/etiketa?q={Uri.EscapeDataString(q)}&auto=1");
            return;
        }

        _busy = true;
        _status = null;
        try
        {
            var sent = 0;
            var failed = new List<string>();

            // Article by article, so a jam does not discard the rest of the queue.
            foreach (var item in _queue.ToList())
            {
                var result = await Hw.PrintBarcodeAsync(item.Article, item.Copies, _labelPrinter);
                if (result.Ok) sent += item.Copies;
                else failed.Add($"{item.Article.Name}: {result.Error}");
            }

            // What printed is off the queue; what failed stays on it, ready to be retried
            // without being typed in again.
            _queue.RemoveAll(i => !failed.Any(f => f.StartsWith(i.Article.Name + ":", StringComparison.Ordinal)));

            _status = failed.Count == 0
                ? $"✅ {sent} etiketa u printuan."
                : $"{sent} u printuan · {failed.Count} dështuan: {string.Join(" · ", failed.Take(2))}";
        }
        finally { _busy = false; }
    }

    private List<Article> _all = new();
    private readonly List<QueueItem> _queue = new();
    private string _search = "";
    private int _copies = 1;

    private bool _agentOnline, _agentReal, _busy;
    private string? _status;
    private string _agentTitle = "Agjenti i pajisjeve nuk është kontrolluar ende";

    /// <summary>
    /// The label printer, named. Leaving it null lets the agent fall back to this PC's default
    /// printer — which in a shop is the receipt printer, and 30 labels come out as 30 receipts.
    /// </summary>
    private string? _labelPrinter;

    protected override async Task OnInitializedAsync()
    {
        _all = await Catalog.GetAllArticlesAsync();
        _labelPrinter = (await Profile.GetSettingsAsync())?.BarcodePrinter;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshAgentStatusAsync();
        StateHasChanged();
    }

    private async Task RefreshAgentStatusAsync()
    {
        var health = await Hw.GetHealthAsync();
        _agentOnline = health is not null;
        _agentReal = health?.RealHardware ?? false;
        _agentTitle = health is null
            ? "Agjenti i pajisjeve nuk po përgjigjet"
            : $"{(health.RealHardware ? "pajisje reale" : "modaliteti test")}";
    }

    private IEnumerable<Article> Matches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search)) return Enumerable.Empty<Article>();
            var s = _search.Trim();
            return _all.Where(a => a.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                                || a.Barcode.Contains(s, StringComparison.OrdinalIgnoreCase))
                       .OrderBy(a => a.Name)
                       .Take(50);
        }
    }

    private int TotalLabels => _queue.Sum(i => i.Copies);

    private void Enqueue(Article a)
    {
        var copies = Math.Max(1, _copies);
        var existing = _queue.FirstOrDefault(i => i.Article.Id == a.Id);
        if (existing is not null) existing.Copies += copies;
        else _queue.Add(new QueueItem { Article = a, Copies = copies });
    }

    private void Bump(QueueItem item, int by)
    {
        item.Copies += by;
        if (item.Copies < 1) _queue.Remove(item);
    }

}
