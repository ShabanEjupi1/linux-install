@page "/cilesimet"
@attribute [Authorize(Policy = "perm:settings")]
@rendermode RenderModes.Interactive
@using KosovaPOS.Core.Printing
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@inject BusinessProfileService Profile
@inject NavigationManager Nav
@inject Audit Audit

<PageTitle>Cilësimet — KosovaPOS</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Cilësimet</h1>
            <span class="muted">Të dhënat e biznesit dhe profili i punës</span>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="sale-msg @(_success ? "ok" : "err")">@_message</div>
    }

    @if (_loading)
    {
        <Skeleton Rows="6" />
    }
    else
    {
        <EditForm Model="_settings" OnValidSubmit="Save">
            <fieldset class="settings-set">
                <legend>Biznesi</legend>
                <div class="form-grid">
                    <div class="field span2">
                        <label>Emri i biznesit</label>
                        <input class="input" @bind="_settings.BusinessName" maxlength="200" />
                        <p class="hint">Shfaqet në krye të faqes dhe në faturën jofiskale.</p>
                    </div>
                    <div class="field span2">
                        <label>Adresa</label>
                        <input class="input" @bind="_settings.Address" maxlength="200" />
                        <p class="hint">Shtypet në kokën e faturës jofiskale.</p>
                    </div>
                    <div class="field">
                        <label>Numri fiskal</label>
                        <input class="input mono" @bind="_settings.FiscalNumber" maxlength="50" />
                        <p class="hint warn">
                            Përdoret vetëm në faturën jofiskale. Numri që i dërgohet ATK-së
                            vjen nga <span class="mono">FISCAL_NUMBER</span> në agjentin e
                            instaluar në PC-në e shitores — ndryshimi këtu nuk e prek atë.
                        </p>
                    </div>
                </div>
            </fieldset>

            <fieldset class="settings-set">
                <legend>Fatura A4 (ligjore)</legend>
                <div class="form-grid">
                    <div class="field">
                        <label>Numri i TVSH-së</label>
                        <input class="input mono" @bind="_settings.VatNumber" maxlength="50" />
                        <p class="hint">Shtypet në faturën A4 (faturë tatimore).</p>
                    </div>
                    <div class="field">
                        <label>Llogaria bankare / IBAN</label>
                        <input class="input mono" @bind="_settings.BankAccount" maxlength="100" />
                        <p class="hint">Për pagesa me transfer nga blerësit biznes.</p>
                    </div>
                </div>
            </fieldset>

            @* Four documents come off one sale, and no two shops want the same set: a kiosk prints
               a fiscal receipt and nothing else, a wholesaler prints an A4 invoice and a waybill
               and never touches the thermal roll. So the shop decides which of them the till even
               offers, and how each one starts out — a cashier should not tick the same two boxes
               on every sale of the day. *@
            <fieldset class="settings-set">
                <legend>Dokumentet e shitjes</legend>
                <p class="hint">
                    <strong>Shfaqet</strong> = arkëtari e sheh këtë opsion te <em>Shitja</em> (dhe mund
                    ta rishtypë pas shitjes). <strong>I zgjedhur</strong> = fillon i shënuar në një arkë
                    të re. Një arkë e konfiguruar më parë e mban zgjedhjen e vet; heqja e një dokumenti
                    nga <em>Shfaqet</em> e ndalon atë kudo.
                </p>

                <table class="grid-table doc-matrix">
                    <thead>
                        <tr>
                            <th>Dokumenti</th>
                            <th class="num">Shfaqet te Shitja</th>
                            <th class="num">I zgjedhur si parazgjedhje</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>🧾 Fatura fiskale</td>
                            <td class="num"><InputCheckbox @bind-Value="_settings.SellOfferFiscal" /></td>
                            <td class="num">
                                <InputCheckbox @bind-Value="_settings.SellDefaultFiscal"
                                               disabled="@(!_settings.SellOfferFiscal)" />
                            </td>
                        </tr>
                        <tr>
                            <td>🧾 Kuponi termik (80mm)</td>
                            <td class="num"><InputCheckbox @bind-Value="_settings.SellOfferReceipt80" /></td>
                            <td class="num">
                                <InputCheckbox @bind-Value="_settings.SellDefaultReceipt80"
                                               disabled="@(!_settings.SellOfferReceipt80)" />
                            </td>
                        </tr>
                        <tr>
                            <td>📄 Fatura A4</td>
                            <td class="num"><InputCheckbox @bind-Value="_settings.SellOfferInvoiceA4" /></td>
                            <td class="num">
                                <InputCheckbox @bind-Value="_settings.SellDefaultInvoiceA4"
                                               disabled="@(!_settings.SellOfferInvoiceA4)" />
                            </td>
                        </tr>
                        <tr>
                            <td>🚚 Fletëdërgesa A4</td>
                            <td class="num"><InputCheckbox @bind-Value="_settings.SellOfferWaybillA4" /></td>
                            <td class="num">
                                <InputCheckbox @bind-Value="_settings.SellDefaultWaybillA4"
                                               disabled="@(!_settings.SellOfferWaybillA4)" />
                            </td>
                        </tr>
                    </tbody>
                </table>

                <p class="hint">
                    Fatura dhe fletëdërgesa A4 dalin te <strong>printeri A4</strong> i zgjedhur më
                    poshtë, përmes agjentit — pa dialog printimi. Pa agjent i printon shfletuesi, i
                    cili nuk e zgjedh dot printerin: shkojnë te printeri i parazgjedhur i Windows-it,
                    që në arkë shpesh është rrotulla termike.
                </p>
            </fieldset>

            @* Three printers, three different papers: the thermal roll, the label stock and A4.
               They are here AND on /pajisjet, from one component — the day the two screens have
               their own copy of this is the day a shop sets its A4 printer on one and watches the
               other quietly unset it. *@
            <fieldset class="settings-set">
                <legend>Printerët lokalë (agjenti)</legend>
                <p class="hint">
                    Printerët janë të gjithë biznesit. Lista lexohet nga agjenti i këtij kompjuteri;
                    pa agjent, emrat shkruhen ashtu si duken te <em>Windows → Printers &amp; scanners</em>.
                    Te <em>Shitja</em> nuk zgjidhet më printer: një menu në arkë është edhe një gjë që
                    arkëtari mund ta gabojë me klientin përpara, dhe një emër i gabuar printeri dështon
                    në heshtje — duket njësoj si një printer i fikur.
                </p>
                <PrinterSetup OnSaved="OnPrintersSaved" />
            </fieldset>

            @* Which lines the courtesy receipt carries. Every switch here is a line some shop
               wants and some shop does not: a cashier's name on paper the customer takes home,
               a fiscal number a non-registered business must NOT print, an address nobody reads.
               The preview beside them is laid out by the same formatter that drives the printer,
               so what is on the right is what comes out of the roll — not an artist's impression. *@
            <fieldset class="settings-set">
                <legend>Kuponi termik (jofiskal)</legend>
                <p class="hint">
                    Zgjidh çfarë shtypet në kupon. Këto <strong>nuk e prekin faturën fiskale</strong> —
                    përmbajtjen e saj e cakton ATK-ja dhe vetë printeri fiskal.
                </p>

                <div class="receipt-config">
                    <div class="receipt-toggles">
                        <label class="chk"><InputCheckbox @bind-Value="_settings.ReceiptShowBusinessName" /> Emri i biznesit</label>
                        <label class="chk"><InputCheckbox @bind-Value="_settings.ReceiptShowAddress" /> Adresa</label>
                        <label class="chk"><InputCheckbox @bind-Value="_settings.ReceiptShowPhone" /> Telefoni</label>
                        <label class="chk"><InputCheckbox @bind-Value="_settings.ReceiptShowFiscalNumber" /> Numri fiskal</label>
                        <label class="chk"><InputCheckbox @bind-Value="_settings.ReceiptShowVatNumber" /> Numri i TVSH-së</label>
                        <label class="chk"><InputCheckbox @bind-Value="_settings.ReceiptShowCashier" /> Emri i shitësit (arkëtarit)</label>
                        <label class="chk"><InputCheckbox @bind-Value="_settings.ReceiptShowVatBreakdown" /> Ndarja e TVSH-së</label>
                        <label class="chk"><InputCheckbox @bind-Value="_settings.ReceiptShowPaidAndChange" /> Paguar dhe kusuri</label>

                        <div class="field span2">
                            <label>Rreshti i sipërm (opsional)</label>
                            <input class="input" @bind="_settings.ReceiptHeaderNote" @bind:event="oninput"
                                   maxlength="120" placeholder="p.sh. Hapur 08:00–20:00" />
                        </div>
                        <div class="field span2">
                            <label>Rreshti i fundit</label>
                            <input class="input" @bind="_settings.ReceiptFooterText" @bind:event="oninput"
                                   maxlength="120" placeholder="Faleminderit për blerjen!" />
                            <p class="hint">Lëre bosh që të mos shtypet asgjë në fund.</p>
                        </div>
                    </div>

                    <div class="receipt-preview">
                        <span class="muted">Pamja paraprake</span>
                        <pre class="r80">@foreach (var l in PreviewLines)
      {<span class="@Css(l.Emphasis)">@l.Text</span>@("\n")}</pre>
                    </div>
                </div>
            </fieldset>

            <fieldset class="settings-set">
                <legend>Profili i biznesit</legend>
                <div class="form-grid">
                    <div class="field span2">
                        <label>Lloji i veprimtarisë</label>
                        <select class="input" @bind="_settings.Profile">
                            @foreach (var p in Profiles)
                            {
                                <option value="@p">@ProfileLabel(p)</option>
                            }
                        </select>
                        <p class="hint">Shfaqet nën emrin e biznesit në shiritin anësor.</p>
                    </div>
                </div>
            </fieldset>

            <div class="modal-actions">
                <button type="submit" class="btn-primary" disabled="@_busy">
                    @(_busy ? "Duke ruajtur…" : "Ruaj")
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    private BusinessSettings _settings = new();
    private bool _loading = true, _busy, _success;
    private string? _message;

    // Snapshot of the fields the shell reads, so a change to either can force the
    // layout (static SSR, initialised once per navigation) to pick them up.
    private string? _shellName;
    private BusinessProfile _shellProfile;

    private static readonly BusinessProfile[] Profiles = Enum.GetValues<BusinessProfile>();

    /// <summary>
    /// The receipt as it would come off the roll under the settings currently on screen — laid
    /// out by the very formatter the printer is driven by, not by a mock-up of it. A toggle whose
    /// effect you cannot see before you save is a toggle nobody dares to touch.
    /// </summary>
    private List<ReceiptTextLine> PreviewLines => ReceiptFormatter.Format(
        SampleSale, HardwareBridge.ReceiptHeaderFor(_settings), HardwareBridge.ReceiptOptionsFor(_settings));

    private static readonly Invoice SampleSale = new()
    {
        Number = "1024",
        Date = new DateTime(2026, 1, 1),
        Time = "14:32",
        CashierName = "Arta K.",
        PaymentMethod = "Para në dorë",
        Lines =
        {
            new InvoiceLine { Name = "Kafe e bluar 200g", Quantity = 2, UnitPriceGross = 3.50m,
                              VatRate = 18, GrossValue = 7.00m, VatValue = 1.07m, NetValue = 5.93m },
            new InvoiceLine { Name = "Ujë mineral 1.5L", Quantity = 1, UnitPriceGross = 0.60m,
                              VatRate = 8, GrossValue = 0.60m, VatValue = 0.04m, NetValue = 0.56m },
        },
        VatSummary =
        {
            new VatSummaryRow { Rate = 18, Net = 5.93m, Vat = 1.07m, Gross = 7.00m },
            new VatSummaryRow { Rate = 8,  Net = 0.56m, Vat = 0.04m, Gross = 0.60m },
        },
        TotalNet = 6.49m,
        TotalVat = 1.11m,
        TotalGross = 7.60m,
        PaidAmount = 10.00m,
        ChangeAmount = 2.40m,
    };

    private static string Css(ReceiptEmphasis e) => e switch
    {
        ReceiptEmphasis.Title => "r80-title",
        ReceiptEmphasis.Bold  => "r80-bold",
        _                     => "",
    };

    protected override async Task OnInitializedAsync()
    {
        _settings = await Profile.GetSettingsAsync();
        _shellName = _settings.BusinessName;
        _shellProfile = _settings.Profile;
        _loading = false;
    }

    /// <summary>
    /// The printer block saves itself (its test prints have to go to the printer that is on the
    /// screen, not the one in the database). This form holds its OWN copy of the settings row and
    /// SaveSettingsAsync copies every field it is handed — so without this, pressing Ruaj on the
    /// form afterwards would write the pre-edit printer names straight back over the new ones.
    /// </summary>
    private void OnPrintersSaved(BusinessSettings saved)
    {
        _settings.ReceiptPrinter  = saved.ReceiptPrinter;
        _settings.BarcodePrinter  = saved.BarcodePrinter;
        _settings.InvoicePrinter  = saved.InvoicePrinter;
        _settings.ReceiptCodePage = saved.ReceiptCodePage;
        _settings.LabelWidthMm    = saved.LabelWidthMm;
        _settings.LabelHeightMm   = saved.LabelHeightMm;
    }

    private async Task Save()
    {
        _busy = true;
        try
        {
            var shellChanged = _settings.BusinessName?.Trim() != _shellName?.Trim()
                            || _settings.Profile != _shellProfile;

            await Profile.SaveSettingsAsync(_settings);

            // Audited before the possible reload below — a Nav.Refresh tears the
            // circuit down, and an await placed after it may never run.
            await Audit.LogAsync(AuditAction.Update, "BusinessSettings", _settings.Id,
                _settings.BusinessName, details: "Cilësimet e biznesit u ruajtën.");

            if (shellChanged)
            {
                // The sidebar and app bar render in the static layout pass, so they
                // keep the old name until the page is fetched again. Reloading is the
                // feedback: the header visibly becomes the new name.
                Nav.Refresh(forceReload: true);
                return;
            }

            _success = true;
            _message = "Cilësimet u ruajtën.";
        }
        catch (Exception ex)
        {
            _success = false;
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ProfileLabel(BusinessProfile p) => p switch
    {
        BusinessProfile.FoodAndBeverage => "Restorant",
        BusinessProfile.Hospitality => "Hoteleri",
        BusinessProfile.Wholesale => "Shumicë",
        BusinessProfile.Pharmacy => "Farmaci",
        BusinessProfile.Rental => "Qira",
        BusinessProfile.Services => "Shërbime",
        _ => "Dyqan (Retail)"
    };
}
