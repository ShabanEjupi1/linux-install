@page "/articles"
@attribute [Authorize(Policy = "perm:articles")]
@rendermode RenderModes.Interactive
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Web.Services
@using System.Text.Json
@inject CatalogService Catalog
@inject BusinessProfileService Profile
@inject HardwareBridge Hw
@inject LocalState Local
@inject Audit Audit

<PageTitle>Artikujt — KosovaPOS</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Artikujt</h1>
            <span class="muted">@_all.Count artikuj gjithsej</span>
        </div>
        <button class="btn-primary" @onclick="() => OpenEditor(null)">+ Artikull i ri</button>
    </header>

    <div class="search-row">
        <input @bind="_search" @bind:event="oninput" @bind:after="OnSearchChanged"
               placeholder="Kërko emër ose barkod…" class="search-box" />
        @if (_categories.Count > 0)
        {
            <select @bind="_activeCategory" @bind:after="OnSearchChanged" class="cat-select">
                <option value="">Të gjitha kategoritë</option>
                @foreach (var c in _categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
        }
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="sale-msg @(_success ? "ok" : "err")">@_message</div>
    }

    <div class="table-wrap">
        @if (_loading)
        {
            <Skeleton Rows="8" Panel="false" Head="false" />
        }
        else
        {
            <table class="grid-table">
                <thead>
                    <tr>
                        <th>Barkodi</th>
                        <th>Emërtimi</th>
                        <th>Kategoria</th>
                        <th class="num">Çmimi</th>
                        <th class="num">TVSH</th>
                        <th class="num">Stoku</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Shown)
                    {
                        <tr>
                            <td class="mono">@a.Barcode</td>
                            <td>@a.Name</td>
                            <td>@a.Category</td>
                            <td class="num">@a.SalesPrice.ToString("0.00") €</td>
                            <td class="num">@a.VATRate.ToString("0") %</td>
                            <td class="num @(a.StockQuantity <= 0 ? "out" : "")">@a.StockQuantity.ToString("0.##")</td>
                            <td class="actions">
                                @if (!string.IsNullOrWhiteSpace(a.Barcode))
                                {
                                    <button class="btn-mini" title="Printo barkodin" @onclick="() => OpenLabels(a)">🏷️</button>
                                }
                                <button class="btn-mini" @onclick="() => OpenEditor(a)">✏️</button>
                                <button class="btn-mini danger" @onclick="() => AskDelete(a)">🗑️</button>
                            </td>
                        </tr>
                    }
                    @if (!Filtered.Any())
                    {
                        <tr><td colspan="7" class="muted center">Asnjë artikull.</td></tr>
                    }
                </tbody>
            </table>

            @if (Filtered.Count() > _shown)
            {
                <div class="more-row">
                    <span class="muted">Po shfaqen @_shown nga @Filtered.Count() artikuj.</span>
                    <button class="btn-ghost" @onclick="ShowMore">Shfaq më shumë</button>
                </div>
            }
        }
    </div>
</div>

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="CloseEditor">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>@(_editing.Id > 0 ? "Ndrysho artikullin" : "Artikull i ri")</h2>
            <EditForm Model="_editing" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    @* Starred because the model requires it and the column is NOT NULL. It used to
                       be presented as optional, and leaving it empty made "Ruaj" do nothing at
                       all. *@
                    <div class="field">
                        <label>Barkodi *</label>
                        <input class="input" @bind="_editing.Barcode" />
                    </div>
                    <div class="field span2">
                        <label>Emërtimi *</label>
                        <input class="input" @bind="_editing.Name" />
                    </div>
                    <div class="field">
                        <label>Kategoria</label>
                        <input class="input" list="cat-list" @bind="_editing.Category" />
                        <datalist id="cat-list">
                            @foreach (var c in _categories)
                            {
                                <option value="@c" />
                            }
                        </datalist>
                    </div>
                    <div class="field">
                        <label>Njësia</label>
                        <input class="input" @bind="_editing.Unit" />
                    </div>
                    <div class="field">
                        <label>Çmimi furnizimit</label>
                        <input class="input" type="number" step="0.01" @bind="_editing.PurchasePrice" />
                    </div>
                    <div class="field">
                        <label>Çmimi shitjes *</label>
                        <input class="input" type="number" step="0.01" @bind="_editing.SalesPrice" />
                    </div>
                    <div class="field">
                        <label>TVSH</label>
                        <select class="input" @bind="_editing.VATType">
                            <option value="3">18%</option>
                            <option value="2">8%</option>
                            <option value="1">0%</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Stoku</label>
                        <input class="input" type="number" step="0.001" @bind="_editing.StockQuantity" />
                    </div>
                </div>

                @* Without this the form REFUSED IN SILENCE: a missing barcode failed validation,
                   OnValidSubmit never ran, and "Ruaj" simply did nothing — no message, no closed
                   modal, nothing to tell the clerk what the form wanted. *@
                <ValidationSummary class="form-errors" />

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="sale-msg err">@_formError</div>
                }

                <div class="modal-actions">
                    <button type="button" class="btn-ghost" @onclick="CloseEditor">Anulo</button>
                    <button type="submit" class="btn-primary" disabled="@_busy">
                        @(_busy ? "Duke ruajtur…" : "Ruaj")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* Labels, printed from the product list itself, with the same controls /barkod has — the count,
   the printer, and whether there is an agent to print through. Re-pricing an article and then
   having to go find it a second time on another screen just to re-label it is two searches for
   one job, and a label dialog that cannot say WHICH printer will print it is a dialog that sends
   30 price tags to the receipt roll. *@
@if (_labelling is not null)
{
    <div class="modal-backdrop" @onclick="() => _labelling = null">
        <div class="modal small" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2>Printo barkodin</h2>
                <span class="agent-badge @(_agentOnline ? (_agentReal ? "on" : "mock") : "off")">
                    <span class="dot"></span>@(_agentOnline ? "Pajisje" : "Pa pajisje")
                </span>
            </div>

            <p>
                <strong>@_labelling.Name</strong><br />
                <span class="mono">@_labelling.Barcode</span> ·
                <span class="price-tag">@_labelling.SalesPrice.ToString("0.00") €</span>
            </p>

            <div class="field">
                <label>Sa etiketa?</label>
                <CopyStepper @bind-Value="_labelCopies" Min="1" Max="200" />
            </div>

            <PrinterPicker Label="Printeri i etiketave" Printers="_printers"
                           Value="_labelPrinter" ValueChanged="SetLabelPrinter" />

            @if (_labelError is not null)
            {
                <div class="sale-msg err">@_labelError</div>
            }

            <div class="modal-actions">
                <a class="btn-ghost" href="/barkod">Printim me shumicë</a>
                <button class="btn-ghost" @onclick="() => _labelling = null">Anulo</button>
                <button class="btn-primary" disabled="@_busy" @onclick="PrintLabels">
                    @(_busy ? "Duke printuar…" : $"🖨️ Printo ({Math.Max(1, _labelCopies)})")
                </button>
            </div>
        </div>
    </div>
}

@if (_deleting is not null)
{
    <div class="modal-backdrop" @onclick="() => _deleting = null">
        <div class="modal small" @onclick:stopPropagation="true">
            <h2>Fshi artikullin?</h2>
            <p><strong>@_deleting.Name</strong> do të fshihet përgjithmonë.</p>
            <div class="modal-actions">
                <button class="btn-ghost" @onclick="() => _deleting = null">Anulo</button>
                <button class="btn-danger" disabled="@_busy" @onclick="ConfirmDelete">Fshi</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Article> _all = new();
    private List<string> _categories = new();
    private string _search = "";
    private string _activeCategory = "";
    private bool _loading = true, _busy, _success;
    private string? _message, _formError;

    private Article? _editing;
    private Article? _deleting;
    private Article? _labelling;
    private int _labelCopies = 1;
    private string? _labelError;

    private bool _agentOnline, _agentReal;
    private KosovaPOS.Agent.Contracts.PrinterList? _printers;

    /// <summary>
    /// The label printer chosen on THIS PC. Remembered in the browser and shared with /barkod,
    /// so picking it once is picking it everywhere; the shop's saved default is only the
    /// starting point.
    /// </summary>
    private string? _labelPrinter;

    protected override async Task OnInitializedAsync() => await Reload();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var health = await Hw.GetHealthAsync();
        _agentOnline = health is not null;
        _agentReal = health?.RealHardware ?? false;
        _printers = _agentOnline ? await Hw.GetPrintersAsync() : null;

        _labelPrinter = await Local.LoadAsync<string>(LocalKeys.LabelPrinter);
        if (string.IsNullOrWhiteSpace(_labelPrinter))
            _labelPrinter = (await Profile.GetSettingsAsync())?.BarcodePrinter;

        StateHasChanged();
    }

    private async Task SetLabelPrinter(string? printer)
    {
        _labelPrinter = printer;
        await Local.SaveAsync(LocalKeys.LabelPrinter, printer ?? "");
    }

    private void OpenLabels(Article a)
    {
        _labelling = a;
        _labelCopies = 1;
        _labelError = null;
    }

    /// <summary>
    /// Raw TSPL through the agent when the shop has one — no dialog, no page change. Without an
    /// agent the label has to be drawn by the browser, which happens at /etiketa inside a hidden
    /// print frame, so the article list (and the search that found it) survives the print.
    /// </summary>
    private async Task PrintLabels()
    {
        if (_labelling is null) return;
        _busy = true;
        _labelError = null;
        try
        {
            var copies = Math.Clamp(_labelCopies, 1, 200);
            var r = await Hw.PrintBarcodeAsync(_labelling, copies, _labelPrinter);
            if (!r.Ok)
                // No &auto=1: the print frame itself calls print() once the labels have
                // rendered. Asking the page to print too would raise two dialogs.
                r = await Hw.PrintUrlAsync($"/etiketa?q={_labelling.Id}x{copies}");

            if (!r.Ok)
            {
                _labelError = $"Printimi dështoi: {r.Error}";
                return;
            }

            _success = true;
            _message = $"{copies} etiketa u dërguan te printeri.";
            _labelling = null;
        }
        finally { _busy = false; }
    }

    private async Task Reload()
    {
        _loading = true;
        _all = await Catalog.GetAllArticlesAsync();
        _categories = await Catalog.GetCategoriesAsync();
        _loading = false;
    }

    private IEnumerable<Article> Filtered
    {
        get
        {
            IEnumerable<Article> q = _all.OrderBy(a => a.Name);
            if (!string.IsNullOrWhiteSpace(_activeCategory))
            {
                // Folded, not compared: the same shelf is stored as both "Kozmetike" and
                // "Kozmetikë", and an equality test on one spelling hides the articles filed
                // under the other.
                var key = CatalogService.CategoryKey(_activeCategory);
                q = q.Where(a => !string.IsNullOrWhiteSpace(a.Category)
                              && CatalogService.CategoryKey(a.Category) == key);
            }
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(a => a.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || a.Barcode.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q;
        }
    }

    /// <summary>
    /// What the table actually draws. The list is not capped — the cap used to be 200 and the
    /// other 1400 articles were simply not there — but a browser asked to lay out 1600 rows at
    /// once stalls the tab, so it grows on demand instead.
    /// </summary>
    private IEnumerable<Article> Shown => Filtered.Take(_shown);

    private int _shown = PageSize;
    private const int PageSize = 200;

    private void ShowMore() => _shown += PageSize;

    // A new search starts from the top: keeping the previous page depth would mean typing a
    // three-letter search and waiting for 1600 rows of the OLD one to be replaced.
    private void OnSearchChanged() => _shown = PageSize;

    private void OpenEditor(Article? a)
    {
        _formError = null;
        // Edit a copy so a cancelled edit doesn't mutate the grid row.
        _editing = a is null
            ? new Article { Unit = "Copë", VATType = 3, VATRate = 18 }
            : Clone(a);
    }

    private void CloseEditor() => _editing = null;

    private async Task Save()
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _formError = "Emërtimi është i detyrueshëm.";
            return;
        }
        _busy = true;
        _formError = null;
        try
        {
            // Keep VATRate in sync with the selected VAT type (matches desktop encoding).
            _editing.VATRate = _editing.VATType switch { 3 => 18, 2 => 8, _ => 0 };

            // Captured before the save, from the untouched grid row: a price change is
            // the edit a shop most often needs to reconstruct afterwards ("who marked
            // this down, and from what?"), and after SaveArticleAsync the old figures
            // are gone for good.
            var before = _editing.Id == 0 ? null : _all.FirstOrDefault(a => a.Id == _editing.Id);
            var isNew = before is null;

            // The id comes back from the save, not from _editing: SaveArticleAsync maps
            // into an Artikujt row and never assigns _editing.Id, so a new article would
            // otherwise be audited as entity 0 — a row pointing at nothing.
            var articleId = await Catalog.SaveArticleAsync(_editing);

            await Audit.LogAsync(isNew ? AuditAction.Create : AuditAction.Update,
                "Article", articleId, _editing.Name,
                details: PriceDelta(before, _editing),
                oldValue: before is null ? null : Snapshot(before),
                newValue: Snapshot(_editing));

            _success = true;
            _message = $"Artikulli \"{_editing.Name}\" u ruajt.";
            _editing = null;
            await Reload();
        }
        catch (Exception ex)
        {
            _formError = $"Ruajtja dështoi: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private void AskDelete(Article a) => _deleting = a;

    private async Task ConfirmDelete()
    {
        if (_deleting is null) return;
        _busy = true;
        try
        {
            var ok = await Catalog.DeleteArticleAsync(_deleting.Id);
            if (ok)
            {
                await Audit.LogAsync(AuditAction.Delete, "Article", _deleting.Id, _deleting.Name,
                    details: $"Barkodi {_deleting.Barcode}", oldValue: Snapshot(_deleting));
            }

            _success = ok;
            _message = ok ? $"Artikulli u fshi." : "Fshirja dështoi.";
            _deleting = null;
            await Reload();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// What the audit row stores as old/new. Only the fields worth reconstructing —
    /// a full serialization of the entity would bury the price change that matters
    /// under thirty columns nobody edits.
    /// </summary>
    private static string Snapshot(Article a) => JsonSerializer.Serialize(new
    {
        a.Barcode, a.Name, a.Unit, a.PurchasePrice, a.SalesPrice,
        a.WholesalePrice, a.VATRate, a.StockQuantity,
    });

    /// <summary>The one-line summary the log lists, so a price move is legible without opening the row.</summary>
    private static string? PriceDelta(Article? before, Article after)
    {
        if (before is null)
            return $"Çmimi i shitjes {after.SalesPrice:0.00} €";

        var changes = new List<string>();
        if (before.SalesPrice != after.SalesPrice)
            changes.Add($"çmimi i shitjes {before.SalesPrice:0.00} → {after.SalesPrice:0.00} €");
        if (before.PurchasePrice != after.PurchasePrice)
            changes.Add($"çmimi i furnizimit {before.PurchasePrice:0.00} → {after.PurchasePrice:0.00} €");
        if (before.VATRate != after.VATRate)
            changes.Add($"TVSH {before.VATRate:0}% → {after.VATRate:0}%");
        if (before.StockQuantity != after.StockQuantity)
            changes.Add($"stoku {before.StockQuantity:0.###} → {after.StockQuantity:0.###}");

        return changes.Count == 0 ? "Ndryshime të tjera" : string.Join(" · ", changes);
    }

    private static Article Clone(Article a) => new()
    {
        Id = a.Id,
        Barcode = a.Barcode,
        Name = a.Name,
        Unit = a.Unit,
        SalesUnit = a.SalesUnit,
        Pack = a.Pack,
        PurchasePrice = a.PurchasePrice,
        Margin = a.Margin,
        PackagePrice = a.PackagePrice,
        WholesalePrice = a.WholesalePrice,
        SalesPrice = a.SalesPrice,
        SalesPrice1 = a.SalesPrice1,
        VATRate = a.VATRate,
        VATType = a.VATType,
        Category = a.Category,
        SupplierId = a.SupplierId,
        StockQuantity = a.StockQuantity,
        StockIn = a.StockIn,
        StockOut = a.StockOut,
        AverageSalesPrice = a.AverageSalesPrice,
        AveragePurchasePrice = a.AveragePurchasePrice,
        ExpiryDate = a.ExpiryDate,
        HasBarcode = a.HasBarcode,
        IsWeighed = a.IsWeighed,
        ProductType = a.ProductType,
        POSCategoryId = a.POSCategoryId,
        Notes = a.Notes,
        Location = a.Location,
        Brand = a.Brand,
        Importer = a.Importer,
        Sector = a.Sector,
        PhotoPath = a.PhotoPath
    };
}
