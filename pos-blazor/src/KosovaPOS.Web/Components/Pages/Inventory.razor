@page "/inventari"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@inject CatalogService Catalog
@inject StockService Stock

<PageTitle>Inventari — KosovaPOS</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Menaxhimi i inventarit</h1>
            <span class="muted">@_all.Count artikuj</span>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="sale-msg @(_success ? "ok" : "err")">@_message</div>
    }

    <div class="stat-row">
        <div class="stat"><span class="stat-label">Artikuj</span><span class="stat-val">@_all.Count</span></div>
        <div class="stat warn"><span class="stat-label">Nën minimum (≤ @_threshold)</span><span class="stat-val">@LowCount</span></div>
        <div class="stat danger"><span class="stat-label">Pa stok</span><span class="stat-val">@OutCount</span></div>
        <div class="stat danger"><span class="stat-label">Stok negativ</span><span class="stat-val">@NegativeCount</span></div>
    </div>

    @if (NegativeCount > 0)
    {
        <div class="sale-msg err">
            @NegativeCount artikuj kanë stok negativ, çka nuk është e mundur fizikisht — vlera e stokut del e gabuar.
            Numëroji dhe korrigjoji me <strong>Inventarizim</strong>.
            <button class="btn-mini" @onclick="@(() => { _filter = "neg"; })">Shfaq vetëm ata</button>
        </div>
    }

    <div class="tabs">
        <button class="tab @(_tab == "stock" ? "active" : "")" @onclick="@(() => _tab = "stock")">Gjendja</button>
        <button class="tab @(_tab == "moves" ? "active" : "")" @onclick="ShowMovements">Lëvizjet</button>
    </div>

    @if (_tab == "stock")
    {
        <div class="search-row">
            <input @bind="_search" @bind:event="oninput" placeholder="Kërko emër ose barkod…" class="search-box" />
            <select @bind="_filter" class="cat-select">
                <option value="all">Të gjitha</option>
                <option value="low">Nën minimum</option>
                <option value="out">Pa stok</option>
                <option value="neg">Stok negativ</option>
            </select>
            <label class="chk">Pragu <input type="number" class="thresh" @bind="_threshold" /></label>
        </div>

        <div class="table-wrap">
            @if (_loading)
            {
                <p class="muted">Duke ngarkuar…</p>
            }
            else
            {
                <table class="grid-table">
                    <thead>
                        <tr>
                            <th>Barkodi</th>
                            <th>Emërtimi</th>
                            <th>Njësia</th>
                            <th class="num">Stoku</th>
                            <th class="num">Çm. furn.</th>
                            <th class="num">Vlera</th>
                            <th>Veprime</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Filtered)
                        {
                            <tr>
                                <td class="mono">@a.Barcode</td>
                                <td>@a.Name</td>
                                <td>@a.Unit</td>
                                <td class="num @StockClass(a)">@a.StockQuantity.ToString("0.##")</td>
                                <td class="num">@a.PurchasePrice.ToString("0.00")</td>
                                <td class="num">@((a.StockQuantity * a.PurchasePrice).ToString("0.00"))</td>
                                <td>
                                    <button class="btn-mini" @onclick="() => Open(a, StockMovementType.In)">Hyrje</button>
                                    <button class="btn-mini" @onclick="() => Open(a, StockMovementType.Out)">Dalje</button>
                                    <button class="btn-mini" @onclick="() => Open(a, StockMovementType.Count)">Inventarizim</button>
                                </td>
                            </tr>
                        }
                        @if (!Filtered.Any())
                        {
                            <tr><td colspan="7" class="muted center">Asnjë artikull.</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="grid-table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Artikulli</th>
                        <th>Lloji</th>
                        <th class="num">Ndryshimi</th>
                        <th class="num">Para</th>
                        <th class="num">Pas</th>
                        <th>Përdoruesi</th>
                        <th>Shënim</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _movements)
                    {
                        <tr>
                            <td>@m.MovedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@m.ArticleName</td>
                            <td><span class="badge">@TypeLabel(m.Type)</span></td>
                            <td class="num @(m.Quantity < 0 ? "out" : "")">@m.Quantity.ToString("+0.##;-0.##;0")</td>
                            <td class="num">@m.QuantityBefore.ToString("0.##")</td>
                            <td class="num">@m.QuantityAfter.ToString("0.##")</td>
                            <td>@m.UserName</td>
                            <td>@m.Note</td>
                        </tr>
                    }
                    @if (_movements.Count == 0)
                    {
                        <tr><td colspan="8" class="muted center">Asnjë lëvizje e regjistruar.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="Cancel">
        <div class="modal small" @onclick:stopPropagation="true">
            <h2>@TypeLabel(_type) — @_editing.Name</h2>
            <p class="muted">Stoku aktual: <strong>@_editing.StockQuantity.ToString("0.##") @_editing.Unit</strong></p>

            <div class="form-grid">
                <div class="field">
                    <label>@(_type == StockMovementType.Count ? "Sasia e numëruar" : "Sasia")</label>
                    <input class="input" type="number" step="0.001" @bind="_qty" @bind:after="StateHasChanged" />
                </div>
                <div class="field">
                    <label>Stoku pas veprimit</label>
                    <input class="input" readonly value="@ResultingQty.ToString("0.##")" />
                </div>
                <div class="field span2">
                    <label>Arsyeja / shënim</label>
                    <input class="input" @bind="_note" placeholder="p.sh. faturë furnizimi, prishje, numërim fizik" />
                </div>
            </div>

            @if (_type == StockMovementType.Count && _editing.StockQuantity != _qty)
            {
                <p class="muted">Diferenca: <strong>@((_qty - _editing.StockQuantity).ToString("+0.##;-0.##;0"))</strong> @_editing.Unit</p>
            }

            <div class="modal-actions">
                <button class="btn-ghost" @onclick="Cancel">Anulo</button>
                <button class="btn-primary" disabled="@_busy" @onclick="Save">@(_busy ? "Duke ruajtur…" : "Ruaj")</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Article> _all = new();
    private List<StockMovement> _movements = new();
    private string _search = "";
    private string _filter = "all";
    private string _tab = "stock";
    private decimal _threshold = 5;
    private bool _loading = true, _busy, _success;
    private string? _message;
    private string _userName = "";

    private Article? _editing;
    private StockMovementType _type;
    private decimal _qty;
    private string? _note;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _userName = user.FindFirst(AuthService.FullNameClaim)?.Value ?? user.Identity?.Name ?? "";
        }
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        _all = await Catalog.GetAllArticlesAsync();
        _loading = false;
    }

    private async Task ShowMovements()
    {
        _tab = "moves";
        _movements = await Stock.GetMovementsAsync();
    }

    private void Open(Article a, StockMovementType type)
    {
        _editing = a;
        _type = type;
        // A count pre-fills with what's on record so the cashier edits the figure;
        // in/out start empty rather than at 1, so a stray Enter can't move stock.
        _qty = type == StockMovementType.Count ? a.StockQuantity : 0;
        _note = null;
        _message = null;
    }

    private void Cancel() => _editing = null;

    private decimal ResultingQty => _editing is null ? 0 : _type switch
    {
        StockMovementType.In => _editing.StockQuantity + _qty,
        StockMovementType.Out => _editing.StockQuantity - _qty,
        _ => _qty
    };

    private async Task Save()
    {
        if (_editing is null) return;
        _busy = true;
        try
        {
            var id = (long)_editing.Id;
            var move = _type switch
            {
                StockMovementType.In => await Stock.StockInAsync(id, _qty, _note, _userName),
                StockMovementType.Out => await Stock.StockOutAsync(id, _qty, _note, _userName),
                _ => await Stock.SetCountedAsync(id, _qty, _note, _userName)
            };

            _editing.StockQuantity = move.QuantityAfter;
            _success = true;
            _message = $"{_editing.Name}: stoku u përditësua në {move.QuantityAfter:0.##} {move.Unit}.";
            _editing = null;
            if (_tab == "moves") _movements = await Stock.GetMovementsAsync();
        }
        catch (Exception ex)
        {
            _success = false;
            _message = ex.Message;
        }
        finally { _busy = false; }
    }

    private IEnumerable<Article> Filtered
    {
        get
        {
            IEnumerable<Article> q = _all;
            q = _filter switch
            {
                "out" => q.Where(a => a.StockQuantity == 0),
                "low" => q.Where(a => a.StockQuantity > 0 && a.StockQuantity <= _threshold),
                "neg" => q.Where(a => a.StockQuantity < 0),
                _ => q
            };
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(a => a.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || a.Barcode.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q.OrderBy(a => a.StockQuantity).ThenBy(a => a.Name).Take(300);
        }
    }

    private string StockClass(Article a) =>
        a.StockQuantity <= 0 ? "out" : a.StockQuantity <= _threshold ? "low" : "";

    private int LowCount => _all.Count(a => a.StockQuantity > 0 && a.StockQuantity <= _threshold);
    private int OutCount => _all.Count(a => a.StockQuantity == 0);
    private int NegativeCount => _all.Count(a => a.StockQuantity < 0);

    private static string TypeLabel(StockMovementType t) => t switch
    {
        StockMovementType.In => "Hyrje",
        StockMovementType.Out => "Dalje",
        StockMovementType.Count => "Inventarizim",
        _ => t.ToString()
    };
}
