@page "/partneret"
@attribute [Authorize(Policy = "perm:partners")]
@rendermode InteractiveServer
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@using KosovaPOS.Models.BMDData
@using KosovaPOS.Web.Services
@inject PartnerService PartnerSvc
@inject Audit Audit

<PageTitle>Partnerët — KosovaPOS</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>Partnerët afaristë</h1>
            <span class="muted">@_all.Count partnerë</span>
        </div>
        <button class="btn-primary" @onclick="() => OpenEditor(null)">+ Partner i ri</button>
    </header>

    <div class="search-row">
        <input @bind="_search" @bind:event="oninput" placeholder="Kërko emër, NUI, qytet…" class="search-box" />
        <select @bind="_typeFilter" class="cat-select">
            <option value="">Të gjithë</option>
            <option value="@PartnerService.Customer">Klientë</option>
            <option value="@PartnerService.Supplier">Furnizues</option>
            <option value="@PartnerService.Both">Të dy</option>
        </select>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="sale-msg @(_success ? "ok" : "err")">@_message</div>
    }

    <div class="table-wrap">
        @if (_loading)
        {
            <p class="muted">Duke ngarkuar…</p>
        }
        else
        {
            <table class="grid-table">
                <thead>
                    <tr>
                        <th>Emri</th>
                        <th>Lloji</th>
                        <th>NUI</th>
                        <th>Qyteti</th>
                        <th>Telefoni</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Filtered)
                    {
                        <tr class="@(p.IsActive ? "" : "inactive-row")">
                            <td>@p.Name</td>
                            <td><span class="badge">@p.PartnerType</span></td>
                            <td class="mono">@p.NUI</td>
                            <td>@p.City</td>
                            <td>@p.Phone</td>
                            <td class="actions">
                                <button class="btn-mini" title="Kartela dhe pagesat"
                                        @onclick="() => OpenLedger(p)">📒</button>
                                <button class="btn-mini" title="Ndrysho" @onclick="() => OpenEditor(p)">✏️</button>
                                <button class="btn-mini danger" title="Fshi" @onclick="() => AskDelete(p)">🗑️</button>
                            </td>
                        </tr>
                    }
                    @if (!Filtered.Any())
                    {
                        <tr><td colspan="6" class="muted center">Asnjë partner.</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="CloseEditor">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>@(_editing.Id > 0 ? "Ndrysho partnerin" : "Partner i ri")</h2>
            <EditForm Model="_editing" OnValidSubmit="Save">
                <div class="form-grid">
                    <div class="field span2">
                        <label>Emri *</label>
                        <input class="input" @bind="_editing.Name" />
                    </div>
                    <div class="field">
                        <label>Lloji</label>
                        <select class="input" @bind="_editing.PartnerType">
                            <option value="@PartnerService.Customer">Klient</option>
                            <option value="@PartnerService.Supplier">Furnizues</option>
                            <option value="@PartnerService.Both">Të dy</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>NUI</label>
                        <input class="input" @bind="_editing.NUI" />
                    </div>
                    <div class="field">
                        <label>NRF</label>
                        <input class="input" @bind="_editing.NRF" />
                    </div>
                    <div class="field span2">
                        <label>Adresa</label>
                        <input class="input" @bind="_editing.Address" />
                    </div>
                    <div class="field">
                        <label>Qyteti</label>
                        <select class="input" @bind="_editing.City">
                            <option value="">—</option>
                            @foreach (var c in _cities)
                            {
                                <option value="@c.Emertimi">@c.Emertimi</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Telefoni</label>
                        <input class="input" @bind="_editing.Phone" />
                    </div>
                    <div class="field">
                        <label>Email</label>
                        <input class="input" @bind="_editing.Email" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="sale-msg err">@_formError</div>
                }

                <div class="modal-actions">
                    <button type="button" class="btn-ghost" @onclick="CloseEditor">Anulo</button>
                    <button type="submit" class="btn-primary" disabled="@_busy">
                        @(_busy ? "Duke ruajtur…" : "Ruaj")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* The account card: every document BMD holds against this partner, exactly as BMD wrote it.
   There is no balance here, and that is deliberate — see the note the card itself carries. *@
@if (_ledgerOf is { } partner)
{
    <div class="modal-backdrop" @onclick="CloseLedger">
        <div class="modal wide" @onclick:stopPropagation="true">
            <h2>Kartela — @partner.Name</h2>

            <div class="stat-row">
                <div class="stat">
                    <span class="stat-label">Dokumente</span>
                    <span class="stat-val">@_ledger.Count</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Faturuar gjithsej</span>
                    <span class="stat-val">@_ledger.Sum(r => r.Due).ToString("0.00") €</span>
                </div>
            </div>

            @* Said here, on the screen, because the absence of a balance is the sort of thing a
               shopkeeper assumes is a bug unless someone tells them otherwise. *@
            <p class="hint">
                Kartela tregon dokumentet ashtu siç i ka shkruar BMD-ja. <strong>Nuk shfaqet
                balancë</strong>: në BMD një pagesë e vetme që mbyll disa fatura regjistrohet e
                <em>plotë</em> te njëra prej tyre, ndërsa faturat e tjera figurojnë tashmë të
                paguara — prandaj mbledhja e kolonës <em>Mbetur</em> e numëron çdo pagesë dy herë
                dhe nxjerr borxhe që nuk ekzistojnë. Kolona <em>Paguar</em>, për të njëjtën arsye,
                nuk mblidhet.
            </p>

            @if (!string.IsNullOrEmpty(_ledgerError))
            {
                <div class="sale-msg err">@_ledgerError</div>
            }

            <div class="table-wrap ledger-wrap">
                @if (_ledgerLoading)
                {
                    <p class="muted">Duke ngarkuar…</p>
                }
                else
                {
                    <table class="grid-table">
                        <thead>
                            <tr>
                                <th>Data</th><th>Dokumenti</th><th>Lloji</th>
                                <th class="num">Faturuar</th><th class="num">Paguar</th><th class="num">Mbetur</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _ledger)
                            {
                                <tr class="@(r.Type == PartnerService.PaymentType ? "pay-row-ledger" : "")">
                                    <td>@(r.Date?.ToString("dd.MM.yyyy") ?? "—")</td>
                                    <td class="mono">@(r.DocumentId ?? r.DocumentNumber?.ToString() ?? "—")</td>
                                    <td>@(r.Type == PartnerService.PaymentType ? (r.Description ?? "Pagesë") : r.Type)</td>
                                    <td class="num">@(r.Due == 0 ? "—" : r.Due.ToString("0.00"))</td>
                                    <td class="num">@(r.Paid == 0 ? "—" : r.Paid.ToString("0.00"))</td>
                                    <td class="num">@(r.Remaining == 0 ? "—" : r.Remaining.ToString("0.00"))</td>
                                </tr>
                            }
                            @if (_ledger.Count == 0)
                            {
                                <tr><td colspan="6" class="muted center">Asnjë dokument në kartelë.</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <fieldset class="settings-set">
                <legend>Regjistro pagesë</legend>
                <div class="form-grid">
                    <div class="field">
                        <label>Shuma (€)</label>
                        <input class="input" type="number" step="0.01" min="0" @bind="_payAmount" />
                    </div>
                    <div class="field">
                        <label>Data</label>
                        <input class="input" type="date" @bind="_payDate" />
                    </div>
                    <div class="field span2">
                        <label>Përshkrimi</label>
                        <input class="input" @bind="_payNote" maxlength="100" placeholder="p.sh. Pagesë me para në dorë" />
                    </div>
                </div>
                <div class="modal-actions">
                    <button class="btn-primary" disabled="@(_busy || _payAmount <= 0)" @onclick="RecordPayment">
                        @(_busy ? "Duke ruajtur…" : "Regjistro pagesën")
                    </button>
                    <button class="btn-ghost" @onclick="CloseLedger">Mbyll</button>
                </div>
            </fieldset>
        </div>
    </div>
}

@if (_deleting is not null)
{
    <div class="modal-backdrop" @onclick="() => _deleting = null">
        <div class="modal small" @onclick:stopPropagation="true">
            <h2>Fshi partnerin?</h2>
            <p><strong>@_deleting.Name</strong> do të fshihet përgjithmonë.</p>
            <div class="modal-actions">
                <button class="btn-ghost" @onclick="() => _deleting = null">Anulo</button>
                <button class="btn-danger" disabled="@_busy" @onclick="ConfirmDelete">Fshi</button>
            </div>
        </div>
    </div>
}

@code {
    private List<BusinessPartner> _all = new();
    private List<Qytetet> _cities = new();
    private string _search = "";
    private string _typeFilter = "";
    private bool _loading = true, _busy, _success;
    private string? _message, _formError;

    private BusinessPartner? _editing;
    private BusinessPartner? _deleting;

    // ── The account card ────────────────────────────────────────────────────────────────
    private BusinessPartner? _ledgerOf;
    private List<PartnerService.PartnerLedgerRow> _ledger = new();
    private bool _ledgerLoading;
    private string? _ledgerError;

    private decimal _payAmount;
    private DateTime _payDate = DateTime.Today;
    private string? _payNote;

    private async Task OpenLedger(BusinessPartner p)
    {
        _ledgerOf = p;
        _ledgerError = null;
        _ledgerLoading = true;
        _payNote = null;
        _payDate = DateTime.Today;
        _payAmount = 0;
        _ledger = await PartnerSvc.GetLedgerAsync(p.Id);
        _ledgerLoading = false;
    }

    private void CloseLedger()
    {
        _ledgerOf = null;
        _ledger = new();
        _payAmount = 0;
    }

    private async Task RecordPayment()
    {
        if (_ledgerOf is null || _payAmount <= 0) return;
        _busy = true;
        _ledgerError = null;
        try
        {
            await PartnerSvc.RecordPaymentAsync(
                _ledgerOf.Id, _payAmount, DateOnly.FromDateTime(_payDate), _payNote);

            await Audit.LogAsync(AuditAction.Create, "PartnerPayment", _ledgerOf.Id, _ledgerOf.Name,
                details: $"Pagesë {_payAmount:0.00} € · {_payDate:dd.MM.yyyy}");

            var paid = _payAmount;
            _ledger = await PartnerSvc.GetLedgerAsync(_ledgerOf.Id);
            _payAmount = 0;
            _payNote = null;

            _success = true;
            _message = $"Pagesa prej {paid:0.00} € u regjistrua në kartelën e partnerit.";
        }
        catch (Exception ex)
        {
            _ledgerError = ex.Message;
        }
        finally { _busy = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        _cities = await PartnerSvc.GetCitiesAsync();
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        _all = await PartnerSvc.GetAllAsync();
        _loading = false;
    }

    private IEnumerable<BusinessPartner> Filtered
    {
        get
        {
            IEnumerable<BusinessPartner> q = _all;
            if (!string.IsNullOrWhiteSpace(_typeFilter))
                q = q.Where(p => p.PartnerType == _typeFilter);

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(p => p.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || (p.NUI ?? "").Contains(s, StringComparison.OrdinalIgnoreCase)
                              || (p.City ?? "").Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q.Take(300);
        }
    }

    private void OpenEditor(BusinessPartner? p)
    {
        _formError = null;
        _editing = p is null
            ? new BusinessPartner { PartnerType = PartnerService.Customer, IsActive = true }
            : Clone(p);
    }

    private void CloseEditor() => _editing = null;

    private async Task Save()
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _formError = "Emri është i detyrueshëm.";
            return;
        }
        _busy = true;
        _formError = null;
        try
        {
            _editing.Name = _editing.Name.Trim();
            await PartnerSvc.SaveAsync(_editing);
            _success = true;
            _message = $"Partneri \"{_editing.Name}\" u ruajt.";
            _editing = null;
            await Reload();
        }
        catch (Exception ex)
        {
            _formError = $"Ruajtja dështoi: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private void AskDelete(BusinessPartner p) => _deleting = p;

    private async Task ConfirmDelete()
    {
        if (_deleting is null) return;
        _busy = true;
        try
        {
            var ok = await PartnerSvc.DeleteAsync(_deleting.Id);
            _success = ok;
            _message = ok ? "Partneri u fshi." : "Fshirja dështoi.";
            _deleting = null;
            await Reload();
        }
        finally
        {
            _busy = false;
        }
    }

    private static BusinessPartner Clone(BusinessPartner p) => new()
    {
        Id = p.Id,
        Name = p.Name,
        NRF = p.NRF,
        NUI = p.NUI,
        Address = p.Address,
        City = p.City,
        Phone = p.Phone,
        Email = p.Email,
        PartnerType = p.PartnerType,
        IsActive = p.IsActive,
        CreatedAt = p.CreatedAt
    };
}
