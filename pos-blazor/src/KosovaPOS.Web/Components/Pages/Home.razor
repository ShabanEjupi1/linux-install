@page "/"
@* Business-scoped, not merely authenticated: a platform admin holds no bizid and
   the dashboard's first query would have nowhere to run. They belong in /admin. *@
@attribute [Authorize(Policy = AuthService.BusinessPolicy)]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using KosovaPOS.Core.Services
@using KosovaPOS.Models
@inject SalesService Sales
@inject ShiftService Shifts

<PageTitle>KosovaPOS</PageTitle>

<div class="mgmt">
    <header class="mgmt-head">
        <div>
            <h1>@Greeting@(string.IsNullOrEmpty(_firstName) ? "" : $", {_firstName}")</h1>
            <span class="muted">@DateTime.Now.ToString("dd.MM.yyyy")</span>
        </div>
        @if (_canSell)
        {
            <a href="/sale" class="btn-primary btn-lg">🛒 Fillo shitjen</a>
        }
    </header>

    <div class="stat-row">
        <div class="stat accent">
            <span class="stat-label">Shitjet sot</span>
            <span class="stat-val">@_revenue.ToString("0.00") €</span>
        </div>
        <div class="stat">
            <span class="stat-label">Fatura sot</span>
            <span class="stat-val">@_transactions</span>
        </div>
        <div class="stat">
            <span class="stat-label">Artikuj të shitur</span>
            <span class="stat-val">@_items</span>
        </div>
        @if (_canSell)
        {
            <a href="/arka" class="stat tile-link @(_shiftOpen ? "" : "warn")">
                <span class="stat-label">Ndërrimi</span>
                <span class="stat-val">@(_shiftOpen ? "I hapur" : "I mbyllur")</span>
            </a>
        }
    </div>

    <h2 class="section-title">Veprimet</h2>
    <div class="tiles">
        @* A tile the user cannot open is a dead end into the 403 page — each one
           mirrors the policy on the page it points at. *@
        @if (_canSell)
        {
            <a href="/sale" class="tile-link"><div class="tile">🛒 Shitje</div></a>
        }
        @if (_canArticles)
        {
            <a href="/articles" class="tile-link"><div class="tile">📦 Artikuj</div></a>
        }
        @if (_canSell)
        {
            <a href="/faturat" class="tile-link"><div class="tile">🧾 Faturat</div></a>
        }
        @if (_canPurchases)
        {
            <a href="/blerjet" class="tile-link"><div class="tile">📥 Blerjet</div></a>
        }
        @if (_canStock)
        {
            <a href="/stoku" class="tile-link"><div class="tile">📊 Stoku</div></a>
            <a href="/inventari" class="tile-link"><div class="tile">🗃️ Inventari</div></a>
            <a href="/barkod" class="tile-link"><div class="tile">🏷️ Barkodi</div></a>
        }
        @if (_canSell)
        {
            <a href="/arka" class="tile-link"><div class="tile">💵 Arka</div></a>
            <a href="/kthimet" class="tile-link"><div class="tile">↩️ Kthimet</div></a>
        }
        @if (_canPartners)
        {
            <a href="/partneret" class="tile-link"><div class="tile">🤝 Partnerët</div></a>
        }
        @if (_canFinance)
        {
            <a href="/financat" class="tile-link"><div class="tile">💰 Financat</div></a>
        }
        @if (_canReports)
        {
            <a href="/raportet" class="tile-link"><div class="tile">📈 Raportet</div></a>
        }
        @if (_canManageUsers)
        {
            <a href="/perdoruesit" class="tile-link"><div class="tile">👥 Përdoruesit</div></a>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _canManageUsers;
    private bool _canReports;
    private bool _canFinance;
    private bool _canPurchases;
    private bool _canPartners;
    private bool _canArticles;
    private bool _canSell;
    private bool _canStock;
    private string _firstName = "";
    private decimal _revenue;
    private int _transactions;
    private int _items;
    private bool _shiftOpen;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            var fullName = user.FindFirst(AuthService.FullNameClaim)?.Value
                           ?? user.Identity?.Name ?? "";
            _firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

            bool Can(string perm) => user.HasClaim(AuthService.PermissionClaim, perm);
            _canManageUsers = Can("users");
            _canReports     = Can("reports");
            _canFinance     = Can("finance");
            _canPurchases   = Can("purchases");
            _canPartners    = Can("partners");
            _canArticles    = Can("articles");
            _canSell        = Can("sell");
            _canStock       = Can("stock");
        }

        (_revenue, _transactions, _items) = await Sales.GetTodaySummaryAsync();
        _shiftOpen = await Shifts.GetOpenShiftAsync() is not null;
    }

    private string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "Mirëmëngjes",
        < 18 => "Mirëdita",
        _ => "Mirëmbrëma"
    };
}
