<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KosovaPOS.Agent</RootNamespace>
    <AssemblyName>KosovaPOS.Agent</AssemblyName>
    <!-- Windows drivers (winspool P/Invoke, System.IO.Ports) compile everywhere;
         they are only registered/called on Windows, so silence the platform analyzer. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KosovaPOS.Agent.Contracts\KosovaPOS.Agent.Contracts.csproj" />
  </ItemGroup>

</Project>
