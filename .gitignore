# Secrets — never commit
*.key
*.pem
.env
**/.env
cloudflared.deb
server-credentials.txt

# Cloudflare tunnel credentials
*.json
!cloudflare/*.yml
# targets.json është konfigurim, jo kredencial — sekretet e watchtower-it rrinë
# te /etc/watchtower/env në kuti. Pa këtë përjashtim `git add` e kapërcen NË
# HESHTJE dhe skedari s'hyn kurrë në commit.
!watchtower/targets.json

# Supabase clone
supabase/supabase-docker/

# OS/editor cruft
.DS_Store

# Saved credentials (local only)
credentials.local.txt
vault-import.json
# rotate-credentials.sh writes live secrets here before they reach Vaultwarden
vault-additions.json
# migrate-to-gitea.sh writes the Gitea admin password + API token here
vault-additions-gitea.json
# setup-cline.sh writes the code-server password here
vault-additions-cline.json

# News portal local env
news-portal/.env

# Python
__pycache__/
*.pyc

# Any *.env.local (the vaultwarden one leaked once)
**/.env.local
*.env.local
