---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Dashboard — Halal Bank Kosova">
  <section class="wrap dash">
    <div class="row head">
      <div>
        <div class="hello" id="hello">Welcome</div>
        <div class="iban" id="iban">—</div>
      </div>
      <button class="ghost" id="logout" type="button">Log out</button>
    </div>

    <div class="balcard card">
      <div class="lbl">Available balance</div>
      <div class="bal" id="balance">€ —</div>
    </div>

    <div class="row two">
      <div class="card">
        <h3>Send money</h3>
        <label>Recipient IBAN</label><input id="t-iban" placeholder="XK.." />
        <label>Amount (EUR)</label><input id="t-amt" type="number" min="0.01" step="0.01" />
        <label>Note (optional)</label><input id="t-memo" />
        <div class="err" id="t-err"></div>
        <div class="ok" id="t-ok"></div>
        <button id="t-send" style="width:100%;margin-top:16px" type="button">Send transfer</button>
      </div>

      <div class="card">
        <h3>Recent transactions</h3>
        <div id="txlist" class="txlist"><div class="muted">Loading…</div></div>
      </div>
    </div>
  </section>

  <style>
    .dash { padding:32px 0 60px; display:grid; gap:20px; }
    .row.head { display:flex; justify-content:space-between; align-items:center; }
    .hello { font-size:1.4rem; font-weight:700; }
    .iban { color:var(--muted); font-size:.9rem; letter-spacing:.03em; }
    .balcard { background:linear-gradient(135deg,var(--green),var(--green-d)); color:#fff; border:none; }
    .balcard .lbl { opacity:.85; font-size:.9rem; }
    .balcard .bal { font-size:2.6rem; font-weight:800; margin-top:4px; }
    .two { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
    h3 { margin-bottom:6px; }
    .txlist { display:grid; gap:2px; margin-top:8px; }
    .tx { display:flex; justify-content:space-between; padding:12px 4px; border-bottom:1px solid #eef2ef; }
    .tx small { color:var(--muted); }
    .tx .amt.in { color:var(--green-d); font-weight:700; }
    .tx .amt.out { color:#c0392b; font-weight:700; }
    .muted { color:var(--muted); }
    @media(max-width:820px){ .two{ grid-template-columns:1fr; } }
  </style>

  <script>
    import { supabase } from '../lib/supabase';
    const $ = (id) => document.getElementById(id);
    const eur = (n) => '€ ' + Number(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});

    let account = null;

    async function guard() {
      const { data } = await supabase.auth.getSession();
      if (!data.session) { window.location.href = '/'; return null; }
      return data.session;
    }

    async function load() {
      const session = await guard();
      if (!session) return;
      $('navuser').textContent = session.user.email;

      const { data: prof } = await supabase.from('profiles').select('full_name').single();
      $('hello').textContent = 'Welcome, ' + ((prof && prof.full_name) || session.user.email.split('@')[0]);

      const { data: accs } = await supabase.from('accounts').select('id,iban,balance,currency').limit(1);
      account = accs && accs[0];
      if (account) {
        $('iban').textContent = 'IBAN ' + account.iban;
        $('balance').textContent = eur(account.balance);
      }

      const { data: txs } = await supabase.from('transactions')
        .select('amount,kind,counterparty_iban,description,created_at')
        .order('created_at', { ascending:false }).limit(20);
      const list = $('txlist');
      if (!txs || !txs.length) { list.innerHTML = '<div class="muted">No transactions yet.</div>'; return; }
      list.innerHTML = txs.map(t => {
        const inc = Number(t.amount) >= 0;
        const when = new Date(t.created_at).toLocaleString();
        const who = t.counterparty_iban || t.kind;
        return `<div class="tx"><div>${inc?'Received from':'Sent to'} <strong>${who}</strong><br><small>${t.description||''} ${when}</small></div>
                <div class="amt ${inc?'in':'out'}">${inc?'+':''}${eur(Math.abs(t.amount))}</div></div>`;
      }).join('');
    }

    $('logout').onclick = async () => { await supabase.auth.signOut(); window.location.href='/'; };

    $('t-send').onclick = async () => {
      $('t-err').textContent=''; $('t-ok').textContent='';
      const to_iban = $('t-iban').value.trim();
      const amt = parseFloat($('t-amt').value);
      const memo = $('t-memo').value.trim();
      if (!to_iban || !amt) { $('t-err').textContent='Enter a recipient IBAN and amount.'; return; }
      const { data, error } = await supabase.rpc('transfer', { to_iban, amt, memo });
      if (error) { $('t-err').textContent = error.message.replace(/^.*?:\s*/,''); return; }
      $('t-ok').textContent = 'Transfer sent! New balance ' + eur(data.new_balance);
      $('t-iban').value=''; $('t-amt').value=''; $('t-memo').value='';
      load();
    };

    load();
  </script>
</Layout>
