---
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      :root { --green:#0f9d58; --green-d:#0b7a44; --ink:#12241a; --muted:#5a6b60; --bg:#f4f8f5; }
      * { box-sizing:border-box; margin:0; padding:0; }
      body { font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; color:var(--ink); background:var(--bg); line-height:1.6; }
      a { color:var(--green); }
      .wrap { max-width:1000px; margin:0 auto; padding:0 20px; }
      .topbar { background:#fff; border-bottom:1px solid #e6ede8; }
      .topbar .wrap { display:flex; justify-content:space-between; align-items:center; height:64px; }
      .brand { font-weight:800; color:var(--green); font-size:1.2rem; display:flex; gap:8px; align-items:center; }
      .brand .dot { width:12px; height:12px; border-radius:3px; background:var(--green); display:inline-block; }
      button, .btn { font:inherit; cursor:pointer; border:none; border-radius:10px; padding:12px 20px; background:var(--green); color:#fff; font-weight:600; }
      button:hover, .btn:hover { background:var(--green-d); }
      button.ghost { background:transparent; color:var(--green); border:1px solid var(--green); }
      input, select { font:inherit; width:100%; padding:12px 14px; border:1px solid #d4e0d8; border-radius:10px; background:#fff; }
      label { display:block; font-size:.85rem; color:var(--muted); margin:14px 0 6px; }
      .card { background:#fff; border:1px solid #e6ede8; border-radius:16px; padding:24px; }
      .err { color:#c0392b; font-size:.9rem; margin-top:10px; min-height:1.2em; }
      .ok { color:var(--green-d); font-size:.9rem; margin-top:10px; min-height:1.2em; }
      footer { color:var(--muted); font-size:.85rem; text-align:center; padding:40px 0; }
      h1 { letter-spacing:-.02em; }
    </style>
  </head>
  <body>
    <div class="topbar">
      <div class="wrap">
        <a href="/" class="brand"><span class="dot"></span> Halal Bank Kosova</a>
        <span id="navuser" style="font-size:.9rem;color:var(--muted)"></span>
      </div>
    </div>
    <slot />
    <footer>© {new Date().getFullYear()} Halal Bank Kosova · Interest-free, ethical finance · Demo</footer>
  </body>
</html>
